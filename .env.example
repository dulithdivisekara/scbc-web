# Copy to .env and set per environment. Only PUBLIC_ vars are exposed to the browser.

# Address used by the "General Inquiries" mailto link and the mailto fallback.
# Defaults to contact@dulith.me if unset. Set to the school-owned address at launch.
PUBLIC_CONTACT_EMAIL=

# Optional form backend (e.g. https://formspree.io/f/xxxxxxx). When set, the contact
# form POSTs JSON {name,email,message} here. When empty, it opens the visitor's mail app.
PUBLIC_FORM_ENDPOINT=
