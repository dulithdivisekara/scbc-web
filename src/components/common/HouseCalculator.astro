---
import { Flag, Search } from 'lucide-react';
---

<section class="bg-gradient-to-b from-stone-50 to-white rounded-3xl border border-stone-200/80 p-6 sm:p-10 max-w-3xl mx-auto my-12 house-calculator-root break-inside-avoid shadow-xs">
  <header class="text-center mb-8">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-stone-100 text-stone-700 text-xs font-semibold uppercase tracking-wider mb-3">
      <Flag size={13} />
      <span data-en="Collegiate House Membership" data-si="විද්‍යාලයීය නිවාස සාමාජිකත්වය">Collegiate House Membership</span>
    </div>
    <h3 class="text-2xl sm:text-4xl font-serif font-bold text-stone-900 tracking-tight" data-i18n="house.calculator_title">
      Find Your Assigned House
    </h3>
    <p class="text-stone-500 text-xs sm:text-sm max-w-lg mx-auto mt-2 leading-relaxed" data-i18n="house.calculator_desc">
      Every student at Sri Chandananda Buddhist College is ceremonially assigned to Ramya, Suramya, or Subha house by admission matriculation.
    </p>
  </header>

  <form id="house-calculator-form" class="house-calculator-form no-print flex flex-col sm:flex-row gap-3 items-center justify-center max-w-md mx-auto mb-6">
    <div class="relative w-full">
      <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-stone-400">
        <Search size={18} />
      </div>
      <input 
        type="number" 
        name="admissionNumber" 
        min="1" 
        step="1"
        placeholder="Enter Admission No. (e.g. 2474)" 
        data-placeholder-en="Enter Admission No. (e.g. 2474)"
        data-placeholder-si="ඇතුළත් කිරීමේ අංකය (උදා: 2474)"
        required
        class="admission-input w-full pl-10 pr-4 py-3.5 rounded-xl border border-stone-200 bg-white focus:outline-none focus:border-[#581838] focus:ring-2 focus:ring-[#581838]/20 text-stone-900 text-sm font-medium transition-all shadow-xs" 
      />
    </div>
    <button 
      type="submit" 
      class="w-full sm:w-auto shrink-0 bg-[#581838] hover:bg-[#43122b] text-white font-medium px-6 py-3.5 rounded-xl transition-all text-sm cursor-pointer flex items-center justify-center gap-2 shadow-sm"
    >
      <span data-i18n="house.calculator_button">Verify House</span>
    </button>
  </form>

  <div class="calculator-error no-print hidden text-center text-xs font-semibold text-rose-600 bg-rose-50 border border-rose-200 rounded-xl p-3 mb-4 max-w-md mx-auto"></div>
  
  <article class="calculator-result break-inside-avoid hidden transition-all duration-500 ease-out max-w-lg mx-auto"></article>
</section>

<script is:inline>
  (function() {
    const houseData = {
      1: {
        id: 'ramya',
        name: { en: 'Ramya House', si: 'රම්‍ය නිවාසය' },
        colorName: { en: 'Institutional Teal', si: 'ටීල් (Teal)' },
        colorHex: '#007A87',
        bgClass: 'bg-teal-50 border-teal-200 text-teal-900',
        badgeBg: 'bg-teal-700 text-white',
        motto: { en: 'Wisdom, Discipline & Moral Clarity', si: 'ප්‍රඥාව, විනය සහ සදාචාරාත්මක අඛණ්ඩතාව' },
        symbol: { en: 'Sacred Lotus (පද්මය)', si: 'ශුද්ධ වූ නෙළුම් මල' },
        description: {
          en: 'Guided by foundational Buddhist discipline, academic devotion, and reverence for college heritage. Ramya house stands for integrity, mindfulness, and scholastic diligence.',
          si: 'මූලික බෞද්ධ විනය, අධ්‍යාපනික කැපවීම සහ විද්‍යාලයීය උරුමයට ගරු කිරීම මූර්තිමත් කරයි. රම්‍ය නිවාසය සදාචාරාත්මක පාරිශුද්ධත්වය හා ධර්මානුකූල ශිෂ්‍ය පරපුරක් බිහිකිරීම අරමුණු කරයි.'
        }
      },
      2: {
        id: 'suramya',
        name: { en: 'Suramya House', si: 'සුරම්‍ය නිවාසය' },
        colorName: { en: 'Saffron Gold', si: 'කහ / රන්වන්' },
        colorHex: '#F58220',
        bgClass: 'bg-amber-50 border-amber-200 text-amber-950',
        badgeBg: 'bg-amber-600 text-white',
        motto: { en: 'Intellect, Leadership & Eloquence', si: 'බුද්ධිය, නායකත්වය සහ වාග් චතුර්යය' },
        symbol: { en: 'Blazing Torch (දැල්වෙන පන්දම)', si: 'දැල්වෙන පන්දම' },
        description: {
          en: 'Cultivating intellectual sharpness, ethical leadership, and harmonious team spirit in all co-curricular pursuits, debating societies, and scientific research.',
          si: 'තරගකාරී විෂය සමගාමී අභියෝගවලදී බුද්ධිමය තියුණුබව, ආචාරශීලී පාලනය සහ උපායශීලී කණ්ඩායම් නායකත්වය වර්ධනය කරයි. විවාද හා නිර්මාණශීලී කුසලතාවන්ගෙන් පෙරමුණ ගනී.'
        }
      },
      0: {
        id: 'subha',
        name: { en: 'Subha House', si: 'සුභ නිවාසය' },
        colorName: { en: 'Royal Maroon', si: 'තද රතු / මැරූන්' },
        colorHex: '#581838',
        bgClass: 'bg-rose-50 border-rose-200 text-rose-950',
        badgeBg: 'bg-[#581838] text-white',
        motto: { en: 'Valor, Athletic Tenacity & Sportsmanship', si: 'වීරත්වය, ක්‍රීඩා ශක්තිය සහ කණ්ඩායම් ආත්මය' },
        symbol: { en: 'Courageous Lion (කේසර සිංහයා)', si: 'කේසර සිංහයා' },
        description: {
          en: 'Radiating vibrant athletic energy, perseverance, and tenacious competitive drive at the annual sports meet, martial arts, and track events.',
          si: 'ප්‍රාණවත් ශක්තිය, මලල ක්‍රීඩා විශිෂ්ටත්වය සහ අවිහිංසක ක්‍රීඩා ආත්මය වාර්ෂික අන්තර් නිවාස තරග සහ කණ්ඩායම් ජයග්‍රහණ කරා යොමු කරයි. අධිෂ්ඨානශීලී ක්‍රීඩාශීලීත්වයේ ප්‍රතිමූර්තියයි.'
        }
      }
    };

    function initCalculators() {
      const roots = document.querySelectorAll('.house-calculator-root');
      roots.forEach(root => {
        if (root.dataset.initialized) return;
        root.dataset.initialized = 'true';

        const form = root.querySelector('.house-calculator-form');
        const input = root.querySelector('.admission-input');
        const resultBox = root.querySelector('.calculator-result');
        const errorBox = root.querySelector('.calculator-error');

        if (!form || !input || !resultBox || !errorBox) return;

        form.addEventListener('submit', function(e) {
          e.preventDefault();
          errorBox.classList.add('hidden');
          errorBox.textContent = '';

          const isSi = document.documentElement.lang === 'si';

          const rawVal = input.value.trim();
          const val = parseInt(rawVal, 10);
          
          if (isNaN(val) || val <= 0 || !Number.isInteger(Number(rawVal))) {
            errorBox.textContent = isSi ? 'කරුණාකර නිවැරදි ධන ඇතුළත් කිරීමේ අංකයක් සටහන් කරන්න.' : 'Please enter a valid positive integer admission number.';
            errorBox.classList.remove('hidden');
            resultBox.classList.add('hidden');
            return;
          }

          const remainder = val % 3;
          const house = houseData[remainder];

          const houseName = isSi ? house.name.si : house.name.en;
          const houseDesc = isSi ? house.description.si : house.description.en;
          const houseMotto = isSi ? house.motto.si : house.motto.en;
          const houseSymbol = isSi ? house.symbol.si : house.symbol.en;
          const numLabel = isSi ? 'ඇතුළත් කිරීමේ අංකය' : 'Admission Index';

          resultBox.innerHTML = `
            <div class="rounded-3xl border ${house.bgClass} p-6 sm:p-8 text-center shadow-md animate-in fade-in zoom-in duration-300">
              <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full ${house.badgeBg} text-xs font-bold uppercase tracking-wider mb-3">
                <span>${numLabel} #${val}</span>
              </div>
              
              <h4 class="text-2xl sm:text-3xl font-serif font-bold text-stone-900 mb-1">
                ${houseName}
              </h4>
              <p class="text-xs font-bold uppercase tracking-wider text-stone-500 mb-4">
                ${houseSymbol} • ${isSi ? house.colorName.si : house.colorName.en}
              </p>

              <div class="bg-white/90 backdrop-blur-xs p-4 sm:p-5 rounded-2xl border border-stone-200/70 text-left space-y-3 mb-4">
                <div>
                  <span class="text-[11px] font-bold uppercase tracking-wider text-stone-400 block mb-0.5">
                    ${isSi ? 'නිවාස ආදර්ශ පාඨය' : 'House Creed & Motto'}
                  </span>
                  <p class="text-sm font-serif font-semibold text-stone-800 italic">
                    "${houseMotto}"
                  </p>
                </div>
                <p class="text-xs text-stone-600 leading-relaxed pt-2 border-t border-stone-100">
                  ${houseDesc}
                </p>
              </div>

              <div class="text-[11px] text-stone-400">
                ${isSi ? 'ශ්‍රී චන්දානන්ද බෞද්ධ විද්‍යාලයීය නිල නිවාස වෙන්කිරීමේ නීතිය' : 'Official SCBC Collegiate Matriculation Formula'}
              </div>
            </div>
          `;

          resultBox.classList.remove('hidden');

          // Smooth scroll into view
          resultBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCalculators);
    } else {
      initCalculators();
    }
    document.addEventListener('astro:page-load', initCalculators);
  })();
</script>
