---
import { Trophy, Shield, Flame, Search, Sparkles } from 'lucide-react';
---

<section class="bg-stone-50 rounded-3xl border border-stone-200/60 p-8 sm:p-10 max-w-2xl mx-auto my-12 house-calculator-root break-inside-avoid">
  <header class="text-center mb-8">
    <p class="text-[11px] font-bold uppercase tracking-widest text-stone-500 mb-2">STUDENT ALLOCATION PORTAL</p>
    <h3 class="text-2xl sm:text-3xl font-serif font-bold text-stone-900 tracking-tight">Find Your Assigned House</h3>
    <p class="text-stone-500 text-sm sm:text-base max-w-md mx-auto mt-2 leading-relaxed">
      Enter your student index or admission number to verify your official house assignment.
    </p>
  </header>

  <form id="house-calculator-form" class="house-calculator-form no-print flex flex-col sm:flex-row gap-3 items-center justify-center max-w-md mx-auto mb-6">
    <div class="relative w-full">
      <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-stone-400">
        <Search size={18} />
      </div>
      <input 
        type="number" 
        name="admissionNumber" 
        min="1" 
        placeholder="Enter Admission No. (e.g. 2474)" 
        required
        class="admission-input w-full pl-10 pr-4 py-3.5 rounded-xl border border-stone-200 bg-white focus:outline-none focus:border-stone-900 focus:ring-1 focus:ring-stone-900 text-stone-900 text-sm font-medium transition-colors" 
      />
    </div>
    <button 
      type="submit" 
      class="w-full sm:w-auto shrink-0 bg-stone-900 hover:bg-stone-800 text-white font-medium px-6 py-3.5 rounded-xl transition-colors text-sm cursor-pointer flex items-center justify-center gap-2"
    >
      Check House
    </button>
  </form>

  <div class="calculator-error no-print hidden text-center text-xs font-semibold text-rose-600 bg-rose-50 border border-rose-200 rounded-xl p-3 mb-4 max-w-md mx-auto"></div>
  <article class="calculator-result break-inside-avoid hidden transition-all duration-500 ease-out max-w-md mx-auto"></article>
</section>

<script is:inline>
  (function() {
    const houseData = {
      1: {
        name: 'Ramya House',
        description: 'Guided by foundational Buddhist discipline, academic devotion, and respect for college heritage.'
      },
      2: {
        name: 'Suramya House',
        description: 'Cultivating intellectual sharpness, ethical leadership, and harmonious team spirit in all co-curricular pursuits.'
      },
      0: {
        name: 'Subha House',
        description: 'Radiating vibrant athletic energy, perseverance, and tenacious competitive drive at the annual sports meet.'
      }
    };

    function initCalculators() {
      const roots = document.querySelectorAll('.house-calculator-root');
      roots.forEach(root => {
        if (root.dataset.initialized) return;
        root.dataset.initialized = 'true';

        const form = root.querySelector('.house-calculator-form');
        const input = root.querySelector('.admission-input');
        const resultBox = root.querySelector('.calculator-result');
        const errorBox = root.querySelector('.calculator-error');

        if (!form || !input || !resultBox || !errorBox) return;

        form.addEventListener('submit', function(e) {
          e.preventDefault();
          errorBox.classList.add('hidden');
          errorBox.textContent = '';

          const val = parseInt(input.value, 10);
          if (isNaN(val) || val <= 0) {
            errorBox.textContent = 'Please enter a valid positive admission number.';
            errorBox.classList.remove('hidden');
            resultBox.classList.add('hidden');
            return;
          }

          const remainder = val % 3;
          const house = houseData[remainder];

          resultBox.innerHTML = `
            <div class="rounded-2xl border border-stone-200 bg-white p-6 text-center">
              <p class="text-[11px] text-stone-400 font-bold uppercase tracking-wider mb-2">Admission No. #${val}</p>
              <h4 class="text-2xl font-serif font-bold text-stone-900 mb-3">${house.name}</h4>
              <p class="text-sm text-stone-500 leading-relaxed bg-stone-50 p-4 rounded-xl border border-stone-100">
                ${house.description}
              </p>
            </div>
          `;

          resultBox.classList.remove('hidden');
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCalculators);
    } else {
      initCalculators();
    }
  })();
</script>
