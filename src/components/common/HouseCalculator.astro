---
import { Trophy, Shield, Flame, Search, Sparkles } from 'lucide-react';
---

<section class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 sm:p-8 max-w-2xl mx-auto my-8 house-calculator-root">
  <header class="text-center mb-6">
    <p class="text-xs font-bold uppercase tracking-widest text-school-teal mb-1">STUDENT ALLOCATION PORTAL</p>
    <h3 class="text-2xl font-serif font-bold text-school-textPrimary">Find Your Assigned House</h3>
    <p class="text-school-textMuted text-sm max-w-md mx-auto mt-1 leading-relaxed">
      Enter your student index or admission number to verify your official house assignment.
    </p>
  </header>

  <form class="house-calculator-form flex flex-col sm:flex-row gap-3 items-center justify-center max-w-md mx-auto mb-6">
    <div class="relative w-full">
      <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
        <Search size={18} />
      </div>
      <input 
        type="number" 
        name="admissionNumber" 
        min="1" 
        placeholder="Enter Admission No. (e.g. 2474)" 
        required
        class="admission-input w-full pl-10 pr-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-school-orange text-school-textPrimary text-sm font-medium transition-all shadow-2xs" 
      />
    </div>
    <button 
      type="submit" 
      class="w-full sm:w-auto shrink-0 bg-school-maroon hover:opacity-95 text-white font-semibold px-6 py-3 rounded-xl transition hover:-translate-y-0.5 shadow-sm text-sm cursor-pointer flex items-center justify-center gap-2"
    >
      Check House
    </button>
  </form>

  <div class="calculator-error hidden text-center text-xs font-semibold text-rose-600 bg-rose-50 border border-rose-200 rounded-xl p-3 mb-4 max-w-md mx-auto"></div>
  <article class="calculator-result hidden transition-all duration-500 ease-out max-w-md mx-auto"></article>
</section>

<script is:inline>
  (function() {
    const houseData = {
      1: {
        name: 'Ramya House',
        borderColor: 'border-t-[#581838]',
        description: 'Guided by foundational Buddhist discipline, academic devotion, and respect for college heritage.'
      },
      2: {
        name: 'Suramya House',
        borderColor: 'border-t-[#007A87]',
        description: 'Cultivating intellectual sharpness, ethical leadership, and harmonious team spirit in all co-curricular pursuits.'
      },
      0: {
        name: 'Subha House',
        borderColor: 'border-t-[#F58220]',
        description: 'Radiating vibrant athletic energy, perseverance, and tenacious competitive drive at the annual sports meet.'
      }
    };

    function initCalculators() {
      const roots = document.querySelectorAll('.house-calculator-root');
      roots.forEach(root => {
        if (root.dataset.initialized) return;
        root.dataset.initialized = 'true';

        const form = root.querySelector('.house-calculator-form');
        const input = root.querySelector('.admission-input');
        const resultBox = root.querySelector('.calculator-result');
        const errorBox = root.querySelector('.calculator-error');

        if (!form || !input || !resultBox || !errorBox) return;

        form.addEventListener('submit', function(e) {
          e.preventDefault();
          errorBox.classList.add('hidden');
          errorBox.textContent = '';

          const val = parseInt(input.value, 10);
          if (isNaN(val) || val <= 0) {
            errorBox.textContent = 'Please enter a valid positive admission number.';
            errorBox.classList.remove('hidden');
            resultBox.classList.add('hidden');
            return;
          }

          const remainder = val % 3;
          const house = houseData[remainder];

          resultBox.innerHTML = `
            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-md border-t-4 ${house.borderColor} text-center">
              <p class="text-xs text-slate-400 font-semibold uppercase tracking-wider mb-2">Admission No. #${val}</p>
              <h4 class="text-2xl font-serif font-bold text-school-textPrimary mb-3">${house.name}</h4>
              <p class="text-sm text-school-textMuted leading-relaxed bg-slate-50 p-3.5 rounded-xl border border-slate-100">
                ${house.description}
              </p>
            </div>
          `;

          resultBox.classList.remove('hidden');
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCalculators);
    } else {
      initCalculators();
    }
  })();
</script>
