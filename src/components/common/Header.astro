---
import { Menu, X, Phone, ArrowRight } from 'lucide-react';
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="bg-white/95 backdrop-blur-md border-b border-school-border sticky top-0 z-50 w-full" id="site-header">
  <div class="container mx-auto px-4 py-3 flex justify-between items-center">
    <a href="/" class="flex items-center gap-3.5 group">
      <img 
        src="/assets/branding/school-crest-official.png" 
        alt="Sri Chandananda Buddhist College Crest" 
        class="h-14 w-auto object-contain shrink-0" 
      />
      <div>
        <span class="block text-lg sm:text-xl md:text-2xl font-serif font-bold leading-tight tracking-tight text-school-textPrimary group-hover:text-school-maroon transition-colors">Sri Chandananda</span>
        <span class="block text-[11px] sm:text-xs md:text-sm text-school-maroon font-semibold tracking-wider uppercase">Buddhist College, Kandy</span>
      </div>
    </a>
    
    <!-- Desktop Navigation Links (Hidden on screens < md) -->
    <nav class="hidden md:flex gap-6 items-center font-medium text-sm">
      <a href="/" class={`py-1 transition-colors ${currentPath === '/' ? 'border-b-2 border-school-orange text-school-maroon font-semibold' : 'text-school-textMuted hover:text-school-maroon'}`}>Home</a>
      <a href="/about" class={`py-1 transition-colors ${currentPath === '/about' ? 'border-b-2 border-school-orange text-school-maroon font-semibold' : 'text-school-textMuted hover:text-school-maroon'}`}>About Us</a>
      <a href="/academics" class={`py-1 transition-colors ${currentPath === '/academics' ? 'border-b-2 border-school-orange text-school-maroon font-semibold' : 'text-school-textMuted hover:text-school-maroon'}`}>Academics</a>
      <a href="/student-life" class={`py-1 transition-colors ${currentPath === '/student-life' ? 'border-b-2 border-school-orange text-school-maroon font-semibold' : 'text-school-textMuted hover:text-school-maroon'}`}>Student Life</a>
      <a href="/admissions" class={`py-1 transition-colors ${currentPath === '/admissions' ? 'border-b-2 border-school-orange text-school-maroon font-semibold' : 'text-school-textMuted hover:text-school-maroon'}`}>Admissions</a>
      <a href="/contact" class={`py-1 transition-colors ${currentPath === '/contact' ? 'border-b-2 border-school-orange text-school-maroon font-semibold' : 'text-school-textMuted hover:text-school-maroon'}`}>Contact</a>
    </nav>

    <!-- Desktop Phone CTA (Hidden on screens < md) -->
    <a href="tel:+94812203162" class="hidden md:flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-school-teal text-school-teal hover:bg-school-teal hover:text-white transition font-medium text-sm">
      <Phone size={15} />
      <span>+94 81 220 3162</span>
    </a>

    <!-- Accessible Mobile Hamburger Toggle Button -->
    <button 
      id="mobile-menu-btn"
      class="md:hidden text-school-textPrimary hover:text-school-maroon p-2 rounded-lg focus:outline-none focus:ring-2 focus:ring-school-orange transition-colors" 
      aria-label="Toggle Navigation"
      aria-expanded="false"
      aria-controls="mobile-drawer"
    >
      <span id="menu-icon-open"><Menu size={24} /></span>
      <span id="menu-icon-close" class="hidden"><X size={24} /></span>
    </button>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div 
    id="mobile-drawer" 
    class="hidden md:hidden border-t border-school-border bg-white shadow-xl transition-all duration-300 ease-in-out px-4 py-5"
  >
    <div class="mb-4 pb-3 border-b border-slate-100 flex items-center justify-between">
      <div>
        <p class="font-serif text-sm font-bold text-school-textPrimary">ශ්‍රී චන්දානන්ද බෞද්ධ විද්‍යාලය</p>
        <p class="text-xs text-school-textMuted">Sri Chandananda Buddhist College</p>
      </div>
      <div class="flex h-2 w-8 rounded-sm overflow-hidden shrink-0">
        <div class="flex-1 bg-school-teal"></div>
        <div class="flex-1 bg-school-orange"></div>
        <div class="flex-1 bg-school-maroon"></div>
      </div>
    </div>

    <nav class="flex flex-col space-y-1 font-medium text-base mb-5" id="mobile-nav-links">
      <a href="/" class={`px-3 py-2.5 rounded-lg transition-colors flex items-center justify-between ${currentPath === '/' ? 'bg-orange-50/60 text-school-orange font-bold border-l-4 border-school-orange' : 'text-school-textPrimary hover:bg-slate-50'}`}>
        <span>Home</span>
        <ArrowRight size={16} class="text-slate-400" />
      </a>
      <a href="/about" class={`px-3 py-2.5 rounded-lg transition-colors flex items-center justify-between ${currentPath === '/about' ? 'bg-orange-50/60 text-school-orange font-bold border-l-4 border-school-orange' : 'text-school-textPrimary hover:bg-slate-50'}`}>
        <span>About Us</span>
        <ArrowRight size={16} class="text-slate-400" />
      </a>
      <a href="/academics" class={`px-3 py-2.5 rounded-lg transition-colors flex items-center justify-between ${currentPath === '/academics' ? 'bg-orange-50/60 text-school-orange font-bold border-l-4 border-school-orange' : 'text-school-textPrimary hover:bg-slate-50'}`}>
        <span>Academics</span>
        <ArrowRight size={16} class="text-slate-400" />
      </a>
      <a href="/student-life" class={`px-3 py-2.5 rounded-lg transition-colors flex items-center justify-between ${currentPath === '/student-life' ? 'bg-orange-50/60 text-school-orange font-bold border-l-4 border-school-orange' : 'text-school-textPrimary hover:bg-slate-50'}`}>
        <span>Student Life</span>
        <ArrowRight size={16} class="text-slate-400" />
      </a>
      <a href="/admissions" class={`px-3 py-2.5 rounded-lg transition-colors flex items-center justify-between ${currentPath === '/admissions' ? 'bg-orange-50/60 text-school-orange font-bold border-l-4 border-school-orange' : 'text-school-textPrimary hover:bg-slate-50'}`}>
        <span>Admissions</span>
        <ArrowRight size={16} class="text-slate-400" />
      </a>
      <a href="/contact" class={`px-3 py-2.5 rounded-lg transition-colors flex items-center justify-between ${currentPath === '/contact' ? 'bg-orange-50/60 text-school-orange font-bold border-l-4 border-school-orange' : 'text-school-textPrimary hover:bg-slate-50'}`}>
        <span>Contact</span>
        <ArrowRight size={16} class="text-slate-400" />
      </a>
    </nav>

    <!-- Mobile Phone Button -->
    <a 
      href="tel:+94812203162" 
      class="w-full py-3 rounded-lg border border-school-teal text-school-teal hover:bg-school-teal hover:text-white transition font-semibold text-sm flex items-center justify-center gap-2 shadow-xs"
    >
      <Phone size={16} />
      <span>Call Office: +94 81 220 3162</span>
    </a>
  </div>
</header>

<script>
  function setupMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const drawer = document.getElementById('mobile-drawer');
    const openIcon = document.getElementById('menu-icon-open');
    const closeIcon = document.getElementById('menu-icon-close');
    const navLinks = document.getElementById('mobile-nav-links');

    if (!btn || !drawer || !openIcon || !closeIcon) return;

    function toggleMenu(isOpen?: boolean) {
      const willOpen = isOpen !== undefined ? isOpen : drawer.classList.contains('hidden');
      if (willOpen) {
        drawer.classList.remove('hidden');
        openIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
        btn.setAttribute('aria-expanded', 'true');
      } else {
        drawer.classList.add('hidden');
        openIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      }
    }

    btn.onclick = (e) => {
      e.stopPropagation();
      toggleMenu();
    };

    // Close when clicking outside header
    document.addEventListener('click', (e) => {
      const header = document.getElementById('site-header');
      if (header && !header.contains(e.target as Node)) {
        toggleMenu(false);
      }
    });

    // Close when tapping a link in the mobile nav
    if (navLinks) {
      navLinks.querySelectorAll('a').forEach((link) => {
        link.onclick = () => {
          toggleMenu(false);
        };
      });
    }

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        toggleMenu(false);
      }
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>
