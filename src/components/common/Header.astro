---
import { Menu, X, Phone, ArrowRight } from 'lucide-react';
import { translations } from '../../i18n/translations';
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="bg-[#FCFCFC]/80 backdrop-blur-xl border-b border-stone-200/50 sticky top-0 z-50 w-full transition-all duration-300" id="site-header">
  <div class="container mx-auto px-4 py-3 flex justify-between items-center">
    <a href="/" class="flex items-center gap-3 group">
      <img 
        src="/assets/branding/school-crest-official.png" 
        alt="Sri Chandananda Buddhist College Crest" 
        class="h-12 sm:h-14 w-auto object-contain my-auto shrink-0" 
      />
      <div class="flex flex-col justify-center">
        <span class="block text-lg sm:text-xl md:text-2xl font-serif font-bold leading-tight tracking-tight text-school-textPrimary group-hover:text-school-maroon transition-colors">Sri Chandananda</span>
        <span class="block text-[11px] sm:text-xs md:text-sm text-school-maroon font-semibold tracking-wider uppercase">Buddhist College, Kandy</span>
      </div>
    </a>
    
    <!-- Desktop Navigation Links (Hidden on screens < md) -->
    <nav class="hidden md:flex gap-6 items-center font-medium text-sm">
      <a href="/" data-i18n="nav.home" class={`py-1 transition-all ${currentPath === '/' ? 'text-stone-900 font-bold border-b border-stone-900' : 'text-stone-500 hover:text-stone-900'}`}>Home</a>
      <a href="/about" data-i18n="nav.about" class={`py-1 transition-all ${currentPath === '/about' ? 'text-stone-900 font-bold border-b border-stone-900' : 'text-stone-500 hover:text-stone-900'}`}>About Us</a>
      <a href="/academics" data-i18n="nav.academics" class={`py-1 transition-all ${currentPath === '/academics' ? 'text-stone-900 font-bold border-b border-stone-900' : 'text-stone-500 hover:text-stone-900'}`}>Academics</a>
      <a href="/student-life" data-i18n="nav.student_life" class={`py-1 transition-all ${currentPath === '/student-life' ? 'text-stone-900 font-bold border-b border-stone-900' : 'text-stone-500 hover:text-stone-900'}`}>Student Life</a>
      <a href="/admissions" data-i18n="nav.admissions" class={`py-1 transition-all ${currentPath === '/admissions' ? 'text-stone-900 font-bold border-b border-stone-900' : 'text-stone-500 hover:text-stone-900'}`}>Admissions</a>
      <a href="/contact" data-i18n="nav.contact" class={`py-1 transition-all ${currentPath === '/contact' ? 'text-stone-900 font-bold border-b border-stone-900' : 'text-stone-500 hover:text-stone-900'}`}>Contact</a>
    </nav>

    <!-- Desktop Phone CTA & Lang Toggle -->
    <div class="hidden md:flex items-center gap-4">
      <button id="lang-toggle-desktop" aria-label="Switch Language" class="lang-toggle inline-flex items-center justify-center min-w-[72px] text-xs font-semibold px-2.5 py-1.5 bg-stone-100/50 rounded-md hover:bg-stone-100 transition-all text-stone-900 whitespace-nowrap">
        <span class="text-stone-900 font-bold text-xs">EN</span> <span class="text-stone-300 font-normal mx-1">|</span> <span data-lang-btn="si" class="text-stone-400 font-normal text-xs">සිං</span>
      </button>
      <a href="tel:+94812203162" class="flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-stone-200 text-stone-600 hover:bg-stone-50 hover:text-stone-900 transition font-medium text-sm">
        <Phone size={15} />
        <span>+94 81 220 3162</span>
      </a>
    </div>

    <!-- Accessible Mobile Hamburger Toggle Button -->
    <button 
      id="mobile-menu-btn"
      class="md:hidden text-school-textPrimary hover:text-school-maroon p-2 rounded-lg focus:outline-none focus:ring-2 focus:ring-school-orange transition-colors" 
      aria-label="Toggle Navigation"
      aria-expanded="false"
      aria-controls="mobile-drawer"
    >
      <span id="menu-icon-open"><Menu size={24} /></span>
      <span id="menu-icon-close" class="hidden"><X size={24} /></span>
    </button>
  </div>

  <!-- Mobile Navigation Drawer (Full Screen Overlay) -->
  <div 
    id="mobile-drawer" 
    class="hidden md:hidden fixed inset-0 z-50 bg-[#FCFCFC] flex flex-col justify-between transition-opacity duration-300 overflow-y-auto"
  >
    <!-- Drawer Top Header Bar -->
    <div class="px-4 py-3 flex justify-between items-center border-b border-stone-200/60 bg-[#FCFCFC] sticky top-0 z-10 shrink-0">
      <a href="/" class="flex items-center gap-3">
        <img 
          src="/assets/branding/school-crest-official.png" 
          alt="Sri Chandananda Buddhist College Crest" 
          class="h-11 w-auto object-contain shrink-0" 
        />
        <div class="flex flex-col justify-center">
          <span class="block text-base font-serif font-bold leading-tight text-stone-900">Sri Chandananda</span>
          <span class="block text-[10px] text-school-maroon font-semibold tracking-wider uppercase">Buddhist College, Kandy</span>
        </div>
      </a>
      
      <button 
        id="mobile-drawer-close-btn"
        class="text-stone-900 p-2 rounded-lg hover:bg-stone-100 focus:outline-none transition-colors"
        aria-label="Close Navigation"
      >
        <X size={24} />
      </button>
    </div>

    <!-- Drawer Navigation Links -->
    <nav class="px-6 py-4 flex flex-col space-y-1 my-auto shrink-0" id="mobile-nav-links">
      <a href="/" class={`text-xl font-serif tracking-tight transition-colors py-2.5 flex items-center justify-between border-b border-stone-100 ${currentPath === '/' ? 'text-stone-900 font-bold' : 'text-stone-500 hover:text-stone-900 font-normal'}`}>
        <span data-i18n="nav.home">Home</span>
        {currentPath === '/' && <span class="w-2 h-2 rounded-full bg-stone-900"></span>}
      </a>
      <a href="/about" class={`text-xl font-serif tracking-tight transition-colors py-2.5 flex items-center justify-between border-b border-stone-100 ${currentPath === '/about' ? 'text-stone-900 font-bold' : 'text-stone-500 hover:text-stone-900 font-normal'}`}>
        <span data-i18n="nav.about">About Us</span>
        {currentPath === '/about' && <span class="w-2 h-2 rounded-full bg-stone-900"></span>}
      </a>
      <a href="/academics" class={`text-xl font-serif tracking-tight transition-colors py-2.5 flex items-center justify-between border-b border-stone-100 ${currentPath === '/academics' ? 'text-stone-900 font-bold' : 'text-stone-500 hover:text-stone-900 font-normal'}`}>
        <span data-i18n="nav.academics">Academics</span>
        {currentPath === '/academics' && <span class="w-2 h-2 rounded-full bg-stone-900"></span>}
      </a>
      <a href="/student-life" class={`text-xl font-serif tracking-tight transition-colors py-2.5 flex items-center justify-between border-b border-stone-100 ${currentPath === '/student-life' ? 'text-stone-900 font-bold' : 'text-stone-500 hover:text-stone-900 font-normal'}`}>
        <span data-i18n="nav.student_life">Student Life</span>
        {currentPath === '/student-life' && <span class="w-2 h-2 rounded-full bg-stone-900"></span>}
      </a>
      <a href="/admissions" class={`text-xl font-serif tracking-tight transition-colors py-2.5 flex items-center justify-between border-b border-stone-100 ${currentPath === '/admissions' ? 'text-stone-900 font-bold' : 'text-stone-500 hover:text-stone-900 font-normal'}`}>
        <span data-i18n="nav.admissions">Admissions</span>
        {currentPath === '/admissions' && <span class="w-2 h-2 rounded-full bg-stone-900"></span>}
      </a>
      <a href="/contact" class={`text-xl font-serif tracking-tight transition-colors py-2.5 flex items-center justify-between border-b border-stone-100 ${currentPath === '/contact' ? 'text-stone-900 font-bold' : 'text-stone-500 hover:text-stone-900 font-normal'}`}>
        <span data-i18n="nav.contact">Contact</span>
        {currentPath === '/contact' && <span class="w-2 h-2 rounded-full bg-stone-900"></span>}
      </a>
    </nav>

    <!-- Drawer Footer Actions -->
    <div class="px-6 pb-6 pt-3 flex flex-col gap-4 border-t border-stone-100 shrink-0">
      <a 
        href="tel:+94812203162" 
        class="text-stone-900 text-sm font-medium inline-flex items-center gap-2.5"
      >
        <Phone size={16} class="text-stone-500" />
        <span>+94 81 220 3162</span>
      </a>
      
      <button id="lang-toggle-mobile" aria-label="Switch Language" class="lang-toggle self-start flex items-center justify-center min-w-[72px] text-xs font-semibold px-3.5 py-1.5 rounded-full border border-stone-200 hover:bg-stone-50 transition-all text-stone-900">
        <span class="text-stone-900 font-bold text-xs">EN</span> <span class="text-stone-300 font-normal mx-1.5">|</span> <span data-lang-btn="si" class="text-stone-400 font-normal text-xs">සිං</span>
      </button>
    </div>
  </div>
</header>

<script is:inline define:vars={{ translations }}>
  function setupTranslation() {
    const currentLang = localStorage.getItem('scbc_lang') || 'en';
    const toggleBtns = document.querySelectorAll('.lang-toggle');

    function applyTranslations(lang) {
      document.documentElement.setAttribute('lang', lang);
      localStorage.setItem('scbc_lang', lang);

      document.querySelectorAll('[data-i18n]').forEach((el) => {
        const key = el.getAttribute('data-i18n');
        const text = (translations[lang] && translations[lang][key]) || (translations[key] && translations[key][lang]);
        if (text) {
          el.textContent = text;
        }
      });

      document.querySelectorAll('[data-en]').forEach((el) => {
        const text = el.getAttribute(`data-${lang}`);
        if (text) {
          el.textContent = text;
        }
      });

      document.querySelectorAll('[data-placeholder-en]').forEach((el) => {
        const text = el.getAttribute(`data-placeholder-${lang}`);
        if (text) {
          el.setAttribute('placeholder', text);
        }
      });
      document.querySelectorAll('[data-alt-en]').forEach((el) => {
        const text = el.getAttribute(`data-alt-${lang}`);
        if (text) {
          el.setAttribute('alt', text);
        }
      });

      toggleBtns.forEach(btn => {
        if (lang === 'en') {
          btn.innerHTML = '<span class="text-school-maroon font-bold text-xs">EN</span> <span class="text-slate-300 font-normal mx-1">|</span> <span data-lang-btn="si" class="text-slate-500 font-normal hover:text-slate-800 transition-colors text-xs">සිං</span>';
        } else {
          btn.innerHTML = '<span class="text-slate-500 font-normal hover:text-slate-800 transition-colors text-xs">EN</span> <span class="text-slate-300 font-normal mx-1">|</span> <span data-lang-btn="si" class="text-school-maroon font-medium font-sinhalaSans text-sm">සිං</span>';
        }
      });
    }

    applyTranslations(currentLang);

    toggleBtns.forEach(btn => {
      btn.onclick = (e) => {
        e.preventDefault();
        const activeLang = localStorage.getItem('scbc_lang') || 'en';
        const newLang = activeLang === 'en' ? 'si' : 'en';
        applyTranslations(newLang);
      };
    });
  }
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupTranslation);
  } else {
    setupTranslation();
  }
  document.addEventListener('astro:page-load', setupTranslation);
</script>

<script>
  function setupMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const drawer = document.getElementById('mobile-drawer');
    const closeBtn = document.getElementById('mobile-drawer-close-btn');
    const openIcon = document.getElementById('menu-icon-open');
    const closeIcon = document.getElementById('menu-icon-close');
    const navLinks = document.getElementById('mobile-nav-links');

    if (!btn || !drawer) return;

    function toggleMenu(isOpen?: boolean) {
      const willOpen = isOpen !== undefined ? isOpen : drawer.classList.contains('hidden');
      if (willOpen) {
        drawer.classList.remove('hidden');
        if (openIcon) openIcon.classList.add('hidden');
        if (closeIcon) closeIcon.classList.remove('hidden');
        btn.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
      } else {
        drawer.classList.add('hidden');
        if (openIcon) openIcon.classList.remove('hidden');
        if (closeIcon) closeIcon.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      }
    }

    btn.onclick = (e) => {
      e.stopPropagation();
      toggleMenu();
    };

    if (closeBtn) {
      closeBtn.onclick = (e) => {
        e.stopPropagation();
        toggleMenu(false);
      };
    }

    // Close when clicking outside header
    document.addEventListener('click', (e) => {
      const header = document.getElementById('site-header');
      if (header && !header.contains(e.target as Node)) {
        toggleMenu(false);
      }
    });

    // Close when tapping a link in the mobile nav
    if (navLinks) {
      navLinks.querySelectorAll('a').forEach((link) => {
        link.onclick = () => {
          toggleMenu(false);
        };
      });
    }

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        toggleMenu(false);
      }
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>
