---
import { Menu, X, Phone, ArrowRight } from 'lucide-react';
import { translations } from '../../i18n/translations';
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="bg-[#FCFCFC]/90 backdrop-blur-xl border-b border-stone-200/60 sticky top-0 z-50 w-full transition-all duration-300" id="site-header">
  <div class="container mx-auto px-4 py-2.5 sm:py-3 flex justify-between items-center gap-3 relative z-20">
    <a href="/" class="flex items-center gap-2.5 sm:gap-3 group shrink min-w-0">
      <img 
        src="/assets/branding/school-crest-official.png" 
        alt="Sri Chandananda Buddhist College Crest" 
        class="h-10 sm:h-12 w-auto object-contain my-auto shrink-0" 
      />
      <div class="flex flex-col justify-center min-w-0">
        <span class="block text-base sm:text-lg md:text-2xl font-serif font-bold leading-tight tracking-tight text-stone-900 group-hover:text-school-maroon transition-colors truncate">Sri Chandananda</span>
        <span class="block text-[10px] sm:text-xs md:text-sm text-school-maroon font-semibold tracking-wider uppercase truncate">Buddhist College, Kandy</span>
      </div>
    </a>
    
    <!-- Desktop Navigation Links (Hidden on screens < lg) -->
    <nav class="hidden lg:flex gap-4 xl:gap-6 items-center font-medium text-xs xl:text-sm whitespace-nowrap">
      <a href="/" data-i18n="nav.home" class={`py-1 transition-all ${currentPath === '/' ? 'text-stone-900 font-bold border-b border-stone-900' : 'text-stone-500 hover:text-stone-900'}`}>Home</a>
      <a href="/about" data-i18n="nav.about" class={`py-1 transition-all ${currentPath === '/about' ? 'text-stone-900 font-bold border-b border-stone-900' : 'text-stone-500 hover:text-stone-900'}`}>About Us</a>
      <a href="/academics" data-i18n="nav.academics" class={`py-1 transition-all ${currentPath === '/academics' ? 'text-stone-900 font-bold border-b border-stone-900' : 'text-stone-500 hover:text-stone-900'}`}>Academics</a>
      <a href="/timetables" data-i18n="nav.timetables" class={`py-1 transition-all ${currentPath === '/timetables' ? 'text-stone-900 font-bold border-b border-stone-900' : 'text-stone-500 hover:text-stone-900'}`}>Timetables</a>
      <a href="/student-life" data-i18n="nav.student_life" class={`py-1 transition-all ${currentPath === '/student-life' ? 'text-stone-900 font-bold border-b border-stone-900' : 'text-stone-500 hover:text-stone-900'}`}>Student Life</a>
      <a href="/admissions" data-i18n="nav.admissions" class={`py-1 transition-all ${currentPath === '/admissions' ? 'text-stone-900 font-bold border-b border-stone-900' : 'text-stone-500 hover:text-stone-900'}`}>Admissions</a>
      <a href="/contact" data-i18n="nav.contact" class={`py-1 transition-all ${currentPath === '/contact' ? 'text-stone-900 font-bold border-b border-stone-900' : 'text-stone-500 hover:text-stone-900'}`}>Contact</a>
    </nav>

    <!-- Desktop Phone CTA & Lang Toggle -->
    <div class="hidden lg:flex items-center gap-3 xl:gap-4 shrink-0">
      <button id="lang-toggle-desktop" aria-label="Switch Language" class="lang-toggle inline-flex items-center justify-center min-w-[72px] text-xs font-semibold px-2.5 py-1.5 bg-stone-100/70 rounded-md hover:bg-stone-200/70 transition-all text-stone-900 whitespace-nowrap cursor-pointer">
        <span class="text-stone-900 font-bold text-xs">EN</span> <span class="text-stone-300 font-normal mx-1">|</span> <span data-lang-btn="si" class="text-stone-400 font-normal text-xs">සිං</span>
      </button>
      <a href="tel:+94812203162" class="flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-stone-200 text-stone-600 hover:bg-stone-50 hover:text-stone-900 transition font-medium text-xs xl:text-sm whitespace-nowrap">
        <Phone size={14} />
        <span>+94 81 220 3162</span>
      </a>
    </div>

    <!-- Minimalist Mobile Hamburger Toggle Button (Hedvig Theme) -->
    <button 
      id="mobile-menu-btn"
      class="lg:hidden flex items-center justify-center p-2 text-stone-900 hover:text-stone-600 hover:bg-stone-100/60 rounded-full transition-colors cursor-pointer shrink-0 z-30 min-w-[44px] min-h-[44px]" 
      aria-label="Toggle Navigation"
      aria-expanded="false"
      aria-controls="mobile-drawer"
    >
      <span id="menu-icon-open" class="flex items-center justify-center transition-transform duration-300"><Menu size={24} strokeWidth={1.75} /></span>
      <span id="menu-icon-close" class="hidden flex items-center justify-center transition-transform duration-300"><X size={24} strokeWidth={1.75} /></span>
    </button>
  </div>

  <!-- Mobile Dropdown Menu Overlay (Positioned Directly Below Sticky Header - Solid Hedvig Theme) -->
  <div 
    id="mobile-drawer" 
    class="lg:hidden absolute top-full left-0 right-0 z-50 bg-[#FCFCFC] border-b border-stone-200/80 shadow-2xl opacity-0 -translate-y-2 pointer-events-none transition-all duration-300 ease-out flex flex-col justify-between max-h-[85vh] overflow-y-auto"
  >
    <div class="container mx-auto px-6 py-6 flex flex-col gap-6">
      <!-- Drawer Navigation Links -->
      <nav class="flex flex-col space-y-1" id="mobile-nav-links">
        <a href="/" class={`text-xl font-serif tracking-tight transition-colors py-3 flex items-center justify-between border-b border-stone-100 ${currentPath === '/' ? 'text-stone-900 font-bold' : 'text-stone-500 hover:text-stone-900 font-normal'}`}>
          <span data-i18n="nav.home">Home</span>
          {currentPath === '/' && <span class="w-2 h-2 rounded-full bg-stone-900"></span>}
        </a>
        <a href="/about" class={`text-xl font-serif tracking-tight transition-colors py-3 flex items-center justify-between border-b border-stone-100 ${currentPath === '/about' ? 'text-stone-900 font-bold' : 'text-stone-500 hover:text-stone-900 font-normal'}`}>
          <span data-i18n="nav.about">About Us</span>
          {currentPath === '/about' && <span class="w-2 h-2 rounded-full bg-stone-900"></span>}
        </a>
        <a href="/academics" class={`text-xl font-serif tracking-tight transition-colors py-3 flex items-center justify-between border-b border-stone-100 ${currentPath === '/academics' ? 'text-stone-900 font-bold' : 'text-stone-500 hover:text-stone-900 font-normal'}`}>
          <span data-i18n="nav.academics">Academics</span>
          {currentPath === '/academics' && <span class="w-2 h-2 rounded-full bg-stone-900"></span>}
        </a>
        <a href="/timetables" class={`text-xl font-serif tracking-tight transition-colors py-3 flex items-center justify-between border-b border-stone-100 ${currentPath === '/timetables' ? 'text-stone-900 font-bold' : 'text-stone-500 hover:text-stone-900 font-normal'}`}>
          <span data-i18n="nav.timetables">Timetables</span>
          {currentPath === '/timetables' && <span class="w-2 h-2 rounded-full bg-stone-900"></span>}
        </a>
        <a href="/academics/resources" class={`text-xl font-serif tracking-tight transition-colors py-3 flex items-center justify-between border-b border-stone-100 ${currentPath === '/academics/resources' ? 'text-stone-900 font-bold' : 'text-stone-500 hover:text-stone-900 font-normal'}`}>
          <span data-i18n="nav.resources">Academic Vault</span>
          {currentPath === '/academics/resources' && <span class="w-2 h-2 rounded-full bg-stone-900"></span>}
        </a>
        <a href="/student-life" class={`text-xl font-serif tracking-tight transition-colors py-3 flex items-center justify-between border-b border-stone-100 ${currentPath === '/student-life' ? 'text-stone-900 font-bold' : 'text-stone-500 hover:text-stone-900 font-normal'}`}>
          <span data-i18n="nav.student_life">Student Life</span>
          {currentPath === '/student-life' && <span class="w-2 h-2 rounded-full bg-stone-900"></span>}
        </a>
        <a href="/admissions" class={`text-xl font-serif tracking-tight transition-colors py-3 flex items-center justify-between border-b border-stone-100 ${currentPath === '/admissions' ? 'text-stone-900 font-bold' : 'text-stone-500 hover:text-stone-900 font-normal'}`}>
          <span data-i18n="nav.admissions">Admissions</span>
          {currentPath === '/admissions' && <span class="w-2 h-2 rounded-full bg-stone-900"></span>}
        </a>
        <a href="/contact" class={`text-xl font-serif tracking-tight transition-colors py-3 flex items-center justify-between border-b border-stone-100 ${currentPath === '/contact' ? 'text-stone-900 font-bold' : 'text-stone-500 hover:text-stone-900 font-normal'}`}>
          <span data-i18n="nav.contact">Contact</span>
          {currentPath === '/contact' && <span class="w-2 h-2 rounded-full bg-stone-900"></span>}
        </a>
      </nav>

      <!-- Drawer Footer Actions -->
      <div class="pt-3 border-t border-stone-100 flex items-center justify-between gap-3">
        <a 
          href="tel:+94812203162" 
          class="inline-flex items-center gap-2 px-3.5 py-2 rounded-full bg-stone-100 text-stone-900 text-xs font-semibold hover:bg-stone-200 transition-colors"
        >
          <Phone size={14} class="text-stone-600" />
          <span>+94 81 220 3162</span>
        </a>
        
        <button id="lang-toggle-mobile" aria-label="Switch Language" class="lang-toggle inline-flex items-center justify-center min-w-[72px] text-xs font-semibold px-3.5 py-2 rounded-full border border-stone-200 bg-white hover:bg-stone-50 transition-all text-stone-900 shadow-2xs">
          <span class="text-stone-900 font-bold text-xs">EN</span> <span class="text-stone-300 font-normal mx-1.5">|</span> <span data-lang-btn="si" class="text-stone-400 font-normal text-xs">සිං</span>
        </button>
      </div>
    </div>
  </div>
</header>

<script is:inline define:vars={{ translations }}>
  function setupTranslation() {
    const currentLang = localStorage.getItem('scbc_lang') || 'en';
    const toggleBtns = document.querySelectorAll('.lang-toggle');

    function applyTranslations(lang) {
      document.documentElement.setAttribute('lang', lang);
      localStorage.setItem('scbc_lang', lang);

      document.querySelectorAll('[data-i18n]').forEach((el) => {
        const key = el.getAttribute('data-i18n');
        const text = (translations[lang] && translations[lang][key]) || (translations[key] && translations[key][lang]);
        if (text) {
          el.textContent = text;
        }
      });

      document.querySelectorAll('[data-en]').forEach((el) => {
        const text = el.getAttribute(`data-${lang}`);
        if (text) {
          el.textContent = text;
        }
      });

      document.querySelectorAll('[data-placeholder-en]').forEach((el) => {
        const text = el.getAttribute(`data-placeholder-${lang}`);
        if (text) {
          el.setAttribute('placeholder', text);
        }
      });
      document.querySelectorAll('[data-alt-en]').forEach((el) => {
        const text = el.getAttribute(`data-alt-${lang}`);
        if (text) {
          el.setAttribute('alt', text);
        }
      });

      toggleBtns.forEach(btn => {
        if (lang === 'en') {
          btn.innerHTML = '<span class="text-school-maroon font-bold text-xs">EN</span> <span class="text-slate-300 font-normal mx-1">|</span> <span data-lang-btn="si" class="text-slate-500 font-normal hover:text-slate-800 transition-colors text-xs">සිං</span>';
        } else {
          btn.innerHTML = '<span class="text-slate-500 font-normal hover:text-slate-800 transition-colors text-xs">EN</span> <span class="text-slate-300 font-normal mx-1">|</span> <span data-lang-btn="si" class="text-school-maroon font-medium font-sinhalaSans text-sm">සිං</span>';
        }
      });
    }

    applyTranslations(currentLang);

    toggleBtns.forEach(btn => {
      btn.onclick = (e) => {
        e.preventDefault();
        const activeLang = localStorage.getItem('scbc_lang') || 'en';
        const newLang = activeLang === 'en' ? 'si' : 'en';
        applyTranslations(newLang);
      };
    });
  }
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupTranslation);
  } else {
    setupTranslation();
  }
  document.addEventListener('astro:page-load', setupTranslation);
</script>

<script is:inline>
  function initMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const drawer = document.getElementById('mobile-drawer');
    const openIcon = document.getElementById('menu-icon-open');
    const closeIcon = document.getElementById('menu-icon-close');

    if (!btn || !drawer) return;

    function toggleMenu(isOpen) {
      const willOpen = isOpen !== undefined ? isOpen : drawer.classList.contains('pointer-events-none');
      if (willOpen) {
        drawer.classList.remove('opacity-0', '-translate-y-2', 'pointer-events-none');
        drawer.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
        if (openIcon) openIcon.classList.add('hidden');
        if (closeIcon) closeIcon.classList.remove('hidden');
        btn.setAttribute('aria-expanded', 'true');
      } else {
        drawer.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
        drawer.classList.add('opacity-0', '-translate-y-2', 'pointer-events-none');
        if (openIcon) openIcon.classList.remove('hidden');
        if (closeIcon) closeIcon.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      }
    }

    btn.onclick = function(e) {
      e.preventDefault();
      e.stopPropagation();
      toggleMenu();
    };

    // Close when clicking outside header
    document.addEventListener('click', function(e) {
      const header = document.getElementById('site-header');
      if (header && !header.contains(e.target)) {
        toggleMenu(false);
      }
    });

    // Close on Escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        toggleMenu(false);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMobileMenu);
  } else {
    initMobileMenu();
  }
  document.addEventListener('astro:page-load', initMobileMenu);
</script>
