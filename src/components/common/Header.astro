---
import { Menu, Phone } from 'lucide-react';
---

<header class="bg-primary text-white shadow-md sticky top-0 z-50">
  <div class="container mx-auto px-4 py-3 flex justify-between items-center">
    <div class="flex items-center gap-4">
      <img src="/assets/branding/crest.jpg" alt="Sri Chandananda Buddhist College Crest" class="w-12 h-12 rounded-full object-cover" width="48" height="48" />
      <div>
        <h1 class="text-xl md:text-2xl font-serif font-bold leading-tight">Sri Chandananda</h1>
        <p class="text-xs md:text-sm text-accent tracking-wider uppercase font-semibold">Buddhist College, Kandy</p>
      </div>
    </div>
    
    <nav class="hidden md:flex gap-6 items-center font-medium text-sm">
      <a href="/" class="hover:text-accent transition-colors">Home</a>
      <a href="/about" class="hover:text-accent transition-colors">About Us</a>
      <a href="/academics" class="hover:text-accent transition-colors">Academics</a>
      <a href="/student-life" class="hover:text-accent transition-colors">Student Life</a>
      <a href="/admissions" class="hover:text-accent transition-colors">Admissions</a>
      <a href="/contact" class="hover:text-accent transition-colors">Contact</a>
    </nav>

    <div class="hidden lg:flex items-center gap-2 text-accent font-semibold text-sm">
      <Phone size={16} />
      <span>+94 81 220 3162</span>
    </div>

    <button class="md:hidden text-white hover:text-accent p-2">
      <Menu size={24} />
      <span class="sr-only">Menu</span>
    </button>
  </div>
</header>
