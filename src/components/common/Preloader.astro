---
// Preloader.astro - Official institutional emblem spinner with session caching
---

<div 
  id="scbc-preloader" 
  class="fixed inset-0 z-[100] flex flex-col items-center justify-center bg-white transition-opacity duration-700 ease-out"
  aria-hidden="true"
>
  <!-- Central Emblem & Oval Spinner Ring Container -->
  <div class="relative flex items-center justify-center w-36 h-48 sm:w-40 sm:h-52">
    <!-- Ambient Aura behind the oval contour -->
    <div class="absolute w-32 h-44 bg-amber-400/15 blur-xl rounded-[50%] pointer-events-none"></div>

    <!-- Contoured Oval Spinner Ring (SVG) -->
    <svg 
      class="absolute inset-0 w-full h-full pointer-events-none" 
      viewBox="0 0 160 210" 
      fill="none" 
      xmlns="http://www.w3.org/2000/svg"
    >
      <defs>
        <!-- Tri-Color Gradient 1 -->
        <linearGradient id="scbcTriGrad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#007A87" />
          <stop offset="50%" stop-color="#F58220" />
          <stop offset="100%" stop-color="#581838" />
        </linearGradient>
        <!-- Tri-Color Gradient 2 (Reverse) -->
        <linearGradient id="scbcTriGradReverse" x1="100%" y1="100%" x2="0%" y2="0%">
          <stop offset="0%" stop-color="#581838" />
          <stop offset="50%" stop-color="#F58220" />
          <stop offset="100%" stop-color="#007A87" />
        </linearGradient>
      </defs>

      <!-- Faint guide track for oval contour -->
      <ellipse 
        cx="80" 
        cy="105" 
        rx="72" 
        ry="96" 
        stroke="#E2E8F0" 
        stroke-width="1.5" 
        opacity="0.7" 
      />

      <!-- Primary Orbiting Tri-Color Arc -->
      <ellipse 
        class="spinner-orbit-primary" 
        cx="80" 
        cy="105" 
        rx="72" 
        ry="96" 
        stroke="url(#scbcTriGrad)" 
        stroke-width="3" 
        stroke-linecap="round" 
      />

      <!-- Secondary Harmonic Orbiting Arc -->
      <ellipse 
        class="spinner-orbit-secondary" 
        cx="80" 
        cy="105" 
        rx="72" 
        ry="96" 
        stroke="url(#scbcTriGradReverse)" 
        stroke-width="2.5" 
        stroke-linecap="round" 
      />
    </svg>

    <!-- Transparent Oval Crest -->
    <img 
      src="/assets/branding/school-crest-official.png" 
      alt="Sri Chandananda Buddhist College Crest" 
      class="h-24 sm:h-28 w-auto object-contain z-10 drop-shadow-md select-none" 
      width="112" 
      height="112"
      loading="eager"
    />
  </div>

  <!-- Formal Bilingual Typography -->
  <div class="text-center mt-6 z-10 animate-fade-in">
    <p class="font-serif font-bold text-school-textPrimary text-base sm:text-lg tracking-wide">
      ශ්‍රී චන්දානන්ද බෞද්ධ විද්‍යාලය
    </p>
    <p class="text-[11px] sm:text-xs text-school-maroon font-semibold tracking-widest uppercase mt-0.5">
      Sri Chandananda Buddhist College
    </p>
  </div>
</div>

<style>
  .spinner-orbit-primary {
    stroke-dasharray: 140 390;
    animation: orbit-flow-primary 2.2s linear infinite;
  }

  .spinner-orbit-secondary {
    stroke-dasharray: 90 440;
    animation: orbit-flow-secondary 2.2s linear infinite;
  }

  @keyframes orbit-flow-primary {
    0% {
      stroke-dashoffset: 0;
    }
    100% {
      stroke-dashoffset: -530;
    }
  }

  @keyframes orbit-flow-secondary {
    0% {
      stroke-dashoffset: -265;
    }
    100% {
      stroke-dashoffset: -795;
    }
  }

  .animate-fade-in {
    animation: preloader-text-fade 0.8s ease-out forwards;
  }

  @keyframes preloader-text-fade {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script is:inline>
  (function() {
    const preloader = document.getElementById('scbc-preloader');
    if (!preloader) return;

    // Check session storage immediately to bypass on repeated/internal navigation
    try {
      if (sessionStorage.getItem('scbc_preloader_seen')) {
        preloader.style.display = 'none';
        preloader.remove();
        return;
      }
      sessionStorage.setItem('scbc_preloader_seen', 'true');
    } catch (e) {
      // Storage access safety
    }

    let dismissed = false;
    function dismiss() {
      if (dismissed) return;
      dismissed = true;
      preloader.style.opacity = '0';
      preloader.style.pointerEvents = 'none';
      
      const onTransitionEnd = () => {
        preloader.remove();
        preloader.removeEventListener('transitionend', onTransitionEnd);
      };
      preloader.addEventListener('transitionend', onTransitionEnd);

      // Fallback cleanup
      setTimeout(() => {
        if (preloader.parentNode) {
          preloader.remove();
        }
      }, 750);
    }

    if (document.readyState === 'complete') {
      setTimeout(dismiss, 600);
    } else {
      window.addEventListener('load', () => {
        setTimeout(dismiss, 500);
      });
    }

    // Safety timeout fallback (1400ms max)
    setTimeout(dismiss, 1400);
  })();
</script>
