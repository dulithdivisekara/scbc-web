---
import { MapPin, Phone, Mail, Clock } from 'lucide-react';
---

<footer class="mt-auto bg-[#0a0a0a] text-stone-400 w-full overflow-hidden border-t border-stone-800">
  <!-- Official Tri-Color Brand Stripe -->
  <div class="h-1.5 w-full flex">
    <div class="flex-1 bg-school-teal"></div>
    <div class="flex-1 bg-school-orange"></div>
    <div class="flex-1 bg-school-maroon"></div>
  </div>

  <div class="container mx-auto px-4 py-16 grid grid-cols-1 md:grid-cols-12 gap-10">
    <!-- Brand & Mission Column -->
    <div class="md:col-span-5">
      <div class="flex items-center gap-4 mb-5">
        <img 
          src="/assets/branding/school-crest-official.png" 
          alt="Sri Chandananda Buddhist College Crest" 
          class="h-20 sm:h-24 w-auto object-contain shrink-0 self-center" 
        />
        <div class="flex flex-col justify-center">
          <h3 class="text-stone-100 text-lg sm:text-xl font-serif font-bold leading-tight">Sri Chandananda Buddhist College</h3>
          <p class="text-xs sm:text-sm font-sinhalaSerif text-stone-300 mt-1 leading-normal">ශ්‍රී චන්දානන්ද බෞද්ධ විද්‍යාලය</p>
          <p data-i18n="footer.location" class="text-[11px] text-stone-500 uppercase tracking-wider mt-1 font-semibold">ASGIRIYA, KANDY, SRI LANKA</p>
        </div>
      </div>
      <p data-i18n="footer.desc" class="text-sm text-stone-400 leading-relaxed max-w-sm mb-6">Nurturing intellectual wisdom, moral discipline, and cultural heritage in the sacred hill capital of Kandy since 2006. Operating under the visionary guidance of Most Ven. Dr. Godagama Mangala Thero.
      </p>
    </div>

    <!-- Quick Navigation Column -->
    <div class="md:col-span-3">
      <h4 class="text-stone-100 text-lg font-serif font-bold tracking-tight mb-5" data-i18n="footer.quick_links">Quick Links</h4>
      <ul class="space-y-3 text-sm">
        <li><a href="/about" class="text-stone-400 hover:text-stone-100 transition-colors" data-i18n="about.title">About the College</a></li>
        <li><a href="/academics" class="text-stone-400 hover:text-stone-100 transition-colors" data-i18n="footer.academics">Academic Structure</a></li>
        <li><a href="/timetables" class="text-stone-400 hover:text-stone-100 transition-colors" data-i18n="footer.timetables">Timetables &amp; Bell Times</a></li>
        <li><a href="/academics/resources" class="text-stone-400 hover:text-stone-100 transition-colors" data-i18n="footer.resources">Past Papers &amp; Vault</a></li>
        <li><a href="/student-life" class="text-stone-400 hover:text-stone-100 transition-colors" data-i18n="footer.student_life">Student Life &amp; Sports</a></li>
        <li><a href="/admissions" class="text-stone-400 hover:text-stone-100 transition-colors" data-i18n="footer.admissions">Admissions &amp; Forms</a></li>
        <li><a href="/contact" class="text-stone-400 hover:text-stone-100 transition-colors" data-i18n="footer.contact_dir">Contact Directory</a></li>
      </ul>
    </div>

    <!-- Campus & Contact Info Column -->
    <div class="md:col-span-4">
      <h4 class="text-stone-100 text-lg font-serif font-bold tracking-tight mb-5" data-i18n="contact.title">Contact Us</h4>
      <ul class="space-y-3.5 text-sm">
        <li class="flex items-start gap-3">
          <MapPin size={18} class="text-stone-400 shrink-0 mt-0.5" strokeWidth={1.5} />
          <span class="text-stone-400" data-i18n="contact.address_val">Asgiri Vihara Mawatha, Kandy 20000, Sri Lanka</span>
        </li>
        <li class="flex items-center gap-3">
          <Phone size={18} class="text-stone-400 shrink-0" strokeWidth={1.5} />
          <a href="tel:+94812203162" class="text-stone-400 hover:text-stone-100 transition-colors font-sans">+94 81 220 3162</a>
        </li>
        <li class="flex items-center gap-3">
          <Mail size={18} class="text-stone-400 shrink-0" strokeWidth={1.5} />
          <a href="mailto:info@scbck.lk" class="text-stone-400 hover:text-stone-100 transition-colors font-sans">info@scbck.lk</a>
        </li>
        <li class="flex items-start gap-3">
          <Clock size={18} class="text-stone-400 shrink-0 mt-0.5" strokeWidth={1.5} />
          <span class="text-stone-400" data-i18n="footer.hours_line">Office Hours: Monday - Friday, 7:30 AM - 1:30 PM</span>
        </li>
      </ul>
    </div>
  </div>

  <!-- Bottom Legal & Alumnus Attribution Bar -->
  <div class="border-t border-stone-800/80 py-5 text-xs text-stone-500">
    <div class="container mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-2.5 text-center sm:text-left">
      <p data-i18n="footer.copyright">
        &copy; 2026 Sri Chandananda Buddhist College. All rights reserved.
      </p>
      <p class="text-[11px] text-stone-500 font-medium">
        <span data-i18n="footer.credit">Alumni Contribution by</span> <a href="https://dulith.me" target="_blank" rel="noopener noreferrer" class="hover:text-stone-300 transition text-stone-400 underline underline-offset-4 decoration-stone-700">Dulith Divisekara</a>
      </p>
    </div>
  </div>
</footer>
