---
import { MapPin, Phone, Mail, Clock } from 'lucide-react';
---

<footer class="bg-gray-900 text-gray-300 py-12 border-t-4 border-accent">
  <div class="container mx-auto px-4 grid grid-cols-1 md:grid-cols-3 gap-8">
    
    <div>
      <div class="flex items-center gap-3 mb-4">
        <img src="/assets/branding/crest.jpg" alt="SCBC Crest" class="w-10 h-10 rounded-full object-cover" width="40" height="40" />
        <h3 class="text-white text-lg font-serif font-bold">Sri Chandananda Buddhist College</h3>
      </div>
      <p class="text-sm leading-relaxed mb-4 max-w-sm">
        Empowering the next generation through wisdom, discipline, and Buddhist philosophy since 2006.
      </p>
    </div>

    <div>
      <h4 class="text-white text-md font-semibold uppercase tracking-wider mb-4">Quick Links</h4>
      <ul class="space-y-2 text-sm">
        <li><a href="/about" class="hover:text-accent transition-colors">About Us</a></li>
        <li><a href="/academics" class="hover:text-accent transition-colors">Academics</a></li>
        <li><a href="/student-life" class="hover:text-accent transition-colors">Student Life</a></li>
        <li><a href="/admissions" class="hover:text-accent transition-colors">Admissions</a></li>
      </ul>
    </div>

    <div>
      <h4 class="text-white text-md font-semibold uppercase tracking-wider mb-4">Contact Information</h4>
      <ul class="space-y-3 text-sm">
        <li class="flex items-start gap-3">
          <MapPin size={18} class="text-accent shrink-0 mt-0.5" />
          <span>Asgiri Vihara Mawatha, Kandy 20000, Sri Lanka</span>
        </li>
        <li class="flex items-center gap-3">
          <Phone size={18} class="text-accent shrink-0" />
          <span>+94 81 220 3162</span>
        </li>
        <li class="flex items-center gap-3">
          <Mail size={18} class="text-accent shrink-0" />
          <span>info@scbck.lk</span>
        </li>
        <li class="flex items-start gap-3">
          <Clock size={18} class="text-accent shrink-0 mt-0.5" />
          <span>Office Hours: Mon-Fri, 7:30 AM - 1:30 PM</span>
        </li>
      </ul>
    </div>
  </div>

  <div class="container mx-auto px-4 mt-8 pt-6 border-t border-gray-800 text-center text-sm">
    <p>&copy; {new Date().getFullYear()} Sri Chandananda Buddhist College, Kandy. All rights reserved.</p>
  </div>
</footer>
