---
import { MapPin, Phone, Mail, Clock } from 'lucide-react';
---

<footer class="bg-white border-t border-school-border text-school-textMuted">
  <!-- Tri-color Brand Rule on Footer Top -->
  <div class="h-1 w-full flex">
    <div class="flex-1 bg-school-teal"></div>
    <div class="flex-1 bg-school-orange"></div>
    <div class="flex-1 bg-school-maroon"></div>
  </div>

  <div class="container mx-auto px-4 py-12 grid grid-cols-1 md:grid-cols-3 gap-8">
    <div>
      <div class="flex items-center gap-3 mb-4">
        <div class="w-10 h-10 rounded-full overflow-hidden border border-school-border shadow-sm p-0.5 bg-white">
          <img src="/assets/branding/crest.jpg" alt="SCBC Crest" class="w-full h-full rounded-full object-cover" width="40" height="40" />
        </div>
        <h3 class="text-school-textPrimary text-lg font-serif font-bold">Sri Chandananda Buddhist College</h3>
      </div>
      <p class="text-sm leading-relaxed mb-4 max-w-sm text-school-textMuted">
        Empowering the next generation through wisdom, discipline, and Buddhist philosophy since 2006.
      </p>
    </div>

    <div>
      <h4 class="text-school-textPrimary text-sm font-semibold uppercase tracking-wider mb-4 border-l-2 border-school-orange pl-2">Quick Links</h4>
      <ul class="space-y-2 text-sm">
        <li><a href="/about" class="hover:text-school-maroon transition-colors">About Us</a></li>
        <li><a href="/academics" class="hover:text-school-maroon transition-colors">Academics</a></li>
        <li><a href="/student-life" class="hover:text-school-maroon transition-colors">Student Life</a></li>
        <li><a href="/admissions" class="hover:text-school-maroon transition-colors">Admissions</a></li>
      </ul>
    </div>

    <div>
      <h4 class="text-school-textPrimary text-sm font-semibold uppercase tracking-wider mb-4 border-l-2 border-school-teal pl-2">Contact Information</h4>
      <ul class="space-y-3 text-sm">
        <li class="flex items-start gap-3">
          <MapPin size={18} class="text-school-teal shrink-0 mt-0.5" />
          <span>Asgiri Vihara Mawatha, Kandy 20000, Sri Lanka</span>
        </li>
        <li class="flex items-center gap-3">
          <Phone size={18} class="text-school-teal shrink-0" />
          <span>+94 81 220 3162</span>
        </li>
        <li class="flex items-center gap-3">
          <Mail size={18} class="text-school-teal shrink-0" />
          <span>info@scbck.lk</span>
        </li>
        <li class="flex items-start gap-3">
          <Clock size={18} class="text-school-teal shrink-0 mt-0.5" />
          <span>Office Hours: Mon-Fri, 7:30 AM - 1:30 PM</span>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-school-border py-6 text-center text-xs text-school-textMuted bg-school-surface">
    <div class="container mx-auto px-4">
      <p>&copy; {new Date().getFullYear()} Sri Chandananda Buddhist College, Kandy. All rights reserved.</p>
    </div>
  </div>
</footer>
