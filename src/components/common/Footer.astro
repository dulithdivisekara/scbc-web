---
import { MapPin, Phone, Mail, Clock } from 'lucide-react';
---

<footer class="bg-[#0B132B] text-slate-300">
  <!-- Official Tri-Color Brand Stripe -->
  <div class="h-1.5 w-full flex">
    <div class="flex-1 bg-school-teal"></div>
    <div class="flex-1 bg-school-orange"></div>
    <div class="flex-1 bg-school-maroon"></div>
  </div>

  <div class="container mx-auto px-4 py-16 grid grid-cols-1 md:grid-cols-12 gap-10">
    <!-- Brand & Mission Column -->
    <div class="md:col-span-5">
      <div class="flex items-start gap-4 mb-5">
        <div class="w-12 h-12 rounded-full overflow-hidden border border-slate-700 bg-white p-0.5 shrink-0 shadow-sm">
          <img src="/assets/branding/crest.jpg" alt="SCBC Crest" class="w-full h-full rounded-full object-cover" width="48" height="48" />
        </div>
        <div>
          <h3 class="text-white text-xl font-serif font-bold leading-tight">Sri Chandananda Buddhist College</h3>
          <p class="text-sm font-serif text-amber-400 mt-1">ශ්‍රී චන්දානන්ද බෞද්ධ විද්‍යාලය</p>
          <p class="text-xs text-slate-400 uppercase tracking-wider mt-0.5">Asgiriya, Kandy, Sri Lanka</p>
        </div>
      </div>
      <p class="text-sm text-slate-400 leading-relaxed max-w-sm mb-6">
        Empowering the next generation through wisdom, discipline, and Buddhist philosophy since 2006. Operating under the visionary guidance of Most Ven. Dr. Godagama Mangala Thero.
      </p>
      <div class="flex items-center gap-2 text-xs text-slate-500 uppercase tracking-wider font-semibold">
        <span>Ministry of Education Registered</span>
        <span>•</span>
        <span>Kandy District</span>
      </div>
    </div>

    <!-- Quick Navigation Column -->
    <div class="md:col-span-3">
      <h4 class="text-white text-sm font-semibold uppercase tracking-wider mb-5 border-l-2 border-school-orange pl-2.5">Quick Links</h4>
      <ul class="space-y-3 text-sm">
        <li><a href="/about" class="text-slate-400 hover:text-school-orange transition">About the College</a></li>
        <li><a href="/academics" class="text-slate-400 hover:text-school-orange transition">Academic Structure</a></li>
        <li><a href="/student-life" class="text-slate-400 hover:text-school-orange transition">Student Life & Sports</a></li>
        <li><a href="/admissions" class="text-slate-400 hover:text-school-orange transition">Admissions & Forms</a></li>
        <li><a href="/contact" class="text-slate-400 hover:text-school-orange transition">Contact Directory</a></li>
      </ul>
    </div>

    <!-- Campus & Contact Info Column -->
    <div class="md:col-span-4">
      <h4 class="text-white text-sm font-semibold uppercase tracking-wider mb-5 border-l-2 border-school-teal pl-2.5">Campus Contact</h4>
      <ul class="space-y-3.5 text-sm">
        <li class="flex items-start gap-3">
          <MapPin size={18} class="text-school-teal shrink-0 mt-0.5" />
          <span class="text-slate-400">Asgiri Vihara Mawatha, Kandy 20000, Sri Lanka</span>
        </li>
        <li class="flex items-center gap-3">
          <Phone size={18} class="text-school-teal shrink-0" />
          <a href="tel:+94812203162" class="text-slate-400 hover:text-school-orange transition">+94 81 220 3162</a>
        </li>
        <li class="flex items-center gap-3">
          <Mail size={18} class="text-school-teal shrink-0" />
          <a href="mailto:info@scbck.lk" class="text-slate-400 hover:text-school-orange transition">info@scbck.lk</a>
        </li>
        <li class="flex items-start gap-3">
          <Clock size={18} class="text-school-teal shrink-0 mt-0.5" />
          <span class="text-slate-400">Office Hours: Monday - Friday, 7:30 AM - 1:30 PM</span>
        </li>
      </ul>
    </div>
  </div>

  <!-- Subtle Dark Border Separator & Copyright -->
  <div class="border-t border-slate-800 py-6 text-center text-xs text-slate-500">
    <div class="container mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p>&copy; {new Date().getFullYear()} Sri Chandananda Buddhist College, Kandy. All rights reserved.</p>
      <p class="text-slate-500">Wisdom • Discipline • Buddhist Values</p>
    </div>
  </div>
</footer>
