---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/common/Header.astro';
import Footer from '../../components/common/Footer.astro';
import { AcademicVaultExplorer } from '../../components/academics/AcademicVaultExplorer';
import { BookOpen, ShieldCheck, DownloadCloud } from 'lucide-react';
---

<BaseLayout title="Academic Resource Vault & Past Papers | Sri Chandananda Buddhist College">
  <Header />

  <main class="flex-grow py-8 sm:py-16 bg-[#FCFCFC]">
    <div class="container mx-auto px-4 max-w-6xl">
      <!-- Breadcrumb Navigation -->
      <nav class="flex items-center gap-2 text-xs text-stone-500 mb-6">
        <a href="/" class="hover:text-stone-900 transition-colors">Home</a>
        <span>/</span>
        <a href="/academics" class="hover:text-stone-900 transition-colors">Academics</a>
        <span>/</span>
        <span class="text-stone-900 font-semibold">Academic Resource Vault</span>
      </nav>

      <!-- Hero Header Section -->
      <div class="mb-8 sm:mb-12 max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-teal-50 border border-teal-200/80 text-teal-900 text-xs font-semibold uppercase tracking-wider mb-3">
          <BookOpen size={13} />
          <span data-en="SCBC Digital Academic Archive" data-si="ශ්‍රී චන්දානන්ද ඩිජිටල් අධ්‍යයන එකතුව">
            SCBC Digital Academic Archive
          </span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-serif font-bold text-stone-900 tracking-tight mb-3">
          <span data-en="Past Papers, Model Tests &amp; Syllabi" data-si="පසුගිය ප්‍රශ්න පත්‍ර, ආදර්ශ පත්‍ර හා විෂය නිර්දේශ">
            Past Papers, Model Tests &amp; Syllabi
          </span>
        </h1>
        <p class="text-stone-600 text-sm sm:text-base leading-relaxed" data-en="Comprehensive digital library of Sri Chandananda Buddhist College term tests, national examination past papers, marking schemes, and revision notes." data-si="ශ්‍රී චන්දානන්ද බෞද්ධ විද්‍යාලයීය වාර විභාග ප්‍රශ්න පත්‍ර, ජාතික විභාග පසුගිය ප්‍රශ්න පත්‍ර, ලකුණු දීමේ පටිපාටි සහ විෂය නිර්දේශ එකතුව.">
          Comprehensive digital library of Sri Chandananda Buddhist College term tests, national examination past papers, marking schemes, and revision notes.
        </p>
      </div>

      <!-- Reactive Academic Vault Explorer Island -->
      <AcademicVaultExplorer client:load />

      <!-- Notice for Faculty and Students -->
      <div class="mt-12 p-6 rounded-2xl bg-stone-100/80 border border-stone-200/90">
        <div class="flex items-start gap-4">
          <div class="p-2.5 rounded-xl bg-white text-stone-700 shadow-xs shrink-0">
            <ShieldCheck size={22} />
          </div>
          <div class="space-y-1">
            <h3 class="text-base font-serif font-bold text-stone-900" data-en="Academic Integrity &amp; Resource Usage" data-si="අධ්‍යයන අඛණ්ඩතාව සහ සම්පත් පරිශීලනය">
              Academic Integrity &amp; Resource Usage
            </h3>
            <p class="text-xs sm:text-sm text-stone-600 leading-relaxed" data-en="All materials provided in this repository are curated exclusively for the educational development of Sri Chandananda Buddhist College students. Reproduction for commercial purposes without prior sanction from the College administration is strictly prohibited." data-si="මෙම සංචිතයේ ඇති සියලුම අධ්‍යයන ද්‍රව්‍ය ශ්‍රී චන්දානන්ද බෞද්ධ විද්‍යාලයීය සිසුන්ගේ අධ්‍යාපනික ප්‍රයෝජනය සඳහා පමණක් සැකසූ ඒවා වේ. විද්‍යාලීය පාලනාධිකාරියේ අවසරයකින් තොරව වාණිජමය අරමුණු සඳහා ප්‍රයෝජනයට ගැනීම සපුරා තහනම් වේ.">
              All materials provided in this repository are curated exclusively for the educational development of Sri Chandananda Buddhist College students. Reproduction for commercial purposes without prior sanction from the College administration is strictly prohibited.
            </p>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
