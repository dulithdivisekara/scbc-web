---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import HouseCalculator from '../components/common/HouseCalculator.astro';
import { Heart, Trophy, Shield, Flame } from 'lucide-react';
---

<BaseLayout title="Student Life">
  <Header />
  
  <main class="flex-grow py-12 sm:py-16 bg-school-surface">
    <div class="container mx-auto px-4 max-w-4xl">
      <div class="text-center mb-10 sm:mb-12">
        <span class="text-xs font-bold uppercase tracking-wider text-school-teal mb-2 inline-block">Co-Curricular & Ethics</span>
        <h1 class="text-3xl sm:text-4xl font-serif font-bold text-school-textPrimary">Student Life & Culture</h1>
        <div class="w-16 h-1 bg-school-orange mx-auto mt-4 mb-4"></div>
      </div>
      
      <section class="mb-12 sm:mb-16">
        <div class="bg-white rounded-xl shadow-sm border border-school-border overflow-hidden">
          <div class="p-6 sm:p-8 md:p-10">
            <div class="flex items-center gap-3 sm:gap-4 mb-6">
              <div class="bg-purple-50 border border-purple-100 text-school-maroon p-2.5 sm:p-3 rounded-full shrink-0">
                <Heart size={24} />
              </div>
              <h2 class="text-xl sm:text-2xl font-serif font-bold text-school-textPrimary">Our School Culture</h2>
            </div>
            
            <p class="text-sm sm:text-base text-school-textMuted leading-relaxed mb-6 sm:mb-8">
              Our school culture is deeply rooted in respect, mindfulness, and Buddhist values, fostering a disciplined, compassionate, and inspiring academic environment.
            </p>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
              <div class="bg-school-surface border border-school-border p-5 sm:p-6 rounded-xl">
                <p class="text-xs text-school-teal uppercase font-semibold mb-2 tracking-wider">Traditional Greeting</p>
                <p class="font-serif text-school-maroon text-lg sm:text-xl font-medium italic">"May the triple gems bless you!"</p>
              </div>
              
              <div class="bg-school-surface border border-school-border p-5 sm:p-6 rounded-xl">
                <p class="text-xs text-school-teal uppercase font-semibold mb-2 tracking-wider">Addressing Educators</p>
                <p class="font-serif text-school-maroon text-lg sm:text-xl font-medium">"Guruthuma" & "Guruthumi"</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section>
        <div class="text-center mb-8 sm:mb-10">
          <div class="inline-block bg-orange-50 border border-orange-200 text-school-orange p-3 rounded-full mb-3">
            <Trophy size={28} />
          </div>
          <h2 class="text-2xl sm:text-3xl font-serif font-bold text-school-textPrimary mb-3">Collegiate House System</h2>
          <p class="text-school-textMuted max-w-2xl mx-auto text-sm sm:text-base leading-relaxed">
            The heart of student life at Sri Chandananda Buddhist College beats through our three storied houses. Students compete with intense house pride and sportsmanship in the annual Inter-House Sports Meet, academic debates, and aesthetic competitions.
          </p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-white rounded-2xl border border-slate-200 p-6 relative overflow-hidden shadow-sm hover:shadow-md transition flex flex-col group border-t-4 border-t-[#581838]">
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-bold uppercase tracking-wider text-[#581838] bg-purple-50 border border-purple-200 px-2.5 py-1 rounded-full">
                Virtues of Discipline & Heritage
              </span>
              <div class="w-10 h-10 rounded-xl bg-purple-50 text-[#581838] flex items-center justify-center border border-purple-100 group-hover:scale-110 transition-transform">
                <Trophy size={20} />
              </div>
            </div>
            <h3 class="text-2xl font-serif font-bold text-school-textPrimary mb-1 group-hover:text-[#581838] transition-colors">Ramya House</h3>
            <p class="text-xs text-slate-500 font-semibold uppercase tracking-wider mb-3">Discipline & Heritage</p>
            <p class="text-sm text-school-textMuted leading-relaxed">
              Named in reflection of traditional dignity, Ramya members uphold steadfast discipline, academic diligence, and profound respect for Buddhist heritage on and off the field.
            </p>
          </div>
          
          <div class="bg-white rounded-2xl border border-slate-200 p-6 relative overflow-hidden shadow-sm hover:shadow-md transition flex flex-col group border-t-4 border-t-[#007A87]">
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-bold uppercase tracking-wider text-[#007A87] bg-teal-50 border border-teal-200 px-2.5 py-1 rounded-full">
                Virtues of Wisdom & Leadership
              </span>
              <div class="w-10 h-10 rounded-xl bg-teal-50 text-[#007A87] flex items-center justify-center border border-teal-100 group-hover:scale-110 transition-transform">
                <Shield size={20} />
              </div>
            </div>
            <h3 class="text-2xl font-serif font-bold text-school-textPrimary mb-1 group-hover:text-[#007A87] transition-colors">Suramya House</h3>
            <p class="text-xs text-slate-500 font-semibold uppercase tracking-wider mb-3">Wisdom & Leadership</p>
            <p class="text-sm text-school-textMuted leading-relaxed">
              Representing intellectual clarity and strategic leadership, Suramya champions tactical excellence, oratory prowess, and unwavering teamwork in all house challenges.
            </p>
          </div>
          
          <div class="bg-white rounded-2xl border border-slate-200 p-6 relative overflow-hidden shadow-sm hover:shadow-md transition flex flex-col group border-t-4 border-t-[#F58220]">
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-bold uppercase tracking-wider text-[#F58220] bg-orange-50 border border-orange-200 px-2.5 py-1 rounded-full">
                Virtues of Sportsmanship & Vitality
              </span>
              <div class="w-10 h-10 rounded-xl bg-orange-50 text-[#F58220] flex items-center justify-center border border-orange-100 group-hover:scale-110 transition-transform">
                <Flame size={20} />
              </div>
            </div>
            <h3 class="text-2xl font-serif font-bold text-school-textPrimary mb-1 group-hover:text-[#F58220] transition-colors">Subha House</h3>
            <p class="text-xs text-slate-500 font-semibold uppercase tracking-wider mb-3">Sportsmanship & Vitality</p>
            <p class="text-sm text-school-textMuted leading-relaxed">
              Symbolizing boundless energy and perseverance, Subha excels in track and field, athletics, and passionate competitive spirit during the annual sports meet.
            </p>
          </div>
        </div>

        <div class="mt-12">
          <HouseCalculator />
        </div>
      </section>
    </div>
  </main>
  
  <Footer />
</BaseLayout>
