---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import HouseCalculator from '../components/common/HouseCalculator.astro';
import { Heart, Trophy, Shield, Flame } from 'lucide-react';
---

<BaseLayout title="Student Life">
  <Header />
  
  <main class="flex-grow py-12 sm:py-16 bg-school-surface">
    <div class="container mx-auto px-4 max-w-4xl">
      <div class="text-center mb-10 sm:mb-12">
        <span data-i18n="student_life.co_curricular" class="text-xs font-bold uppercase tracking-wider text-school-teal mb-2 inline-block">Co-Curricular & Ethics</span>
        <h1 data-i18n="student_life.title" class="text-3xl sm:text-4xl font-serif font-bold text-school-textPrimary">Student Life & Co-Curricular Excellence</h1>
        <div class="w-16 h-1 bg-school-orange mx-auto mt-4 mb-4"></div>
      </div>
      
      <section class="mb-12 sm:mb-16">
        <div class="bg-white rounded-xl shadow-sm border border-school-border overflow-hidden">
          <div class="p-6 sm:p-8 md:p-10">
            <div class="flex items-center gap-3 sm:gap-4 mb-6">
              <div class="bg-purple-50 border border-purple-100 text-school-maroon p-2.5 sm:p-3 rounded-full shrink-0">
                <Heart size={24} />
              </div>
              <h2 data-i18n="student_life.culture_title" class="text-xl sm:text-2xl font-serif font-bold text-school-textPrimary">Our School Culture</h2>
            </div>
            
            <p data-i18n="student_life.culture_desc" class="text-sm sm:text-base text-school-textMuted leading-relaxed mb-6 sm:mb-8">
              Our school culture is deeply rooted in respect, mindfulness, and Buddhist values, fostering a disciplined, compassionate, and inspiring academic environment.
            </p>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
              <div class="bg-school-surface border border-school-border p-5 sm:p-6 rounded-xl">
                <p data-i18n="student_life.traditional_greeting" class="text-xs text-school-teal uppercase font-semibold mb-2 tracking-wider">Traditional Greeting</p>
                <p class="font-serif text-school-maroon text-lg sm:text-xl font-medium italic" data-i18n="student_life.greeting_quote" data-en='"May the triple gems bless you!"' data-si='"තෙරුවන් සරණයි!"'>"May the triple gems bless you!"</p>
              </div>
              
              <div class="bg-school-surface border border-school-border p-5 sm:p-6 rounded-xl">
                <p data-i18n="student_life.addressing_educators" class="text-xs text-school-teal uppercase font-semibold mb-2 tracking-wider">Addressing Educators</p>
                <p class="font-serif text-school-maroon text-lg sm:text-xl font-medium" data-i18n="student_life.educators_quote" data-en='"Guruthuma" & "Guruthumi"' data-si='"ගුරුතුමා" සහ "ගුරුතුමිය"'>"Guruthuma" & "Guruthumi"</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section>
        <div class="text-center mb-8 sm:mb-10">
          <div class="inline-block bg-orange-50 border border-orange-200 text-school-orange p-3 rounded-full mb-3">
            <Trophy size={28} />
          </div>
          <h2 data-i18n="student_life.house_system_title" class="text-2xl sm:text-3xl font-serif font-bold text-school-textPrimary mb-3">Collegiate House System</h2>
          <p class="text-school-textMuted max-w-2xl mx-auto text-sm sm:text-base leading-relaxed" data-en="The heart of student life at Sri Chandananda Buddhist College beats through our three storied houses. Students compete with intense house pride and sportsmanship in the annual Inter-House Sports Meet, academic debates, and aesthetic competitions." data-si="ශ්‍රී චන්දානන්ද බෞද්ධ විද්‍යාලයේ ශිෂ්‍ය ජීවිතය ප්‍රධාන වශයෙන් නිවාස තුනක් වටා ගෙතී ඇත. වාර්ෂික නිවාසාන්තර මලල ක්‍රීඩා උළෙල, අධ්‍යාපනික විවාද සහ සෞන්දර්ය තරඟ වලදී සිසුහු මහත් අභිමානයෙන් සහ ක්‍රීඩාශීලීත්වයෙන් තරඟ කරති.">
            The heart of student life at Sri Chandananda Buddhist College beats through our three storied houses. Students compete with intense house pride and sportsmanship in the annual Inter-House Sports Meet, academic debates, and aesthetic competitions.
          </p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-white rounded-2xl border border-slate-200 p-6 relative overflow-hidden shadow-sm hover:shadow-md transition flex flex-col group border-t-4 border-t-[#581838]">
            <h3 class="text-2xl font-serif font-bold text-school-textPrimary mb-3 group-hover:text-[#581838] transition-colors">Ramya House</h3>
            <p class="text-sm text-school-textMuted leading-relaxed" data-en="Named in reflection of traditional dignity, Ramya members uphold steadfast discipline, academic diligence, and profound respect for Buddhist heritage on and off the field." data-si="සාම්ප්‍රදායික අභිමානය පිළිබිඹු කරන රම්‍ය නිවාසයේ සාමාජිකයින් ක්‍රීඩා පිටියේදී මෙන්ම ඉන් පිටතදීත් ස්ථාවර විනය, අධ්‍යාපනික කැපවීම සහ බෞද්ධ උරුමයට ගැඹුරු ගෞරවයක් දක්වයි.">
              Named in reflection of traditional dignity, Ramya members uphold steadfast discipline, academic diligence, and profound respect for Buddhist heritage on and off the field.
            </p>
          </div>
          
          <div class="bg-white rounded-2xl border border-slate-200 p-6 relative overflow-hidden shadow-sm hover:shadow-md transition flex flex-col group border-t-4 border-t-[#007A87]">
            <h3 class="text-2xl font-serif font-bold text-school-textPrimary mb-3 group-hover:text-[#007A87] transition-colors">Suramya House</h3>
            <p class="text-sm text-school-textMuted leading-relaxed" data-en="Representing intellectual clarity and strategic leadership, Suramya champions tactical excellence, oratory prowess, and unwavering teamwork in all house challenges." data-si="බුද්ධිමය පැහැදිලිකම සහ උපායමාර්ගික නායකත්වය නියෝජනය කරන සුරම්‍ය නිවාසය සියලු නිවාස අභියෝගයන්හිදී උපක්‍රමශීලී විශිෂ්ටත්වය, කථිකත්වය සහ නොසැලෙන කණ්ඩායම් හැඟීම වෙනුවෙන් පෙනී සිටියි.">
              Representing intellectual clarity and strategic leadership, Suramya champions tactical excellence, oratory prowess, and unwavering teamwork in all house challenges.
            </p>
          </div>
          
          <div class="bg-white rounded-2xl border border-slate-200 p-6 relative overflow-hidden shadow-sm hover:shadow-md transition flex flex-col group border-t-4 border-t-[#F58220]">
            <h3 class="text-2xl font-serif font-bold text-school-textPrimary mb-3 group-hover:text-[#F58220] transition-colors">Subha House</h3>
            <p class="text-sm text-school-textMuted leading-relaxed" data-en="Symbolizing boundless energy and perseverance, Subha excels in track and field, athletics, and passionate competitive spirit during the annual sports meet." data-si="අසීමිත ශක්තිය සහ නොපසුබට උත්සාහය සංකේතවත් කරන සුභ නිවාසය වාර්ෂික ක්‍රීඩා උළෙලේදී මලල ක්‍රීඩා සහ උද්‍යෝගිමත් තරඟකාරීත්වය අතින් විශිෂ්ටත්වයක් දක්වයි.">
              Symbolizing boundless energy and perseverance, Subha excels in track and field, athletics, and passionate competitive spirit during the annual sports meet.
            </p>
          </div>
        </div>

        <div class="mt-12">
          <HouseCalculator />
        </div>
      </section>
    </div>
  </main>
  
  <Footer />
</BaseLayout>
