---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import HouseCalculator from '../components/common/HouseCalculator.astro';
import { getEntry } from 'astro:content';

const studentLifeArticle = await getEntry('articles', 'student-life');
const galleryPage = (await getEntry('pages', 'student-life'))!.data;
---

<BaseLayout title="Student Life">
  <Header />
  
  <main class="flex-grow py-16 sm:py-24 bg-[#FCFCFC]">
    <div class="container mx-auto px-4 max-w-4xl">
      <div class="mb-12 sm:mb-16">
        <h1 data-i18n="student_life.title" class="text-4xl sm:text-5xl font-serif font-bold text-stone-900 tracking-tight">Student Life & Co-Curricular Excellence</h1>
      </div>
      
      <!-- Article Lead / Pull Quote -->
      <blockquote class="text-2xl sm:text-3xl font-serif italic text-stone-800 text-center max-w-3xl mx-auto my-12 leading-relaxed" data-en={studentLifeArticle.data.lead} data-si={studentLifeArticle.data.lead_si}>
        {studentLifeArticle.data.lead}
      </blockquote>

      <!-- Article Sections -->
      <article class="prose prose-stone max-w-4xl mx-auto mb-20">
        <div class="text-lg text-stone-700 leading-relaxed space-y-6 text-justify">
          {studentLifeArticle.data.sections.map(section => (
            <div class="mb-8">
              <h2 class="text-2xl font-bold font-serif text-stone-900 border-b border-stone-200 pb-3 mt-10 mb-4" data-en={section.heading} data-si={section.heading_si}>
                {section.heading}
              </h2>
              <p data-en={section.body} data-si={section.body_si}>
                {section.body}
              </p>
            </div>
          ))}
        </div>
      </article>

      <!-- Photo Gallery -->
      {galleryPage.photos && galleryPage.photos.length > 0 && (
        <section class="mb-20 pt-16 border-t border-stone-200" aria-labelledby="gallery-heading">
          <h2 id="gallery-heading" class="text-3xl font-bold font-serif text-stone-900 mb-8" data-en={galleryPage.gallery_heading!.en} data-si={galleryPage.gallery_heading!.si}>{galleryPage.gallery_heading!.en}</h2>
          <ul class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 list-none p-0 m-0">
            {galleryPage.photos.map((photo, index) => (
              <li class={`m-0 ${index % 5 === 0 ? 'md:col-span-2 md:row-span-2' : ''}`}>
                <figure class="m-0 group flex flex-col h-full">
                  <div class="overflow-hidden rounded-3xl bg-stone-100 flex-grow">
                    <img
                      src={photo.src}
                      alt={photo.alt.en}
                      data-alt-en={photo.alt.en}
                      data-alt-si={photo.alt.si}
                      width={photo.width}
                      height={photo.height}
                      loading="lazy"
                      decoding="async"
                      class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-700 ease-out"
                    />
                  </div>
                  <figcaption class="px-2 py-3 text-sm text-stone-500 font-medium" data-en={photo.caption.en} data-si={photo.caption.si}>{photo.caption.en}</figcaption>
                </figure>
              </li>
            ))}
          </ul>
        </section>
      )}

        <div class="mt-16 pt-12 border-t border-stone-200/50">
          <HouseCalculator />
        </div>

    </div>
  </main>
  
  <Footer />
</BaseLayout>
