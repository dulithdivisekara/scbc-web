---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import HouseCalculator from '../components/common/HouseCalculator.astro';
import { getEntry } from 'astro:content';

const studentLifeArticle = await getEntry('articles', 'student-life');
---

<BaseLayout title="Student Life">
  <Header />
  
  <main class="flex-grow py-12 sm:py-16 bg-school-surface">
    <div class="container mx-auto px-4 max-w-4xl">
      <div class="text-center mb-10 sm:mb-12">
        <h1 data-i18n="student_life.title" class="text-3xl sm:text-4xl font-serif font-bold text-school-textPrimary">Student Life & Co-Curricular Excellence</h1>
        <div class="w-16 h-1 bg-school-orange mx-auto mt-4 mb-4"></div>
      </div>
      
      <!-- Article Lead / Pull Quote -->
      <blockquote class="text-xl sm:text-2xl font-serif italic text-slate-800 text-center max-w-3xl mx-auto my-8 leading-relaxed" data-en={studentLifeArticle.data.lead} data-si={studentLifeArticle.data.lead_si}>
        {studentLifeArticle.data.lead}
      </blockquote>

      <!-- Article Sections -->
      <article class="prose prose-slate max-w-4xl mx-auto mb-16">
        <div class="text-lg text-slate-700 leading-relaxed space-y-5 text-justify">
          {studentLifeArticle.data.sections.map(section => (
            <div>
              <h2 class="text-2xl font-bold font-serif text-slate-900 border-b border-slate-200 pb-3 mt-10 mb-4" data-en={section.heading} data-si={section.heading_si}>
                {section.heading}
              </h2>
              <p data-en={section.body} data-si={section.body_si}>
                {section.body}
              </p>
            </div>
          ))}
        </div>
      </article>

        <div class="mt-12">
          <HouseCalculator />
        </div>

    </div>
  </main>
  
  <Footer />
</BaseLayout>
