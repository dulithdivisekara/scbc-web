---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import { Users, BookOpen, Globe2, Bell, Sparkles, Trophy, ArrowRight } from 'lucide-react';
import { getCollection } from 'astro:content';

const announcements = await getCollection('announcements');
const latestAnnouncements = announcements
  .sort((a, b) => {
    // Pinned notices first, then newest by date
    if (a.data.pinned && !b.data.pinned) return -1;
    if (!a.data.pinned && b.data.pinned) return 1;
    return new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf();
  })
  .slice(0, 3);
---

<BaseLayout title="Home">
  <Header />
  
  <main class="flex-grow">
    <!-- Hero Section -->
    <section class="relative bg-stone-950 text-white py-32 lg:py-48 overflow-hidden">
      <!-- Background Image -->
      <div class="absolute inset-0">
        <img 
          src="/assets/campus/campus-main-building.jpg" 
          alt="Sri Chandananda Buddhist College Campus" 
          width="1920" 
          height="1080" 
          class="w-full h-full object-cover object-center" 
        />
      </div>
      
      <!-- Solid Dark & Gradient Overlays for Guaranteed WCAG AA Contrast -->
      <div class="absolute inset-0 bg-black/60"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-stone-950/95 via-stone-900/80 to-stone-900/40"></div>
      
      <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-400/20 border border-amber-400/40 text-amber-300 text-xs md:text-sm font-semibold uppercase tracking-wider mb-6">
            <Sparkles size={14} />
            <span>Asgiriya, Kandy • Established 2006</span>
          </div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-serif font-bold leading-tight mb-6 text-white drop-shadow-sm">
            Welcome to Sri Chandananda Buddhist College
          </h1>
          <p class="text-lg md:text-xl font-light mb-10 text-stone-200 max-w-2xl leading-relaxed">
            Empowering the next generation through wisdom, discipline, and Buddhist philosophy since 2006.
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="/about" class="bg-accent text-primary px-8 py-3.5 rounded-lg font-bold hover:bg-yellow-400 transition-all shadow-lg hover:shadow-xl hover:-translate-y-0.5 inline-flex items-center gap-2">
              Discover Our History
              <ArrowRight size={18} />
            </a>
            <a href="/admissions" class="bg-white/10 backdrop-blur-md border border-white/30 text-white px-8 py-3.5 rounded-lg font-semibold hover:bg-white/20 transition-all shadow-lg">
              Admissions Info
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Quick Stats -->
    <section class="py-12 bg-white shadow-lg border border-gray-100 relative z-20 -mt-10 mx-4 md:mx-auto md:max-w-5xl rounded-2xl">
      <div class="container mx-auto px-6">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center divide-y md:divide-y-0 md:divide-x divide-gray-200">
          <div class="flex flex-col items-center py-4">
            <div class="p-3 bg-primary/10 rounded-full text-primary mb-3">
              <Users size={32} />
            </div>
            <span class="text-4xl font-bold text-gray-900 mb-1">3,500+</span>
            <span class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Proud Students</span>
          </div>
          <div class="flex flex-col items-center py-4">
            <div class="p-3 bg-primary/10 rounded-full text-primary mb-3">
              <BookOpen size={32} />
            </div>
            <span class="text-4xl font-bold text-gray-900 mb-1">1 - 13</span>
            <span class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Grades Offered</span>
          </div>
          <div class="flex flex-col items-center py-4">
            <div class="p-3 bg-primary/10 rounded-full text-primary mb-3">
              <Globe2 size={32} />
            </div>
            <span class="text-4xl font-bold text-gray-900 mb-1">Bilingual</span>
            <span class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Sinhala & English Mediums</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Official Notices & Circulars (Right below Quick Stats) -->
    <section class="py-16 bg-surface">
      <div class="container mx-auto px-4 max-w-5xl">
        <div class="flex justify-between items-end mb-8">
          <div>
            <div class="flex items-center gap-2.5 text-accent font-semibold text-sm uppercase tracking-wider mb-1">
              <Bell size={18} />
              <span>Stay Updated</span>
            </div>
            <h2 class="text-3xl font-serif font-bold text-primary">Official Notices & Circulars</h2>
          </div>
          <a href="/admissions" class="text-primary hover:text-accent font-semibold text-sm inline-flex items-center gap-1 transition-colors">
            View all notices & circulars
            <ArrowRight size={16} />
          </a>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {latestAnnouncements.map((notice) => (
            <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition-all relative flex flex-col justify-between group">
              <div>
                <div class="flex justify-between items-center mb-3">
                  <span class="text-xs font-bold uppercase tracking-wider text-primary bg-primary/10 px-2.5 py-1 rounded">
                    {notice.data.category}
                  </span>
                  {notice.data.pinned && (
                    <span class="bg-accent text-primary text-xs font-extrabold px-2.5 py-0.5 rounded-full shadow-sm">
                      Pinned
                    </span>
                  )}
                </div>
                <p class="text-xs text-gray-400 font-medium mb-2">
                  {new Date(notice.data.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                </p>
                <h3 class="text-lg font-bold text-gray-900 mb-2 group-hover:text-primary transition-colors leading-snug">
                  {notice.data.title}
                </h3>
                <p class="text-gray-600 text-sm line-clamp-3 leading-relaxed mb-4">
                  {notice.data.summary}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Leadership Spotlight -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="text-center mb-16">
          <h2 class="text-3xl font-serif font-bold text-primary mb-4">Our Leadership</h2>
          <div class="w-24 h-1 bg-accent mx-auto"></div>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 max-w-4xl mx-auto">
          <!-- Founder -->
          <div class="bg-surface rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition-shadow group border border-gray-100">
            <div class="aspect-[4/3] overflow-hidden bg-stone-100">
              <img src="/assets/leadership/founder.jpg" alt="Most Ven. Dr. Godagama Mangala Thero" width="800" height="600" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            </div>
            <div class="p-8 text-center border-t-4 border-primary bg-white">
              <h3 class="text-xl font-bold text-gray-900 mb-1 font-serif">Most Ven. Dr. Godagama Mangala Thero</h3>
              <p class="text-accent font-semibold uppercase text-xs tracking-wider">Executive Director & Founder</p>
            </div>
          </div>
          
          <!-- Principal -->
          <div class="bg-surface rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition-shadow group border border-gray-100">
            <div class="aspect-[4/3] overflow-hidden bg-stone-100">
              <img src="/assets/leadership/principal.jpg" alt="Ven. Godagama Dhammakiththi Thero" width="800" height="600" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            </div>
            <div class="p-8 text-center border-t-4 border-primary bg-white">
              <h3 class="text-xl font-bold text-gray-900 mb-1 font-serif">Ven. Godagama Dhammakiththi Thero</h3>
              <p class="text-accent font-semibold uppercase text-xs tracking-wider">Principal</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Student Life Highlights Section (Moved Cultural Dance & Inter-House Sports) -->
    <section class="py-20 bg-surface">
      <div class="container mx-auto px-4 max-w-5xl">
        <div class="text-center mb-16">
          <h2 class="text-3xl font-serif font-bold text-primary mb-4">Student Life Highlights</h2>
          <div class="w-24 h-1 bg-accent mx-auto mb-6"></div>
          <p class="text-gray-600 max-w-2xl mx-auto">
            Fostering holistic development through traditional Buddhist culture, vibrant performing arts, and spirited athletics.
          </p>
        </div>

        <!-- Highlights Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
          <!-- Cultural Dance & Buddhist Traditions Card -->
          <div class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow border border-gray-100 group">
            <div class="aspect-[16/10] overflow-hidden bg-stone-900">
              <img 
                src="/assets/activities/buddhist-culture.jpg" 
                alt="Traditional Kandyan Ves Dance and Cultural Celebrations at SCBC" 
                width="800" 
                height="500" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
              />
            </div>
            <div class="p-8">
              <span class="text-xs font-bold uppercase tracking-wider text-accent bg-amber-50 px-2.5 py-1 rounded mb-3 inline-block">Cultural & Buddhist Heritage</span>
              <h3 class="text-xl font-bold font-serif text-gray-900 mb-2">Traditional Performing Arts & Dance</h3>
              <p class="text-gray-600 text-sm leading-relaxed mb-4">
                Students actively engage in traditional Kandyan Ves dance, pirith chanting ceremonies, and Vesak pageants, preserving age-old cultural wisdom and discipline.
              </p>
              <a href="/student-life" class="text-primary hover:text-accent font-semibold text-sm inline-flex items-center gap-1.5 transition-colors">
                Explore school culture <ArrowRight size={14} />
              </a>
            </div>
          </div>

          <!-- Athletics & Sports Card -->
          <div class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow border border-gray-100 group">
            <div class="aspect-[16/10] overflow-hidden bg-stone-900">
              <img 
                src="/assets/activities/inter-house-meet.jpg" 
                alt="Annual Inter-House Sports Meet at Sri Chandananda Buddhist College" 
                width="800" 
                height="500" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
              />
            </div>
            <div class="p-8">
              <span class="text-xs font-bold uppercase tracking-wider text-primary bg-primary/10 px-2.5 py-1 rounded mb-3 inline-block">Athletics & Team Spirit</span>
              <h3 class="text-xl font-bold font-serif text-gray-900 mb-2">Inter-House Sports Meet</h3>
              <p class="text-gray-600 text-sm leading-relaxed mb-4">
                An energetic annual tradition celebrating physical endurance, teamwork, and healthy competition across track and field events.
              </p>
              <a href="/student-life" class="text-primary hover:text-accent font-semibold text-sm inline-flex items-center gap-1.5 transition-colors">
                View sports & activities <ArrowRight size={14} />
              </a>
            </div>
          </div>
        </div>

        <!-- Inter-house System Preview -->
        <div class="bg-white p-8 md:p-10 rounded-2xl shadow-sm border border-gray-100">
          <div class="text-center mb-8">
            <div class="inline-flex items-center gap-2 text-primary font-semibold text-sm uppercase tracking-wider mb-2">
              <Trophy size={18} />
              <span>Inter-House System</span>
            </div>
            <h3 class="text-2xl font-serif font-bold text-gray-900">Three Esteemed Houses</h3>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="p-6 rounded-xl border border-gray-100 bg-surface text-center relative overflow-hidden group hover:border-red-200 transition-colors">
              <div class="absolute top-0 left-0 w-full h-1.5 bg-red-500"></div>
              <h4 class="text-2xl font-serif font-bold text-gray-800 mb-1 mt-2 group-hover:text-red-600 transition-colors">Ramya</h4>
              <p class="text-xs text-gray-500 font-medium uppercase tracking-wider">House</p>
            </div>
            
            <div class="p-6 rounded-xl border border-gray-100 bg-surface text-center relative overflow-hidden group hover:border-blue-200 transition-colors">
              <div class="absolute top-0 left-0 w-full h-1.5 bg-blue-500"></div>
              <h4 class="text-2xl font-serif font-bold text-gray-800 mb-1 mt-2 group-hover:text-blue-600 transition-colors">Suramya</h4>
              <p class="text-xs text-gray-500 font-medium uppercase tracking-wider">House</p>
            </div>
            
            <div class="p-6 rounded-xl border border-gray-100 bg-surface text-center relative overflow-hidden group hover:border-green-200 transition-colors">
              <div class="absolute top-0 left-0 w-full h-1.5 bg-green-500"></div>
              <h4 class="text-2xl font-serif font-bold text-gray-800 mb-1 mt-2 group-hover:text-green-600 transition-colors">Subha</h4>
              <p class="text-xs text-gray-500 font-medium uppercase tracking-wider">House</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</BaseLayout>
