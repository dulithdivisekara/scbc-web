---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import HouseCalculator from '../components/common/HouseCalculator.astro';
import { Users, BookOpen, Globe2, Bell, Trophy, Shield, Flame, ArrowRight } from 'lucide-react';
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';

const announcements = await getCollection('announcements');
const latestAnnouncements = announcements
  .sort((a, b) => {
    if (a.data.pinned && !b.data.pinned) return -1;
    if (!a.data.pinned && b.data.pinned) return 1;
    return new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf();
  })
  .slice(0, 3);

const leadership = await getCollection('leadership');
const sortedLeadership = leadership.sort((a, b) => a.data.order - b.data.order);

function getLeaderImage(imagePath: string, fallbackPath?: string) {
  try {
    const localFile = path.join(process.cwd(), 'public', imagePath);
    if (fs.existsSync(localFile)) {
      return imagePath;
    }
  } catch (e) {}
  return fallbackPath || '/assets/leadership/founder.jpg';
}
---

<BaseLayout title="Home">
  <Header />
  
  <main class="flex-grow bg-[#FCFCFC]">
    <section class="min-h-[520px] sm:min-h-[580px] lg:min-h-[640px] relative flex items-center overflow-hidden">
      <img 
        src="/assets/campus/campus-main-building.jpg" 
        alt="Sri Chandananda Buddhist College Campus Grounds" 
        class="object-cover object-center w-full h-full absolute inset-0"
        width="1920" 
        height="1080"
        loading="eager"
      />

      <div class="absolute inset-0 bg-gradient-to-r from-slate-950/90 via-slate-950/70 to-slate-900/40"></div>
      
      <div class="container mx-auto px-4 relative z-10 py-24 md:py-32">
        <div class="max-w-4xl">
          <h1 data-i18n="home.hero_title" class="text-4xl sm:text-5xl md:text-6xl lg:text-[5rem] font-serif font-bold leading-[1.05] mb-6 text-white drop-shadow-sm tracking-tight">
            Welcome to Sri Chandananda Buddhist College
          </h1>

          <p data-i18n="home.hero_sub" class="text-lg sm:text-xl font-light mb-10 text-stone-200 max-w-2xl leading-relaxed">
            Empowering the next generation through wisdom, discipline, and Buddhist philosophy since 2006.
          </p>

          <div class="flex flex-col sm:flex-row gap-3 w-full sm:w-auto">
            <a 
              href="/about" 
              class="w-full sm:w-auto justify-center bg-school-orange text-white hover:opacity-95 font-medium shadow-lg px-6 py-3 rounded-lg inline-flex items-center gap-2 transition hover:-translate-y-0.5 text-center"
            >
              <span data-i18n="home.btn_about">Discover Our History</span>
              <ArrowRight size={18} />
            </a>

            <a 
              href="/admissions" 
              class="w-full sm:w-auto justify-center border border-white/40 text-white hover:bg-white/10 backdrop-blur-sm px-6 py-3 rounded-lg font-medium transition inline-flex items-center hover:-translate-y-0.5 text-center"
            >
              <span data-i18n="home.btn_admissions">Admissions Info</span>
            </a>
          </div>
        </div>
      </div>

    </section>

    <section class="reveal-up py-16 sm:py-24">
      <div class="container mx-auto px-4 max-w-6xl">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
          <div class="max-w-2xl">
            <h2 data-i18n="home.announcements_title" class="text-3xl sm:text-4xl font-serif font-bold text-stone-900 tracking-tight mb-4">Latest Circulars & Announcements</h2>
          </div>
          <a href="/admissions" class="text-stone-900 hover:text-stone-500 font-medium text-sm inline-flex items-center gap-2 transition-colors border-b border-stone-900 pb-0.5 mb-2">
            <span data-i18n="home.view_circulars">View all circulars</span> <ArrowRight size={16} />
          </a>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {latestAnnouncements.map((notice) => (
            <div class="group block cursor-pointer">
                <div class="pt-6 border-t border-stone-200 group-hover:border-stone-900 transition-colors duration-300">
                  <div class="flex justify-between items-center mb-4">
                    {notice.data.category === 'Religious' ? (
                      <span class="text-[11px] font-bold uppercase tracking-wider text-stone-500" data-en={notice.data.category} data-si={notice.data.category_si || notice.data.category}>
                        {notice.data.category}
                      </span>
                    ) : notice.data.category === 'Sports' ? (
                      <span class="text-[11px] font-bold uppercase tracking-wider text-stone-500" data-en={notice.data.category} data-si={notice.data.category_si || notice.data.category}>
                        {notice.data.category}
                      </span>
                    ) : (
                      <span class="text-[11px] font-bold uppercase tracking-wider text-stone-500" data-en={notice.data.category} data-si={notice.data.category_si || notice.data.category}>
                        {notice.data.category}
                      </span>
                    )}

                    {notice.data.pinned && (
                      <span data-i18n="home.pinned" class="text-stone-900 text-[11px] font-bold flex items-center gap-1">
                        <span class="w-1.5 h-1.5 rounded-full bg-stone-900 block"></span> Pinned
                      </span>
                    )}
                  </div>
                  
                  <h3 class="text-xl sm:text-2xl font-serif text-stone-900 group-hover:opacity-70 transition-opacity leading-snug mb-3" data-en={notice.data.title} data-si={notice.data.title_si || notice.data.title}>
                    {notice.data.title}
                  </h3>
                  
                  <p class="text-stone-500 text-sm line-clamp-3 leading-relaxed mb-4" data-en={notice.data.summary} data-si={notice.data.summary_si || notice.data.summary}>
                    {notice.data.summary}
                  </p>
                  
                  <p class="text-xs text-stone-400 font-medium">
                    {new Date(notice.data.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                  </p>
                </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="reveal-up py-16 sm:py-24 border-t border-stone-200">
      <div class="container mx-auto px-4 max-w-6xl">
        <div class="mb-14 sm:mb-20 max-w-2xl">
          <h2 data-i18n="home.leadership_title" class="text-3xl sm:text-5xl font-serif font-bold text-stone-900 tracking-tight mb-4">Our Leadership</h2>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-10 sm:gap-16">
          {sortedLeadership.map(leader => (
            <div class="group flex flex-col">
              <div class="overflow-hidden rounded-3xl mb-8">
                <img 
                  src={getLeaderImage(leader.data.image, leader.data.fallbackImage)} 
                  alt={leader.data.name} 
                  width="600" 
                  height="800" 
                  class="aspect-[4/5] w-full object-cover object-top group-hover:scale-[1.03] transition-transform duration-700 ease-out" 
                  style="object-position: 50% 15%;"
                  onerror={`this.onerror=null;this.src='${leader.data.fallbackImage || '/assets/leadership/founder.jpg'}';`}
                />
              </div>
              <div class="flex flex-col">
                <p class="text-[11px] font-bold uppercase tracking-wider text-stone-500 mb-2">
                  {leader.data.title}
                </p>
                <h3 class="text-2xl sm:text-3xl font-serif font-bold text-stone-900 leading-snug mb-4">
                  {leader.data.name}
                </h3>
                <p class="text-stone-500 text-sm leading-relaxed max-w-md">
                  {leader.data.bio}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="reveal-up py-16 sm:py-24 bg-stone-100/50">
      <div class="container mx-auto px-4 max-w-6xl">
        <div class="mb-14 sm:mb-20 max-w-2xl">
          <span class="text-[11px] font-bold uppercase tracking-wider text-stone-500 mb-3 inline-block" data-en="STUDENT LIFE" data-si="ශිෂ්‍ය ජීවිතය">Student Life</span>
          <h2 data-i18n="home.holistic_title" class="text-3xl sm:text-5xl font-serif font-bold text-stone-900 tracking-tight mb-6">Holistic Development</h2>
          <p data-i18n="home.holistic_sub" class="text-stone-600 text-lg sm:text-xl font-light leading-relaxed"> Fostering holistic growth through traditional Buddhist culture, vibrant performing arts, and spirited athletics.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 mb-16 sm:mb-24">
          <div class="md:col-span-7 group cursor-pointer">
            <div class="aspect-[4/3] sm:aspect-[16/10] overflow-hidden rounded-3xl bg-stone-200 mb-6">
              <img 
                src="/assets/activities/activities-kandyan-dance-group.jpg" 
                alt="Traditional Kandyan Ves Dance and Cultural Celebrations at SCBC" 
                width="800" 
                height="500" 
                class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-700 ease-out" 
              />
            </div>
            <div>
              <h3 data-i18n="home.card_culture_title" class="text-2xl sm:text-3xl font-bold font-serif text-stone-900 mb-3 group-hover:opacity-70 transition-opacity">Traditional Performing Arts &amp; Dance</h3>
              <p data-i18n="home.card_culture_desc" class="text-stone-500 text-base leading-relaxed mb-5 max-w-lg"> Students actively engage in traditional Kandyan Ves dance, pirith chanting ceremonies, and Vesak pageants, preserving age-old cultural wisdom and discipline.
              </p>
              <a href="/student-life" class="text-stone-900 font-medium text-sm inline-flex items-center gap-2 border-b border-stone-900 pb-0.5">
                <span data-i18n="home.card_culture_link">Explore school culture</span> <ArrowRight size={16} />
              </a>
            </div>
          </div>

          <div class="md:col-span-5 md:pt-24 group cursor-pointer">
            <div class="aspect-[4/5] overflow-hidden rounded-3xl bg-stone-200 mb-6">
              <img 
                src="/assets/activities/activities-sports-meet-band.jpg" 
                alt="Annual Inter-House Sports Meet at Sri Chandananda Buddhist College" 
                width="600" 
                height="750" 
                class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-700 ease-out" 
              />
            </div>
            <div>
              <h3 data-i18n="home.card_sports_title" class="text-2xl font-bold font-serif text-stone-900 mb-3 group-hover:opacity-70 transition-opacity">Inter-House Sports Meet</h3>
              <p data-i18n="home.card_sports_desc" class="text-stone-500 text-sm leading-relaxed mb-5"> An energetic annual tradition celebrating physical endurance, teamwork, and healthy competition across track and field events.
              </p>
              <a href="/student-life" class="text-stone-900 font-medium text-sm inline-flex items-center gap-2 border-b border-stone-900 pb-0.5">
                <span data-i18n="home.card_sports_link">View sports &amp; activities</span> <ArrowRight size={16} />
              </a>
            </div>
          </div>
        </div>

        <div class="reveal-up pt-16 border-t border-stone-200">
          <div class="max-w-3xl mb-12">
            <h3 data-i18n="home.houses_title" class="text-3xl sm:text-4xl font-serif font-bold text-stone-900 mb-4 tracking-tight">Three Esteemed Houses</h3>
            <p data-i18n="home.houses_sub" class="text-stone-500 text-lg leading-relaxed"> Fostering inter-house sports meet rivalries, camaraderie, and house pride across athletics, academics, and cultural contests.
            </p>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="border-t border-stone-200 pt-6 group">
              <h4 class="text-2xl font-serif font-bold text-stone-900 mb-3" data-i18n="home.house_ramya_name">Ramya House</h4>
              <p data-i18n="home.house_ramya_desc" class="text-sm text-stone-500 leading-relaxed"> Embodying foundational Buddhist discipline, academic devotion, and respect for college heritage during inter-house championships and sports meets.
              </p>
            </div>
            
            <div class="border-t border-stone-200 pt-6 group">
              <h4 class="text-2xl font-serif font-bold text-stone-900 mb-3" data-i18n="home.house_suramya_name">Suramya House</h4>
              <p data-i18n="home.house_suramya_desc" class="text-sm text-stone-500 leading-relaxed"> Fostering intellectual sharpness, ethical governance, and strategic team leadership in competitive co-curricular challenges and debates.
              </p>
            </div>
            
            <div class="border-t border-stone-200 pt-6 group">
              <h4 class="text-2xl font-serif font-bold text-stone-900 mb-3" data-i18n="home.house_subha_name">Subha House</h4>
              <p data-i18n="home.house_subha_desc" class="text-sm text-stone-500 leading-relaxed"> Channeling vibrant energy, track and field excellence, and tenacious athletic spirit into annual inter-house competitions and team triumphs.
              </p>
            </div>
          </div>

          <div class="mt-16 pt-12 border-t border-stone-200/50">
            <HouseCalculator />
          </div>
        </div>

      </div>
    </section>
  </main>
  
  <Footer />
</BaseLayout>
