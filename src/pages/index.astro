---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import HouseCalculator from '../components/common/HouseCalculator.astro';
import { Users, BookOpen, Globe2, Bell, Trophy, Shield, Flame, ArrowRight, Clock, DownloadCloud, Compass, CheckCircle2 } from 'lucide-react';
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';

const announcements = await getCollection('announcements');
const latestAnnouncements = announcements
  .sort((a, b) => {
    if (a.data.pinned && !b.data.pinned) return -1;
    if (!a.data.pinned && b.data.pinned) return 1;
    return new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf();
  })
  .slice(0, 3);

const leadership = await getCollection('leadership');
const sortedLeadership = leadership.sort((a, b) => a.data.order - b.data.order);

function getLeaderImage(imagePath: string, fallbackPath?: string) {
  try {
    const localFile = path.join(process.cwd(), 'public', imagePath);
    if (fs.existsSync(localFile)) {
      return imagePath;
    }
  } catch (e) {}
  return fallbackPath || '/assets/leadership/founder.jpg';
}
---

<BaseLayout 
  title="Sri Chandananda Buddhist College | Asgiriya, Kandy"
  description="Sri Chandananda Buddhist College is a prestigious national school in Asgiriya, Kandy. Nurturing wisdom, moral discipline, and Buddhist values across Grades 1–13 bilingual education."
>
  <Header />
  
  <main class="flex-grow bg-[#FCFCFC] overflow-x-hidden">
    <!-- 1. Cinematic GSAP Hero Section -->
    <section class="hero-section min-h-[580px] sm:min-h-[660px] lg:min-h-[720px] relative flex items-center overflow-hidden">
      <img 
        src="/assets/campus/campus-main-building.jpg" 
        alt="Sri Chandananda Buddhist College Campus Grounds in Asgiriya, Kandy" 
        class="gsap-parallax-bg object-cover object-center w-full h-[125%] absolute -top-[12%] inset-0 pointer-events-none will-change-transform"
        width="1920" 
        height="1080"
        loading="eager"
      />

      <div class="absolute inset-0 bg-gradient-to-r from-stone-950/95 via-stone-950/80 to-stone-900/40"></div>
      
      <div class="container mx-auto px-4 relative z-10 py-20 sm:py-28 md:py-36">
        <div class="max-w-4xl">
          <!-- Institutional Provenance Eyebrow -->
          <div class="gsap-hero-crest inline-flex items-center gap-2 text-amber-300/90 font-mono text-xs uppercase tracking-[0.2em] mb-6">
            <span data-en="Asgiriya, Kandy • Founded 2006" data-si="අස්ගිරිය, මහනුවර • ආරම්භය 2006">
              Asgiriya, Kandy • Founded 2006
            </span>
          </div>

          <!-- Kinetic Hero Title -->
          <h1 data-i18n="home.hero_title" class="gsap-hero-title text-4xl sm:text-6xl md:text-7xl font-serif font-bold leading-[1.05] mb-6 text-white drop-shadow-sm tracking-tight">
            Welcome to Sri Chandananda Buddhist College
          </h1>

          <!-- Kinetic Subtitle -->
          <p data-i18n="home.hero_sub" class="gsap-hero-sub text-base sm:text-xl md:text-2xl font-light mb-8 sm:mb-10 text-stone-200 max-w-2xl leading-relaxed">
            Nurturing intellect, moral discipline, and Buddhist values in the sacred hill capital of Kandy.
          </p>

          <!-- Staggered CTA Buttons (Primary: Open Admissions per requirement) -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 w-full sm:w-auto">
            <a 
              href="/admissions" 
              class="gsap-hero-btn w-full sm:w-auto justify-center bg-white text-stone-900 hover:bg-stone-100 font-semibold px-7 py-3.5 rounded-full inline-flex items-center gap-2 transition hover:-translate-y-0.5 text-center text-sm shadow-md min-h-[48px]"
            >
              <span data-en="Open Admissions" data-si="නවක සිසුන් ඇතුළත් කරගැනීම">Open Admissions</span>
              <ArrowRight size={16} />
            </a>

            <a 
              href="/about" 
              class="gsap-hero-btn w-full sm:w-auto justify-center bg-white/10 hover:bg-white/20 text-white border border-white/25 backdrop-blur-sm font-semibold px-7 py-3.5 rounded-full inline-flex items-center gap-2 transition hover:-translate-y-0.5 text-center text-sm shadow-md min-h-[48px]"
            >
              <span data-i18n="home.btn_about">Discover Our History</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. Prestige Counter Reel Band -->
    <section class="bg-stone-900 text-white py-12 border-b border-stone-800">
      <div class="container mx-auto px-4 max-w-6xl">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 sm:gap-8 text-center">
          <div class="space-y-1">
            <div class="text-3xl sm:text-5xl font-serif font-bold text-amber-400 font-mono tabular-nums">
              <span class="gsap-counter" data-target="2640" data-suffix="+">2,640+</span>
            </div>
            <p class="text-xs sm:text-sm text-stone-400 font-medium uppercase tracking-wider" data-en="Students Enrolled" data-si="ශිෂ්‍ය ප්‍රජාව">
              Students Enrolled
            </p>
          </div>

          <div class="space-y-1">
            <div class="text-3xl sm:text-5xl font-serif font-bold text-white font-mono tabular-nums">
              <span class="gsap-counter" data-target="98" data-suffix=".4%">98.4%</span>
            </div>
            <p class="text-xs sm:text-sm text-stone-400 font-medium uppercase tracking-wider" data-en="O/L Academic Pass Rate" data-si="සා/පෙළ විශිෂ්ට සාමාර්ථ">
              O/L Academic Pass Rate
            </p>
          </div>

          <div class="space-y-1">
            <div class="text-3xl sm:text-5xl font-serif font-bold text-amber-400 font-mono tabular-nums">
              <span class="gsap-counter" data-target="13" data-suffix="">13</span>
            </div>
            <p class="text-xs sm:text-sm text-stone-400 font-medium uppercase tracking-wider" data-en="Grades (1 to 13)" data-si="1 සිට 13 දක්වා ශ්‍රේණි">
              Grades (1 to 13)
            </p>
          </div>

          <div class="space-y-1">
            <div class="text-3xl sm:text-5xl font-serif font-bold text-white font-mono tabular-nums">
              <span class="gsap-counter" data-target="20" data-suffix="+">20+</span>
            </div>
            <p class="text-xs sm:text-sm text-stone-400 font-medium uppercase tracking-wider" data-en="Years of Monastic Legacy" data-si="අභිමානවත් වසර ගණන">
              Years of Monastic Legacy
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 2.5. Core Institutional Values Section -->
    <section class="py-14 sm:py-20 bg-white border-b border-stone-200/80">
      <div class="container mx-auto px-4 max-w-6xl">
        <div class="max-w-2xl mb-12">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-[#581838]/5 border border-[#581838]/15 text-[#581838] text-[11px] font-mono font-semibold uppercase tracking-widest mb-3">
            <span data-i18n="home.values_kicker">Foundational Ethos</span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-serif font-bold text-stone-900 tracking-tight" data-i18n="home.values_title">
            Our Core Institutional Values
          </h2>
          <p class="text-stone-600 text-sm sm:text-base mt-2.5 leading-relaxed" data-i18n="home.values_sub">
            Rooted in Theravada Buddhist ethics and modern intellectual rigour, our four foundational pillars guide every scholar through their collegiate journey.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <!-- Value 1: Wisdom -->
          <div class="p-6 rounded-xl bg-stone-50/70 border border-stone-200/90 hover:border-stone-400 hover:shadow-xs transition-all flex flex-col justify-between">
            <div>
              <div class="flex items-baseline justify-between mb-4">
                <span class="font-mono text-xs font-bold text-amber-700 tracking-widest" data-i18n="home.value1_num">01</span>
                <span class="text-xs font-semibold text-stone-400 uppercase tracking-wider" data-i18n="home.value1_pali">ප්‍රඥාව • Paññā</span>
              </div>
              <h3 class="text-xl font-serif font-bold text-stone-900 mb-1" data-i18n="home.value1_title">
                Wisdom
              </h3>
              <p class="text-xs font-medium text-stone-500 mb-3" data-i18n="home.value1_sub">
                Intellectual Inquiry &amp; Bilingual Mastery
              </p>
              <p class="text-xs sm:text-sm text-stone-600 leading-relaxed" data-i18n="home.value1_desc">
                Fostering analytical thinking, scientific inquiry, and dual-medium literacy from Primary foundation through G.C.E. Advanced Level.
              </p>
            </div>
            <div class="pt-4 mt-4 border-t border-stone-200/60 flex items-center justify-between text-[11px] font-mono text-stone-400">
              <span>Grades 1–13</span>
              <span class="w-1.5 h-1.5 rounded-full bg-[#007A87]"></span>
            </div>
          </div>

          <!-- Value 2: Discipline -->
          <div class="p-6 rounded-xl bg-stone-50/70 border border-stone-200/90 hover:border-stone-400 hover:shadow-xs transition-all flex flex-col justify-between">
            <div>
              <div class="flex items-baseline justify-between mb-4">
                <span class="font-mono text-xs font-bold text-amber-700 tracking-widest" data-i18n="home.value2_num">02</span>
                <span class="text-xs font-semibold text-stone-400 uppercase tracking-wider" data-i18n="home.value2_pali">විනය • Sīla</span>
              </div>
              <h3 class="text-xl font-serif font-bold text-stone-900 mb-1" data-i18n="home.value2_title">
                Discipline
              </h3>
              <p class="text-xs font-medium text-stone-500 mb-3" data-i18n="home.value2_sub">
                Theravada Ethics &amp; Character
              </p>
              <p class="text-xs sm:text-sm text-stone-600 leading-relaxed" data-i18n="home.value2_desc">
                Instilling mindful self-restraint, respect for elders, moral uprightness, and composure rooted in daily Buddhist observance.
              </p>
            </div>
            <div class="pt-4 mt-4 border-t border-stone-200/60 flex items-center justify-between text-[11px] font-mono text-stone-400">
              <span>Monastic Ethos</span>
              <span class="w-1.5 h-1.5 rounded-full bg-[#581838]"></span>
            </div>
          </div>

          <!-- Value 3: Heritage -->
          <div class="p-6 rounded-xl bg-stone-50/70 border border-stone-200/90 hover:border-stone-400 hover:shadow-xs transition-all flex flex-col justify-between">
            <div>
              <div class="flex items-baseline justify-between mb-4">
                <span class="font-mono text-xs font-bold text-amber-700 tracking-widest" data-i18n="home.value3_num">03</span>
                <span class="text-xs font-semibold text-stone-400 uppercase tracking-wider" data-i18n="home.value3_pali">සංස්කෘතිය • Cāritta</span>
              </div>
              <h3 class="text-xl font-serif font-bold text-stone-900 mb-1" data-i18n="home.value3_title">
                Heritage
              </h3>
              <p class="text-xs font-medium text-stone-500 mb-3" data-i18n="home.value3_sub">
                Traditional Arts &amp; Monastic Ties
              </p>
              <p class="text-xs sm:text-sm text-stone-600 leading-relaxed" data-i18n="home.value3_desc">
                Preserving Kandyan Ves dance traditions, pirith chanting ceremonies, and living cultural heritage in the sacred hill capital of Asgiriya.
              </p>
            </div>
            <div class="pt-4 mt-4 border-t border-stone-200/60 flex items-center justify-between text-[11px] font-mono text-stone-400">
              <span>Asgiriya, Kandy</span>
              <span class="w-1.5 h-1.5 rounded-full bg-[#F58220]"></span>
            </div>
          </div>

          <!-- Value 4: Excellence -->
          <div class="p-6 rounded-xl bg-stone-50/70 border border-stone-200/90 hover:border-stone-400 hover:shadow-xs transition-all flex flex-col justify-between">
            <div>
              <div class="flex items-baseline justify-between mb-4">
                <span class="font-mono text-xs font-bold text-amber-700 tracking-widest" data-i18n="home.value4_num">04</span>
                <span class="text-xs font-semibold text-stone-400 uppercase tracking-wider" data-i18n="home.value4_pali">විශිෂ්ටත්වය • Viriya</span>
              </div>
              <h3 class="text-xl font-serif font-bold text-stone-900 mb-1" data-i18n="home.value4_title">
                Excellence
              </h3>
              <p class="text-xs font-medium text-stone-500 mb-3" data-i18n="home.value4_sub">
                Tenacity &amp; Leadership
              </p>
              <p class="text-xs sm:text-sm text-stone-600 leading-relaxed" data-i18n="home.value4_desc">
                Striving for physical and academic triumph through spirited inter-house sports meets, track and field mastery, and team brotherhood.
              </p>
            </div>
            <div class="pt-4 mt-4 border-t border-stone-200/60 flex items-center justify-between text-[11px] font-mono text-stone-400">
              <span>Athletics &amp; Teams</span>
              <span class="w-1.5 h-1.5 rounded-full bg-[#007A87]"></span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. Academic Portals & Interactive Resources -->
    <section class="py-14 sm:py-20 bg-stone-50 border-b border-stone-200/80">
      <div class="container mx-auto px-4 max-w-6xl">
        <div class="mb-10 max-w-2xl">
          <h2 class="text-2xl sm:text-4xl font-serif font-bold text-stone-900 tracking-tight" data-en="Academic Portals & Digital Vault" data-si="අධ්‍යයන ද්වාර සහ සම්පත් සංචිතය">
            Academic Portals &amp; Digital Vault
          </h2>
          <p class="text-stone-500 text-sm sm:text-base mt-2 leading-relaxed" data-en="Direct collegiate access to term archives, syllabus modules, bell schedules, and house verification." data-si="වාර විභාග ප්‍රශ්න පත්‍ර, විෂය නිර්දේශ, දෛනික සීනු කාලසටහන් සහ නිවාස තොරතුරු සඳහා සෘජු ප්‍රවේශය.">
            Direct collegiate access to term archives, syllabus modules, bell schedules, and house verification.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 items-stretch">
          <!-- Main Feature: Academic Vault with Real Classroom Photo (Span 7) -->
          <div class="lg:col-span-7 rounded-3xl border border-stone-200/80 bg-white overflow-hidden flex flex-col justify-between shadow-xs hover:border-[#581838]/40 transition-all group">
            <div class="relative h-56 sm:h-64 overflow-hidden bg-stone-900">
              <img 
                src="/assets/gallery/classroom.webp" 
                alt="Sri Chandananda Buddhist College Academic Learning Environment" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 opacity-90"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-stone-950 via-stone-950/40 to-transparent"></div>
              <div class="absolute bottom-4 left-6 right-6 flex items-center justify-between text-white">
                <span class="font-mono text-xs uppercase tracking-widest text-amber-300" data-en="National Curriculum & Term Papers" data-si="ජාතික විෂය නිර්දේශ සහ වාර ප්‍රශ්න පත්‍ර">
                  National Curriculum &amp; Term Papers
                </span>
                <span class="font-mono text-xs text-stone-300">Grades 6-13</span>
              </div>
            </div>

            <div class="p-6 sm:p-8 flex flex-col justify-between flex-grow">
              <div class="mb-6">
                <h3 class="text-xl sm:text-2xl font-serif font-bold text-stone-900 mb-2 group-hover:text-[#581838] transition-colors" data-en="Academic Past Paper Vault" data-si="පසුගිය ප්‍රශ්න පත්‍ර සහ විෂය සංචිතය">
                  Academic Past Paper Vault
                </h3>
                <p class="text-stone-600 text-xs sm:text-sm leading-relaxed" data-en="Complete searchable archives of G.C.E. O/L and A/L model papers, school term evaluations, and official marking schemes for all academic streams." data-si="සාමාන්‍ය පෙළ සහ උසස් පෙළ ආදර්ශ ප්‍රශ්න පත්‍ර, වාර විභාග පත්‍ර සහ නිල ලකුණු දීමේ පටිපාටි සහිත විද්‍යාලයීය විෂය සංචිතය.">
                  Complete searchable archives of G.C.E. O/L and A/L model papers, school term evaluations, and official marking schemes for all academic streams.
                </p>
              </div>

              <div>
                <a 
                  href="/academics/resources" 
                  class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-stone-900 hover:bg-[#581838] text-white text-xs sm:text-sm font-medium transition-colors"
                >
                  <span data-en="Enter Academic Vault" data-si="සංචිතයට පිවිසෙන්න">Enter Academic Vault</span>
                  <ArrowRight size={15} />
                </a>
              </div>
            </div>
          </div>

          <!-- Secondary Stack: Timetables and House Portal (Span 5) -->
          <div class="lg:col-span-5 flex flex-col gap-6">
            <!-- Timetables Panel -->
            <a 
              href="/timetables" 
              class="rounded-3xl border border-stone-200/80 bg-white p-6 sm:p-7 flex flex-col justify-between shadow-xs hover:border-[#581838]/40 transition-all group flex-1"
            >
              <div>
                <div class="flex items-center justify-between mb-3">
                  <span class="font-mono text-[11px] uppercase tracking-wider text-stone-500" data-en="Daily Schedules" data-si="දෛනික කාලසටහන">Daily Schedules</span>
                  <span class="text-xs font-mono font-bold text-[#581838] bg-rose-50 px-2.5 py-0.5 rounded-md border border-rose-100">07:50 - 13:30</span>
                </div>
                <h3 class="text-lg sm:text-xl font-serif font-bold text-stone-900 group-hover:text-[#581838] transition-colors mb-2" data-en="Timetables & Bell Schedule" data-si="පන්ති කාලසටහන සහ සීනු වේලාවන්">
                  Timetables &amp; Bell Schedule
                </h3>
                <p class="text-stone-600 text-xs sm:text-sm leading-relaxed mb-4" data-en="Live 8-period tracker, division schedules across Grades 1 to 13, and printable desk routines." data-si="සජීවී කාලච්ඡේද 8 ක සටහන, 1-13 ශ්‍රේණි පන්ති කාලසටහන් සහ මුද්‍රණය කළ හැකි පිටපත්.">
                  Live 8-period tracker, division schedules across Grades 1 to 13, and printable desk routines.
                </p>
              </div>
              <div class="inline-flex items-center gap-1.5 text-xs font-bold text-[#581838] group-hover:gap-2.5 transition-all pt-2 border-t border-stone-100">
                <span data-en="View Daily Schedules" data-si="කාලසටහන බලන්න">View Daily Schedules</span>
                <ArrowRight size={14} />
              </div>
            </a>

            <!-- House Allegiance Panel -->
            <a 
              href="/student-life" 
              class="rounded-3xl border border-stone-200/80 bg-white p-6 sm:p-7 flex flex-col justify-between shadow-xs hover:border-[#581838]/40 transition-all group flex-1"
            >
              <div>
                <div class="flex items-center justify-between mb-3">
                  <span class="font-mono text-[11px] uppercase tracking-wider text-stone-500" data-en="Tri-House System" data-si="තුන් නිවාස පද්ධතිය">Tri-House System</span>
                  <div class="flex items-center gap-1.5">
                    <span class="w-2.5 h-2.5 rounded-sm bg-[#007A87]" title="Ramya (Teal)"></span>
                    <span class="w-2.5 h-2.5 rounded-sm bg-[#F58220]" title="Suramya (Gold)"></span>
                    <span class="w-2.5 h-2.5 rounded-sm bg-[#581838]" title="Subha (Maroon)"></span>
                  </div>
                </div>
                <h3 class="text-lg sm:text-xl font-serif font-bold text-stone-900 group-hover:text-[#581838] transition-colors mb-2" data-en="House Portal & Allegiance" data-si="නිවාස පද්ධතිය සහ තොරතුරු">
                  House Portal &amp; Allegiance
                </h3>
