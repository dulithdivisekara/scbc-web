        <div class="mb-8 sm:mb-14 max-w-2xl">
          <h2 data-i18n="home.leadership_title" class="text-3xl sm:text-5xl font-serif font-bold text-stone-900 tracking-tight mb-3 sm:mb-4">
            Our Monastic &amp; Academic Leadership
          </h2>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 sm:gap-16">
          {sortedLeadership.map(leader => (
            <div class="gsap-reveal-batch group flex flex-col">
              <div class="overflow-hidden rounded-3xl mb-5 sm:mb-8 bg-stone-100 shadow-xs">
                <img 
                  src={getLeaderImage(leader.data.image, leader.data.fallbackImage)} 
                  alt={leader.data.name} 
                  width="600" 
                  height="800" 
                  class="aspect-[4/5] w-full object-cover object-top group-hover:scale-[1.03] transition-transform duration-700 ease-out" 
                  style="object-position: 50% 15%;"
                  onerror={`this.onerror=null;this.src='${leader.data.fallbackImage || '/assets/leadership/founder.jpg'}';`}
                />
              </div>
              <div class="flex flex-col">
                <p class="text-[11px] font-bold uppercase tracking-wider text-stone-500 mb-2">
                  {leader.data.title}
                </p>
                <h3 class="text-2xl sm:text-3xl font-serif font-bold text-stone-900 leading-snug mb-3">
                  {leader.data.name}
                </h3>
                <p class="text-stone-500 text-sm leading-relaxed max-w-md">
                  {leader.data.bio}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 7. Holistic Development & Cultural Arts -->
