            <div class="aspect-[4/3] sm:aspect-[16/10] overflow-hidden rounded-3xl bg-stone-200 mb-5 shadow-xs">
              <img 
                src="/assets/activities/activities-kandyan-dance-group.jpg" 
                alt="Traditional Kandyan Ves Dance and Cultural Celebrations at SCBC" 
                width="800" 
                height="500" 
                class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-700 ease-out" 
              />
            </div>
            <div>
              <h3 data-i18n="home.card_culture_title" class="text-2xl sm:text-3xl font-bold font-serif text-stone-900 mb-2 group-hover:opacity-70 transition-opacity">Traditional Performing Arts &amp; Dance</h3>
              <p data-i18n="home.card_culture_desc" class="text-stone-500 text-sm sm:text-base leading-relaxed mb-4 max-w-lg"> Students actively engage in traditional Kandyan Ves dance, pirith chanting ceremonies, and Vesak pageants, preserving age-old cultural wisdom and discipline.
              </p>
              <a href="/student-life" class="text-stone-900 font-medium text-sm inline-flex items-center gap-2 border-b border-stone-900 pb-0.5">
                <span data-i18n="home.card_culture_link">Explore school culture</span> <ArrowRight size={16} />
              </a>
            </div>
          </div>

          <div class="md:col-span-5 group cursor-pointer">
            <div class="aspect-[4/5] overflow-hidden rounded-3xl bg-stone-200 mb-5 shadow-xs">
              <img 
                src="/assets/activities/activities-sports-meet-band.jpg" 
                alt="Annual Inter-House Sports Meet at Sri Chandananda Buddhist College" 
                width="600" 
                height="750" 
                class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-700 ease-out" 
              />
            </div>
            <div>
              <h3 data-i18n="home.card_sports_title" class="text-2xl font-bold font-serif text-stone-900 mb-2 group-hover:opacity-70 transition-opacity">Inter-House Sports Meet</h3>
              <p data-i18n="home.card_sports_desc" class="text-stone-500 text-sm leading-relaxed mb-4"> An energetic annual tradition celebrating physical endurance, teamwork, and healthy competition across track and field events.
              </p>
              <a href="/student-life" class="text-stone-900 font-medium text-sm inline-flex items-center gap-2 border-b border-stone-900 pb-0.5">
                <span data-i18n="home.card_sports_link">View sports &amp; activities</span> <ArrowRight size={16} />
              </a>
            </div>
          </div>
        </div>

        <!-- House System Highlight & Calculator -->
        <div class="pt-16 border-t border-stone-200">
          <HouseCalculator />
        </div>

      </div>
    </section>
  </main>
  
  <Footer />
