---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import { Users, BookOpen, Globe2, Bell, Trophy, ArrowRight } from 'lucide-react';
import { getCollection } from 'astro:content';

const announcements = await getCollection('announcements');
const latestAnnouncements = announcements
  .sort((a, b) => {
    if (a.data.pinned && !b.data.pinned) return -1;
    if (!a.data.pinned && b.data.pinned) return 1;
    return new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf();
  })
  .slice(0, 3);
---

<BaseLayout title="Home">
  <Header />
  
  <main class="flex-grow bg-[#F8FAFC]">
    <!-- 1. Full-Bleed Immersive Collegiate Hero -->
    <section class="min-h-[580px] lg:min-h-[640px] relative flex items-center overflow-hidden">
      <!-- Full Cover Campus Photo -->
      <img 
        src="/assets/campus/campus-main-building.jpg" 
        alt="Sri Chandananda Buddhist College Campus Grounds" 
        class="object-cover object-center w-full h-full absolute inset-0"
        width="1920" 
        height="1080"
        loading="eager"
      />

      <!-- Deep Cinematic Gradient Scrim Overlay for Uncompromised Contrast -->
      <div class="absolute inset-0 bg-gradient-to-r from-slate-950/90 via-slate-950/70 to-slate-900/40"></div>
      
      <!-- Hero Content -->
      <div class="container mx-auto px-4 relative z-10 py-20 lg:py-24">
        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-amber-300 text-xs md:text-sm font-semibold uppercase tracking-wider mb-6">
            <span class="w-2 h-2 rounded-full bg-school-orange"></span>
            <span>Asgiriya, Kandy • Established 2006</span>
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-serif font-bold leading-tight mb-6 text-white drop-shadow-sm">
            Welcome to Sri Chandananda Buddhist College
          </h1>

          <p class="text-lg md:text-xl font-light mb-10 text-slate-200 max-w-2xl leading-relaxed">
            Empowering the next generation through wisdom, discipline, and Buddhist philosophy since 2006.
          </p>

          <div class="flex flex-wrap gap-4 items-center">
            <!-- Primary Saffron Gold/Orange Button -->
            <a 
              href="/about" 
              class="bg-school-orange text-white hover:opacity-95 font-medium shadow-lg px-6 py-3 rounded-lg inline-flex items-center gap-2 transition hover:-translate-y-0.5"
            >
              Discover Our History
              <ArrowRight size={18} />
            </a>

            <!-- Secondary Frosted Glass Outline Button -->
            <a 
              href="/admissions" 
              class="border border-white/40 text-white hover:bg-white/10 backdrop-blur-sm px-6 py-3 rounded-lg font-medium transition inline-flex items-center hover:-translate-y-0.5"
            >
              Admissions Info
            </a>
          </div>
        </div>
      </div>

      <!-- Bottom Edge Smooth Divider into Content Sections -->
      <div class="absolute bottom-0 left-0 right-0 h-10 md:h-14 overflow-hidden pointer-events-none z-20">
        <svg viewBox="0 0 1200 120" preserveAspectRatio="none" class="relative block w-full h-full text-[#F8FAFC] fill-current">
          <path d="M0,0 C300,80 900,80 1200,0 L1200,120 L0,120 Z"></path>
        </svg>
      </div>
    </section>

    <!-- 2. Quick Stats Section (Pure White Cards) -->
    <section class="relative z-30 -mt-8 md:-mt-10 px-4">
      <div class="container mx-auto max-w-5xl">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          
          <div class="bg-white border border-slate-200 shadow-sm hover:shadow-md transition rounded-xl p-6 text-center flex flex-col items-center">
            <div class="p-3 bg-teal-50 border border-teal-100 rounded-full text-school-teal mb-3">
              <Users size={28} />
            </div>
            <span class="text-3xl font-bold text-school-textPrimary mb-1">3,500+</span>
            <span class="text-xs font-semibold text-school-textMuted uppercase tracking-wider">Proud Students</span>
          </div>

          <div class="bg-white border border-slate-200 shadow-sm hover:shadow-md transition rounded-xl p-6 text-center flex flex-col items-center">
            <div class="p-3 bg-orange-50 border border-orange-100 rounded-full text-school-orange mb-3">
              <BookOpen size={28} />
            </div>
            <span class="text-3xl font-bold text-school-textPrimary mb-1">1 - 13</span>
            <span class="text-xs font-semibold text-school-textMuted uppercase tracking-wider">Grades Offered</span>
          </div>

          <div class="bg-white border border-slate-200 shadow-sm hover:shadow-md transition rounded-xl p-6 text-center flex flex-col items-center">
            <div class="p-3 bg-purple-50 border border-purple-100 rounded-full text-school-maroon mb-3">
              <Globe2 size={28} />
            </div>
            <span class="text-3xl font-bold text-school-textPrimary mb-1">Bilingual</span>
            <span class="text-xs font-semibold text-school-textMuted uppercase tracking-wider">Sinhala & English Mediums</span>
          </div>

        </div>
      </div>
    </section>

    <!-- 3. Official Notices & Circulars (Pure White Cards on #F8FAFC) -->
    <section class="py-16">
      <div class="container mx-auto px-4 max-w-5xl">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
          <div>
            <div class="flex items-center gap-2 text-school-teal font-semibold text-xs uppercase tracking-wider mb-1">
              <Bell size={16} />
              <span>Official Announcements</span>
            </div>
            <h2 class="text-3xl font-serif font-bold text-school-textPrimary">Official Notices & Circulars</h2>
          </div>
          <a href="/admissions" class="text-school-maroon hover:text-school-orange font-semibold text-sm inline-flex items-center gap-1 transition-colors">
            View all circulars
            <ArrowRight size={16} />
          </a>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {latestAnnouncements.map((notice) => (
            <div class="bg-white border border-slate-200 shadow-sm hover:shadow-md transition rounded-xl p-6 relative flex flex-col justify-between group">
              <div>
                <div class="flex justify-between items-center mb-3">
                  {notice.data.category === 'Religious' ? (
                    <span class="text-xs font-bold uppercase tracking-wider bg-orange-50 text-school-orange border border-orange-200 px-2.5 py-1 rounded">
                      {notice.data.category}
                    </span>
                  ) : notice.data.category === 'Sports' ? (
                    <span class="text-xs font-bold uppercase tracking-wider bg-purple-50 text-school-maroon border border-purple-200 px-2.5 py-1 rounded">
                      {notice.data.category}
                    </span>
                  ) : (
                    <span class="text-xs font-bold uppercase tracking-wider bg-teal-50 text-school-teal border border-teal-200 px-2.5 py-1 rounded">
                      {notice.data.category}
                    </span>
                  )}

                  {notice.data.pinned && (
                    <span class="bg-school-orange text-white text-xs font-bold px-2.5 py-0.5 rounded-full shadow-xs">
                      Pinned
                    </span>
                  )}
                </div>
                
                <p class="text-xs text-school-textMuted font-medium mb-2">
                  {new Date(notice.data.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                </p>
                
                <h3 class="text-lg font-bold text-school-textPrimary group-hover:text-school-maroon transition-colors leading-snug mb-2 font-serif">
                  {notice.data.title}
                </h3>
                
                <p class="text-school-textMuted text-sm line-clamp-3 leading-relaxed mb-4">
                  {notice.data.summary}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. Leadership Spotlight (Pure White Cards on #F8FAFC) -->
    <section class="py-16 border-t border-slate-200">
      <div class="container mx-auto px-4">
        <div class="text-center mb-14">
          <span class="text-xs font-bold uppercase tracking-wider text-school-teal mb-2 inline-block">College Governance</span>
          <h2 class="text-3xl font-serif font-bold text-school-textPrimary mb-3">Our Leadership</h2>
          <div class="w-16 h-1 bg-school-orange mx-auto"></div>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
          <!-- Founder -->
          <div class="bg-white border border-slate-200 shadow-sm hover:shadow-md transition rounded-xl overflow-hidden group">
            <div class="aspect-[4/3] overflow-hidden bg-slate-100">
              <img 
                src="/assets/leadership/founder.jpg" 
                alt="Most Ven. Dr. Godagama Mangala Thero" 
                width="800" 
                height="600" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
              />
            </div>
            <div class="p-6 text-center border-t-4 border-school-maroon bg-white">
              <h3 class="text-xl font-bold text-school-textPrimary mb-1 font-serif">Most Ven. Dr. Godagama Mangala Thero</h3>
              <p class="text-school-teal font-semibold uppercase text-xs tracking-wider">Executive Director & Founder</p>
            </div>
          </div>
          
          <!-- Principal -->
          <div class="bg-white border border-slate-200 shadow-sm hover:shadow-md transition rounded-xl overflow-hidden group">
            <div class="aspect-[4/3] overflow-hidden bg-slate-100">
              <img 
                src="/assets/leadership/principal.jpg" 
                alt="Ven. Godagama Dhammakiththi Thero" 
                width="800" 
                height="600" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
              />
            </div>
            <div class="p-6 text-center border-t-4 border-school-maroon bg-white">
              <h3 class="text-xl font-bold text-school-textPrimary mb-1 font-serif">Ven. Godagama Dhammakiththi Thero</h3>
              <p class="text-school-teal font-semibold uppercase text-xs tracking-wider">Principal</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. Student Life Highlights & House System -->
    <section class="py-16 border-t border-slate-200">
      <div class="container mx-auto px-4 max-w-5xl">
        <div class="text-center mb-14">
          <span class="text-xs font-bold uppercase tracking-wider text-school-teal mb-2 inline-block">Student Life</span>
          <h2 class="text-3xl font-serif font-bold text-school-textPrimary mb-3">Holistic Development</h2>
          <div class="w-16 h-1 bg-school-teal mx-auto mb-4"></div>
          <p class="text-school-textMuted max-w-2xl mx-auto text-sm leading-relaxed">
            Fostering holistic growth through traditional Buddhist culture, vibrant performing arts, and spirited athletics.
          </p>
        </div>

        <!-- Highlights Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-14">
          <!-- Cultural Dance & Buddhist Traditions Card -->
          <div class="bg-white border border-slate-200 shadow-sm hover:shadow-md transition rounded-xl overflow-hidden group">
            <div class="aspect-[16/10] overflow-hidden bg-slate-100">
              <img 
                src="/assets/activities/buddhist-culture.jpg" 
                alt="Traditional Kandyan Ves Dance and Cultural Celebrations at SCBC" 
                width="800" 
                height="500" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
              />
            </div>
            <div class="p-6">
              <span class="text-xs font-bold uppercase tracking-wider text-school-teal bg-teal-50 border border-teal-200 px-2.5 py-1 rounded mb-3 inline-block">
                Cultural & Buddhist Heritage
              </span>
              <h3 class="text-xl font-bold font-serif text-school-textPrimary mb-2">Traditional Performing Arts & Dance</h3>
              <p class="text-school-textMuted text-sm leading-relaxed mb-4">
                Students actively engage in traditional Kandyan Ves dance, pirith chanting ceremonies, and Vesak pageants, preserving age-old cultural wisdom and discipline.
              </p>
              <a href="/student-life" class="text-school-maroon hover:text-school-orange font-semibold text-sm inline-flex items-center gap-1.5 transition-colors">
                Explore school culture <ArrowRight size={14} />
              </a>
            </div>
          </div>

          <!-- Athletics & Sports Card -->
          <div class="bg-white border border-slate-200 shadow-sm hover:shadow-md transition rounded-xl overflow-hidden group">
            <div class="aspect-[16/10] overflow-hidden bg-slate-100">
              <img 
                src="/assets/activities/inter-house-meet.jpg" 
                alt="Annual Inter-House Sports Meet at Sri Chandananda Buddhist College" 
                width="800" 
                height="500" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
              />
            </div>
            <div class="p-6">
              <span class="text-xs font-bold uppercase tracking-wider text-school-maroon bg-purple-50 border border-purple-200 px-2.5 py-1 rounded mb-3 inline-block">
                Athletics & Team Spirit
              </span>
              <h3 class="text-xl font-bold font-serif text-school-textPrimary mb-2">Inter-House Sports Meet</h3>
              <p class="text-school-textMuted text-sm leading-relaxed mb-4">
                An energetic annual tradition celebrating physical endurance, teamwork, and healthy competition across track and field events.
              </p>
              <a href="/student-life" class="text-school-maroon hover:text-school-orange font-semibold text-sm inline-flex items-center gap-1.5 transition-colors">
                View sports & activities <ArrowRight size={14} />
              </a>
            </div>
          </div>
        </div>

        <!-- House System (Pure White Cards with Tri-Color Trims) -->
        <div class="p-8 md:p-10 rounded-2xl bg-white border border-slate-200 shadow-sm">
          <div class="text-center mb-8">
            <div class="inline-flex items-center gap-2 text-school-maroon font-semibold text-xs uppercase tracking-wider mb-2">
              <Trophy size={16} />
              <span>Inter-House System</span>
            </div>
            <h3 class="text-2xl font-serif font-bold text-school-textPrimary">Three Esteemed Houses</h3>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Ramya (Deep Maroon Trim) -->
            <div class="bg-white border border-slate-200 rounded-xl p-6 text-center relative overflow-hidden shadow-xs hover:shadow-md transition group border-t-4 border-t-school-maroon">
              <h4 class="text-2xl font-serif font-bold text-school-textPrimary mb-1 mt-1 group-hover:text-school-maroon transition-colors">Ramya</h4>
              <p class="text-xs text-school-textMuted font-medium uppercase tracking-wider">House</p>
            </div>
            
            <!-- Suramya (School Teal Trim) -->
            <div class="bg-white border border-slate-200 rounded-xl p-6 text-center relative overflow-hidden shadow-xs hover:shadow-md transition group border-t-4 border-t-school-teal">
              <h4 class="text-2xl font-serif font-bold text-school-textPrimary mb-1 mt-1 group-hover:text-school-teal transition-colors">Suramya</h4>
              <p class="text-xs text-school-textMuted font-medium uppercase tracking-wider">House</p>
            </div>
            
            <!-- Subha (Saffron Orange Trim) -->
            <div class="bg-white border border-slate-200 rounded-xl p-6 text-center relative overflow-hidden shadow-xs hover:shadow-md transition group border-t-4 border-t-school-orange">
              <h4 class="text-2xl font-serif font-bold text-school-textPrimary mb-1 mt-1 group-hover:text-school-orange transition-colors">Subha</h4>
              <p class="text-xs text-school-textMuted font-medium uppercase tracking-wider">House</p>
            </div>
          </div>
        </div>

      </div>
    </section>
  </main>
  
  <Footer />
</BaseLayout>
