---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import { MapPin, Phone, Mail, Send } from 'lucide-react';
import { getEntry } from 'astro:content';

const page = (await getEntry('pages', 'contact'))!.data;
const { intro, actions, map_note } = page;

// Inquiry routing is configurable per environment (see .env.example).
const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL || 'contact@dulith.me';
const formEndpoint = import.meta.env.PUBLIC_FORM_ENDPOINT || '';

// Obfuscate email for scrapers
const encodedEmail = Buffer.from(contactEmail).toString('base64');
---

<BaseLayout title="Contact Us">
  <Header />
  
  <main class="flex-grow py-16 sm:py-24 bg-[#FCFCFC]">
    <div class="container mx-auto px-4 max-w-5xl">
      <header class="mb-14 sm:mb-20">
        <h1 data-i18n="contact.title" class="text-4xl sm:text-5xl font-serif font-bold text-stone-900 mb-4 tracking-tight">Contact Us</h1>
        <p class="text-stone-500 text-lg max-w-xl leading-relaxed" data-en={intro!.en} data-si={intro!.si}>{intro!.en}</p>
      </header>
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
        <section>
          <h2 data-i18n="contact.get_in_touch" class="text-xl sm:text-2xl font-serif font-bold text-school-textPrimary mb-6">Direct Contacts</h2>
          
          <div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <a 
                href="tel:+94812203162"
                class="bg-stone-50 border border-stone-200/60 hover:bg-stone-100 text-stone-900 p-5 rounded-2xl flex items-center gap-4 transition-colors"
              >
                <Phone size={24} class="shrink-0 text-stone-700" strokeWidth={1.5} />
                <div class="flex flex-col text-left">
                  <span class="text-[11px] text-stone-500 font-bold uppercase tracking-wider mb-1" data-en={actions!.call.en} data-si={actions!.call.si}>{actions!.call.en}</span>
                  <span class="text-base font-semibold text-stone-900 font-sans tracking-tight">+94 81 220 3162</span>
                </div>
              </a>

              <a 
                href="#"
                data-b64-email={encodedEmail}
                class="contact-email-link bg-stone-50 border border-stone-200/60 hover:bg-stone-100 text-stone-900 p-5 rounded-2xl flex items-center gap-4 transition-colors"
              >
                <Mail size={24} class="shrink-0 text-stone-700" strokeWidth={1.5} />
                <div class="flex flex-col text-left">
                  <span class="text-[11px] text-stone-500 font-bold uppercase tracking-wider mb-1" data-en={actions!.email.en} data-si={actions!.email.si}>{actions!.email.en}</span>
                  <span class="text-base font-semibold text-stone-900 font-sans tracking-tight">info@scbck.lk</span>
                </div>
              </a>

              <a 
                href="https://maps.google.com/?q=Sri+Chandananda+Buddhist+College+Kandy"
                target="_blank" rel="noopener noreferrer"
                class="sm:col-span-2 bg-stone-900 hover:bg-stone-800 text-white p-4 rounded-xl flex items-center justify-center gap-2 transition-colors w-full font-medium"
              >
                <MapPin size={18} class="shrink-0 text-stone-300" />
                <span data-en={actions!.map.en} data-si={actions!.map.si}>{actions!.map.en}</span>
              </a>
            </div>

            <!-- Clean Editorial Metadata Grid -->
            <div class="mt-6 pt-6 border-t border-slate-200 space-y-4">
              <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-4">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-500 w-32 shrink-0" data-i18n="contact.address_label">School Address:</span>
                <span class="text-sm font-medium text-slate-800" data-i18n="contact.address_val">Asgiri Vihara Mawatha, Kandy 20000, Sri Lanka</span>
              </div>
              <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-4">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-500 w-32 shrink-0" data-i18n="contact.hours_label">Office Hours:</span>
                <span class="text-sm font-medium text-slate-800" data-i18n="contact.hours_val">Monday – Friday, 7:30 AM – 1:30 PM</span>
              </div>
            </div>
          </div>
        </section>
        
        <section class="bg-stone-50 p-6 sm:p-10 rounded-3xl border border-stone-200/60">
          <h2 data-i18n="contact.send_inquiry" class="text-2xl sm:text-3xl font-serif font-bold text-stone-900 mb-8">Send an Inquiry</h2>
          
          <div id="form-feedback" class="hidden mb-6 p-4 rounded-xl text-sm font-medium" role="alert"></div>

          <form id="contact-form" class="space-y-6" data-endpoint={formEndpoint} data-b64-email={encodedEmail}>
            <div>
              <label for="name" class="block text-[11px] font-bold uppercase tracking-wider text-stone-500 mb-2"><span data-i18n="contact.form_name">Full Name</span> <span class="text-stone-400">*</span></label>
              <input type="text" id="name" required autocomplete="name" class="w-full px-4 py-3 rounded-xl border border-stone-200 bg-white focus:outline-none focus:border-stone-900 focus:ring-1 focus:ring-stone-900 text-stone-900 text-base transition-colors" placeholder="Enter your full name" data-placeholder-en="Enter your full name" data-placeholder-si="ඔබගේ සම්පූර්ණ නම ඇතුළත් කරන්න">
            </div>
            
            <div>
              <label for="email" class="block text-[11px] font-bold uppercase tracking-wider text-stone-500 mb-2"><span data-i18n="contact.form_email">Email Address</span> <span class="text-stone-400">*</span></label>
              <input type="email" id="email" required autocomplete="email" class="w-full px-4 py-3 rounded-xl border border-stone-200 bg-white focus:outline-none focus:border-stone-900 focus:ring-1 focus:ring-stone-900 text-stone-900 text-base transition-colors" placeholder="name@example.com" data-placeholder-en="name@example.com" data-placeholder-si="ඔබගේ විද්‍යුත් තැපැල් ලිපිනය">
            </div>
            
            <div>
              <label for="message" class="block text-[11px] font-bold uppercase tracking-wider text-stone-500 mb-2"><span data-i18n="contact.form_message">Your Message</span> <span class="text-stone-400">*</span></label>
              <textarea id="message" required rows="5" class="w-full px-4 py-3 rounded-xl border border-stone-200 bg-white focus:outline-none focus:border-stone-900 focus:ring-1 focus:ring-stone-900 text-stone-900 text-base transition-colors" placeholder="Please specify your inquiry or message..." data-placeholder-en="Please specify your inquiry or message..." data-placeholder-si="ඔබගේ පණිවිඩය මෙහි සටහන් කරන්න..."></textarea>
            </div>
            
            <button type="submit" class="w-full bg-stone-900 hover:bg-stone-800 text-white font-medium py-4 px-6 rounded-xl transition-colors flex items-center justify-center gap-2 text-base">
              <Send size={18} />
              <span data-i18n="contact.form_submit">Send Inquiry</span>
            </button>
          </form>
        </section>

        <script is:inline>
          document.addEventListener('DOMContentLoaded', () => {
            // Email unobfuscation
            document.querySelectorAll('.contact-email-link').forEach(link => {
              link.addEventListener('click', (e) => {
                e.preventDefault();
                const em = atob(link.getAttribute('data-b64-email'));
                window.location.href = 'mailto:' + em;
              });
            });

            const form = document.getElementById('contact-form');
            const feedbackDiv = document.getElementById('form-feedback');
            if (!form || !feedbackDiv) return;

            const msgs = {
              en: {
                missing: 'Please fill out all required fields (Full Name, Email Address, and Your Message) before submitting.',
                ok: 'Thank you for contacting Sri Chandananda Buddhist College. Your inquiry has been forwarded to the administration desk.',
                fail: 'Sorry, your message could not be sent. Please try again or call the school office.'
              },
              si: {
                missing: 'කරුණාකර අවශ්‍ය සියලු තොරතුරු (නම, විද්‍යුත් තැපැල් ලිපිනය සහ පණිවිඩය) සම්පූර්ණ කරන්න.',
                ok: 'ශ්‍රී චන්දානන්ද බෞද්ධ විද්‍යාලය හා සම්බන්ධ වීම ගැන ස්තූතියි. ඔබගේ පණිවිඩය පරිපාලන කාර්යාලයට යොමු කරන ලදී.',
                fail: 'කණගාටුයි, පණිවිඩය යැවීමට නොහැකි විය. කරුණාකර නැවත උත්සාහ කරන්න හෝ කාර්යාලයට අමතන්න.'
              }
            };
            const t = () => msgs[document.documentElement.lang === 'si' ? 'si' : 'en'];
            const show = (cls, text) => {
              feedbackDiv.className = 'mb-5 p-4 rounded-xl text-sm font-medium border ' + cls;
              feedbackDiv.textContent = text;
            };

            form.addEventListener('submit', async (e) => {
              e.preventDefault();
              const name = form.querySelector('#name').value.trim();
              const email = form.querySelector('#email').value.trim();
              const message = form.querySelector('#message').value.trim();

              if (!name || !email || !message) {
                show('bg-red-50 text-red-800 border-red-200', t().missing);
                return;
              }

              const endpoint = form.dataset.endpoint;
              if (endpoint) {
                try {
                  const res = await fetch(endpoint, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                    body: JSON.stringify({ name, email, message })
                  });
                  if (!res.ok) throw new Error('HTTP ' + res.status);
                } catch (err) {
                  show('bg-red-50 text-red-800 border-red-200', t().fail);
                  return;
                }
              } else {
                // Fallback: open the visitor's mail client
                const subject = encodeURIComponent('[SCBC Web Inquiry] Message from ' + name);
                const body = encodeURIComponent('Name: ' + name + '\nEmail: ' + email + '\n\nMessage:\n' + message);
                const decodedEmail = atob(form.dataset.b64Email);
                window.location.href = 'mailto:' + decodedEmail + '?subject=' + subject + '&body=' + body;
              }

              show('bg-emerald-50 text-emerald-900 border-emerald-200', t().ok);
              form.reset();
            });
          });
        </script>
      </div>

      <section class="mt-12 sm:mt-16">
        <header class="mb-6">
          <h2 class="text-3xl font-bold font-serif text-stone-900 mb-2" data-i18n="contact.map_title">Visit Our School</h2>
          <p class="text-stone-500 text-sm" data-en={map_note!.en} data-si={map_note!.si}>{map_note!.en}</p>
        </header>
        <figure class="rounded-3xl overflow-hidden bg-stone-100 h-72 sm:h-96 w-full m-0 border border-stone-200/60">
          <iframe
            title="Sri Chandananda Buddhist College Campus Map"
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3957.5312338870196!2d80.6288675!3d7.2940608!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3ae3662ef4f1d063%3A0x6b86650965377f06!2sSri%20Chandananda%20Buddhist%20College!5e0!3m2!1sen!2slk!4v1700000000000"
            class="w-full h-full border-0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </figure>
      </section>
    </div>
  </main>
  
  <Footer />
</BaseLayout>
