---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import { MapPin, Phone, Mail, Clock, Send } from 'lucide-react';
---

<BaseLayout title="Contact Us">
  <Header />
  
  <main class="flex-grow py-12 sm:py-16 bg-school-surface">
    <div class="container mx-auto px-4 max-w-5xl">
      <div class="text-center mb-12 sm:mb-16">
        <span class="text-xs font-bold uppercase tracking-wider text-school-teal mb-2 inline-block">Direct Inquiries</span>
        <h1 class="text-3xl sm:text-4xl font-serif font-bold text-school-textPrimary mb-2">Contact Us</h1>
        <div class="w-16 h-1 bg-school-orange mx-auto mt-4 mb-4"></div>
        <p class="text-school-textMuted max-w-xl mx-auto text-sm sm:text-base">We are here to answer your questions and welcome you to our school community.</p>
      </div>
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
        <!-- Contact Information -->
        <div>
          <h2 class="text-xl sm:text-2xl font-serif font-bold text-school-textPrimary mb-6">Get in Touch</h2>
          
          <div class="space-y-5">
            <div class="flex items-start gap-4 bg-white p-5 rounded-xl border border-school-border shadow-xs">
              <div class="bg-teal-50 border border-teal-100 p-3 rounded-lg text-school-teal shrink-0">
                <MapPin size={22} />
              </div>
              <div>
                <h3 class="font-bold text-school-textPrimary text-base mb-1 font-serif">Campus Address</h3>
                <p class="text-school-textMuted text-sm leading-relaxed">Asgiri Vihara Mawatha,<br/>Kandy 20000, Sri Lanka</p>
              </div>
            </div>
            
            <div class="flex items-start gap-4 bg-white p-5 rounded-xl border border-school-border shadow-xs">
              <div class="bg-orange-50 border border-orange-100 p-3 rounded-lg text-school-orange shrink-0">
                <Phone size={22} />
              </div>
              <div>
                <h3 class="font-bold text-school-textPrimary text-base mb-1 font-serif">Phone</h3>
                <p class="text-school-textMuted text-sm">+94 81 220 3162</p>
              </div>
            </div>

            <div class="flex items-start gap-4 bg-white p-5 rounded-xl border border-school-border shadow-xs">
              <div class="bg-purple-50 border border-purple-100 p-3 rounded-lg text-school-maroon shrink-0">
                <Mail size={22} />
              </div>
              <div>
                <h3 class="font-bold text-school-textPrimary text-base mb-1 font-serif">Email</h3>
                <p class="text-school-textMuted text-sm">info@scbck.lk</p>
              </div>
            </div>
            
            <div class="flex items-start gap-4 bg-white p-5 rounded-xl border border-school-border shadow-xs">
              <div class="bg-slate-100 border border-slate-200 p-3 rounded-lg text-school-textMuted shrink-0">
                <Clock size={22} />
              </div>
              <div>
                <h3 class="font-bold text-school-textPrimary text-base mb-1 font-serif">Office Hours</h3>
                <p class="text-school-textMuted text-sm leading-relaxed">Monday - Friday<br/>7:30 AM - 1:30 PM</p>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Contact Form -->
        <div class="bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-school-border">
          <h2 class="text-xl sm:text-2xl font-serif font-bold text-school-textPrimary mb-6">Send an Inquiry</h2>
          
          <form class="space-y-5" onsubmit="event.preventDefault();">
            <div>
              <label for="name" class="block text-xs font-semibold uppercase tracking-wider text-school-textMuted mb-2">Full Name</label>
              <input type="text" id="name" autocomplete="name" class="w-full px-4 py-3 rounded-lg border border-school-border focus:outline-none focus:ring-2 focus:ring-school-teal text-school-textPrimary text-sm transition-all" placeholder="Enter your full name">
            </div>
            
            <div>
              <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-school-textMuted mb-2">Email Address</label>
              <input type="email" id="email" autocomplete="email" class="w-full px-4 py-3 rounded-lg border border-school-border focus:outline-none focus:ring-2 focus:ring-school-teal text-school-textPrimary text-sm transition-all" placeholder="name@example.com">
            </div>
            
            <div>
              <label for="message" class="block text-xs font-semibold uppercase tracking-wider text-school-textMuted mb-2">Your Message</label>
              <textarea id="message" rows="4" class="w-full px-4 py-3 rounded-lg border border-school-border focus:outline-none focus:ring-2 focus:ring-school-teal text-school-textPrimary text-sm transition-all" placeholder="Please specify your inquiry or message..."></textarea>
            </div>
            
            <button type="submit" class="w-full bg-school-maroon hover:opacity-90 text-white font-semibold py-3.5 px-6 rounded-lg transition-opacity flex items-center justify-center gap-2 shadow-sm text-sm">
              <Send size={16} />
              Send Inquiry
            </button>
          </form>
        </div>
      </div>

      <!-- Campus Map Location -->
      <div class="mt-12 sm:mt-16">
        <div class="mb-4">
          <span class="text-xs font-bold uppercase tracking-wider text-school-teal mb-1 inline-block">Campus Location</span>
          <h2 class="text-xl sm:text-2xl font-serif font-bold text-school-textPrimary">Find Us in Kandy</h2>
          <p class="text-school-textMuted text-sm">Located on Asgiri Vihara Mawatha, in the historic hill capital of Kandy.</p>
        </div>
        <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-sm h-72 sm:h-96 w-full">
          <iframe
            title="Sri Chandananda Buddhist College Campus Map"
            src="https://maps.google.com/maps?q=Sri+Chandananda+Buddhist+College+Kandy&t=&z=16&ie=UTF8&iwloc=&output=embed"
            class="w-full h-full border-0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>
    </div>
  </main>
  
  <Footer />
</BaseLayout>
