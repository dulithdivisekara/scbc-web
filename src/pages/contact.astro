---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import { MapPin, Phone, Mail, Clock, Send } from 'lucide-react';
---

<BaseLayout title="Contact Us">
  <Header />
  
  <main class="flex-grow py-16 bg-surface">
    <div class="container mx-auto px-4 max-w-5xl">
      <div class="text-center mb-16">
        <h1 class="text-4xl font-serif font-bold text-primary mb-4">Contact Us</h1>
        <p class="text-gray-600">We are here to answer your questions and welcome you to our community.</p>
      </div>
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <!-- Contact Information -->
        <div>
          <h2 class="text-2xl font-serif font-bold text-gray-800 mb-8">Get in Touch</h2>
          
          <div class="space-y-8">
            <div class="flex items-start gap-4">
              <div class="bg-primary/10 p-4 rounded-xl text-primary shrink-0">
                <MapPin size={24} />
              </div>
              <div>
                <h3 class="font-bold text-gray-800 text-lg mb-1">Campus Address</h3>
                <p class="text-gray-600">Asgiri Vihara Mawatha,<br/>Kandy 20000,<br/>Sri Lanka</p>
              </div>
            </div>
            
            <div class="flex items-start gap-4">
              <div class="bg-primary/10 p-4 rounded-xl text-primary shrink-0">
                <Phone size={24} />
              </div>
              <div>
                <h3 class="font-bold text-gray-800 text-lg mb-1">Phone</h3>
                <p class="text-gray-600">+94 81 220 3162</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="bg-primary/10 p-4 rounded-xl text-primary shrink-0">
                <Mail size={24} />
              </div>
              <div>
                <h3 class="font-bold text-gray-800 text-lg mb-1">Email</h3>
                <p class="text-gray-600">info@scbck.lk</p>
              </div>
            </div>
            
            <div class="flex items-start gap-4">
              <div class="bg-primary/10 p-4 rounded-xl text-primary shrink-0">
                <Clock size={24} />
              </div>
              <div>
                <h3 class="font-bold text-gray-800 text-lg mb-1">Office Hours</h3>
                <p class="text-gray-600">Monday - Friday<br/>7:30 AM - 1:30 PM</p>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Contact Form -->
        <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100">
          <h2 class="text-2xl font-serif font-bold text-gray-800 mb-6">Send an Inquiry</h2>
          
          <form class="space-y-6" onsubmit="event.preventDefault();">
            <div>
              <label for="name" class="block text-sm font-semibold text-gray-700 mb-2">Full Name</label>
              <input type="text" id="name" class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all" placeholder="John Doe">
            </div>
            
            <div>
              <label for="email" class="block text-sm font-semibold text-gray-700 mb-2">Email Address</label>
              <input type="email" id="email" class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all" placeholder="john@example.com">
            </div>
            
            <div>
              <label for="message" class="block text-sm font-semibold text-gray-700 mb-2">Your Message</label>
              <textarea id="message" rows="4" class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all" placeholder="How can we help you?"></textarea>
            </div>
            
            <button type="submit" class="w-full bg-primary hover:bg-primary/90 text-white font-bold py-3 px-6 rounded-lg transition-colors flex items-center justify-center gap-2 shadow-md">
              <Send size={18} />
              Send Message
            </button>
          </form>
        </div>
      </div>
    </div>
  </main>
  
  <Footer />
</BaseLayout>
