---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import { MapPin, Phone, Mail, Clock, Send } from 'lucide-react';
---

<BaseLayout title="Contact Us">
  <Header />
  
  <main class="flex-grow py-12 sm:py-16 bg-school-surface">
    <div class="container mx-auto px-4 max-w-5xl">
      <header class="text-center mb-12 sm:mb-16">
        <h1 data-i18n="contact.title" class="text-3xl sm:text-4xl font-serif font-bold text-school-textPrimary mb-2">Contact Us</h1>
        <div class="w-16 h-1 bg-school-orange mx-auto mt-4 mb-4"></div>
        <p class="text-school-textMuted max-w-xl mx-auto text-sm sm:text-base" data-en="We are here to answer your questions and welcome you to our school community." data-si="ඔබගේ සියලු විමසීම් සඳහා සහය වීමට අප සූදානම්.">We are here to answer your questions and welcome you to our school community.</p>
      </header>
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
        <section>
          <h2 data-i18n="contact.get_in_touch" class="text-xl sm:text-2xl font-serif font-bold text-school-textPrimary mb-6">Get in Touch</h2>
          
          <div class="space-y-6">
            <!-- Action Buttons Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <a 
                href="tel:+94812203162"
                class="flex items-center justify-center gap-3 bg-white border border-slate-200 p-4 rounded-xl text-school-textPrimary hover:border-school-teal hover:bg-teal-50/50 hover:text-school-teal transition shadow-sm font-medium"
              >
                <Phone size={18} class="shrink-0" />
                <span data-en="Call Office: +94 81 220 3162" data-si="දුරකථන ඇමතුමක් ලබාගන්න">Call Office: +94 81 220 3162</span>
              </a>

              <a 
                href="mailto:contact@dulith.me"
                class="flex items-center justify-center gap-3 bg-white border border-slate-200 p-4 rounded-xl text-school-textPrimary hover:border-school-orange hover:bg-amber-50/50 hover:text-school-orange transition shadow-sm font-medium"
              >
                <Mail size={18} class="shrink-0" />
                <span data-en="Email: info@scbck.lk" data-si="විද්‍යුත් තැපෑලෙන් විමසන්න">Email: info@scbck.lk</span>
              </a>

              <a 
                href="https://maps.google.com/?q=Sri+Chandananda+Buddhist+College+Kandy"
                target="_blank" rel="noopener noreferrer"
                class="sm:col-span-2 flex items-center justify-center gap-3 bg-white border border-slate-200 p-4 rounded-xl text-school-textPrimary hover:border-school-maroon hover:bg-purple-50/50 hover:text-school-maroon transition shadow-sm font-medium"
              >
                <MapPin size={18} class="shrink-0" />
                <span data-en="Open in Google Maps" data-si="සිතියමෙන් මාර්ගය සොයාගන්න">Open in Google Maps</span>
              </a>
            </div>

            <!-- School Details Summary -->
            <div class="pt-6 border-t border-slate-100">
              <div class="space-y-3">
                <p class="text-sm text-school-textMuted flex items-start gap-3">
                  <span class="font-bold text-school-textPrimary min-w-[100px]" data-en="Physical Address:" data-si="ලිපිනය:">Physical Address:</span>
                  <span data-en="Asgiri Vihara Mawatha, Kandy 20000, Sri Lanka" data-si="අස්ගිරි විහාර මාවත, මහනුවර.">Asgiri Vihara Mawatha, Kandy 20000, Sri Lanka</span>
                </p>
                <p class="text-sm text-school-textMuted flex items-start gap-3">
                  <span class="font-bold text-school-textPrimary min-w-[100px]" data-en="Official Hours:" data-si="කාර්යාල වේලාවන්:">Official Hours:</span>
                  <span data-i18n="contact.hours_value" data-en="Monday - Friday, 7:30 AM - 1:30 PM" data-si="සඳුදා - සිකුරාදා: පෙ.ව. 7:30 - ප.ව. 1:30">Monday - Friday, 7:30 AM - 1:30 PM</span>
                </p>
              </div>
            </div>
          </div>
        </section>
        
        <section class="bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-school-border">
          <h2 data-i18n="contact.send_inquiry" class="text-xl sm:text-2xl font-serif font-bold text-school-textPrimary mb-6">Send an Inquiry</h2>
          
          <div id="form-feedback" class="hidden mb-5 p-4 rounded-xl text-sm font-medium" role="alert"></div>

          <form id="contact-form" class="space-y-5">
            <div>
              <label for="name" class="block text-xs font-semibold uppercase tracking-wider text-school-textMuted mb-2"><span data-i18n="contact.form_name">Full Name</span> <span class="text-red-500">*</span></label>
              <input type="text" id="name" required autocomplete="name" class="w-full px-4 py-3 rounded-lg border border-school-border focus:outline-none focus:ring-2 focus:ring-school-teal text-school-textPrimary text-sm transition-all" placeholder="Enter your full name" data-placeholder-en="Enter your full name" data-placeholder-si="ඔබගේ සම්පූර්ණ නම ඇතුළත් කරන්න">
            </div>
            
            <div>
              <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-school-textMuted mb-2"><span data-i18n="contact.form_email">Email Address</span> <span class="text-red-500">*</span></label>
              <input type="email" id="email" required autocomplete="email" class="w-full px-4 py-3 rounded-lg border border-school-border focus:outline-none focus:ring-2 focus:ring-school-teal text-school-textPrimary text-sm transition-all" placeholder="name@example.com" data-placeholder-en="name@example.com" data-placeholder-si="ඔබගේ විද්‍යුත් තැපැල් ලිපිනය">
            </div>
            
            <div>
              <label for="message" class="block text-xs font-semibold uppercase tracking-wider text-school-textMuted mb-2"><span data-i18n="contact.form_message">Your Message</span> <span class="text-red-500">*</span></label>
              <textarea id="message" required rows="4" class="w-full px-4 py-3 rounded-lg border border-school-border focus:outline-none focus:ring-2 focus:ring-school-teal text-school-textPrimary text-sm transition-all" placeholder="Please specify your inquiry or message..." data-placeholder-en="Please specify your inquiry or message..." data-placeholder-si="ඔබගේ පණිවිඩය මෙහි සටහන් කරන්න..."></textarea>
            </div>
            
            <button type="submit" class="w-full bg-school-maroon hover:opacity-90 text-white font-semibold py-3.5 px-6 rounded-lg transition-opacity flex items-center justify-center gap-2 shadow-sm text-sm">
              <Send size={16} />
              <span data-i18n="contact.form_submit">Send Inquiry</span>
            </button>
          </form>
        </section>

        <script is:inline>
          document.addEventListener('DOMContentLoaded', () => {
            const form = document.getElementById('contact-form');
            const feedbackDiv = document.getElementById('form-feedback');
            const nameInput = document.getElementById('name');
            const emailInput = document.getElementById('email');
            const messageInput = document.getElementById('message');

            if (!form || !feedbackDiv) return;

            form.addEventListener('submit', (e) => {
              e.preventDefault();
              
              const name = nameInput.value.trim();
              const email = emailInput.value.trim();
              const message = messageInput.value.trim();

              if (!name || !email || !message) {
                feedbackDiv.className = 'mb-5 p-4 rounded-xl text-sm font-medium bg-red-50 text-red-800 border border-red-200';
                feedbackDiv.textContent = 'Please fill out all required fields (Full Name, Email Address, and Your Message) before submitting.';
                feedbackDiv.classList.remove('hidden');
                return;
              }

              const subject = encodeURIComponent(`[SCBC Web Inquiry] Message from ${name}`);
              const body = encodeURIComponent(`Name: ${name}\nEmail: ${email}\n\nMessage:\n${message}`);
              window.location.href = `mailto:contact@dulith.me?subject=${subject}&body=${body}`;

              feedbackDiv.className = 'mb-5 p-4 rounded-xl text-sm font-medium bg-emerald-50 text-emerald-900 border border-emerald-200 flex items-center gap-2';
              feedbackDiv.textContent = 'Thank you for contacting Sri Chandananda Buddhist College. Your inquiry has been forwarded to the administration desk.';
              feedbackDiv.classList.remove('hidden');

              form.reset();
            });
          });
        </script>
      </div>

      <section class="mt-12 sm:mt-16">
        <header class="mb-4">
          <h2 class="text-2xl sm:text-3xl font-bold font-serif text-slate-900" data-i18n="contact.map_title">Visit Our School</h2>
          <p class="text-school-textMuted text-sm" data-en="Located on Asgiri Vihara Mawatha, in the historic hill capital of Kandy." data-si="මහනුවර ඓතිහාසික අස්ගිරි විහාර මාවතේ පිහිටා ඇත.">Located on Asgiri Vihara Mawatha, in the historic hill capital of Kandy.</p>
        </header>
        <figure class="rounded-2xl overflow-hidden border border-slate-200 shadow-sm h-72 sm:h-96 w-full m-0">
          <iframe
            title="Sri Chandananda Buddhist College Campus Map"
            src="https://maps.google.com/maps?q=Sri+Chandananda+Buddhist+College+Kandy&t=&z=16&ie=UTF8&iwloc=&output=embed"
            class="w-full h-full border-0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </figure>
      </section>
    </div>
  </main>
  
  <Footer />
</BaseLayout>
