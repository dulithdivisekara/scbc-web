---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import { BookOpen, MonitorPlay, Globe, Microscope, ArrowRight } from 'lucide-react';
import { getEntry } from 'astro:content';

const page = (await getEntry('pages', 'academics'))!.data;
const icons = { BookOpen, MonitorPlay, Globe, Microscope };
const tints = {
  teal: { box: 'bg-teal-50 border-teal-100 text-school-teal' },
  orange: { box: 'bg-orange-50 border-orange-100 text-school-orange' },
  purple: { box: 'bg-purple-50 border-purple-100 text-school-maroon' },
};
---

<BaseLayout title="Academics">
  <Header />
  
  <main class="flex-grow py-10 sm:py-24 bg-[#FCFCFC]">
    <div class="container mx-auto px-4 max-w-4xl">
      <div class="mb-10 sm:mb-16 max-w-2xl">
        <h1 data-i18n="academics.title" class="text-3xl sm:text-5xl font-serif font-bold text-stone-900 tracking-tight mb-3 sm:mb-4">Academic Structure &amp; Curriculum</h1>
        <p class="text-stone-500 text-base sm:text-lg leading-relaxed" data-en={page.intro!.en} data-si={page.intro!.si}>{page.intro!.en}</p>
      </div>

      {page.sections!.map((section) => {
        if (section.layout === 'cards') {
          return (
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 sm:gap-10 mb-12 sm:mb-20">
              {section.items.map((item) => {
                const Icon = icons[item.icon];
                return (
                  <div class="flex flex-col">
                    <div class="flex items-center gap-3 mb-2.5">
                      <div class="text-stone-900 shrink-0 p-2 rounded-xl bg-stone-100">
                        <Icon size={22} strokeWidth={1.75} />
                      </div>
                      <h3 class="text-lg sm:text-xl font-bold text-stone-900 font-serif leading-snug" data-en={item.title.en} data-si={item.title.si}>{item.title.en}</h3>
                    </div>
                    <p class="text-stone-500 text-sm leading-relaxed" data-en={item.body.en} data-si={item.body.si}>{item.body.en}</p>
                  </div>
                );
              })}
            </div>
          );
        }
        return (
          <>
            {section.heading && (
              <div class="mb-8 sm:mb-10 border-t border-stone-200 pt-8 sm:pt-10">
                <h2 class="text-2xl sm:text-3xl font-serif font-bold text-stone-900 tracking-tight" data-en={section.heading.en} data-si={section.heading.si}>{section.heading.en}</h2>
              </div>
            )}
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 sm:gap-16 mb-12 sm:mb-20">
              {section.items.map((item) => {
                const Icon = icons[item.icon];
                return (
                  <div class="flex flex-col">
                    <div class="flex items-center gap-3 mb-2.5">
                      <div class="text-stone-900 shrink-0 p-2 rounded-xl bg-stone-100">
                        <Icon size={22} strokeWidth={1.75} />
                      </div>
                      <h3 class="text-lg sm:text-xl font-bold text-stone-900 font-serif leading-snug" data-en={item.title.en} data-si={item.title.si}>{item.title.en}</h3>
                    </div>
                    <p class="text-stone-500 text-sm leading-relaxed" data-en={item.body.en} data-si={item.body.si}>{item.body.en}</p>
                  </div>
                );
              })}
            </div>
          </>
        );
      })}
      <!-- Interactive Academic Portals Spotlight -->
      <div class="mt-8 pt-10 border-t border-stone-200">
        <h2 class="text-2xl sm:text-3xl font-serif font-bold text-stone-900 tracking-tight mb-6" data-en="Student Academic Tools &amp; Repositories" data-si="ශිෂ්‍ය අධ්‍යයන මෙවලම් සහ එකතු">
          Student Academic Tools &amp; Repositories
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Timetable Card -->
          <a href="/timetables" class="group p-6 sm:p-7 rounded-2xl border border-stone-200 bg-white hover:border-[#581838]/40 hover:shadow-md transition-all flex flex-col justify-between">
            <div>
              <div class="text-[11px] font-mono uppercase tracking-wider text-amber-900 bg-amber-50 border border-amber-200 px-2.5 py-1 rounded inline-block mb-3.5 font-semibold">
                Daily Bell Routine
              </div>
              <h3 class="text-lg sm:text-xl font-serif font-bold text-stone-900 group-hover:text-[#581838] transition-colors mb-2" data-en="Daily Timetables &amp; Bell Schedule" data-si="දෛනික කාලසටහන සහ සීනු කාලවේලාවන්">
                Daily Timetables &amp; Bell Schedule
              </h3>
              <p class="text-xs sm:text-sm text-stone-500 leading-relaxed mb-5" data-en="Live period tracker, grade-wise routine schedules (Grades 1-13), and printable desk timetables." data-si="සජීවී කාලච්ඡේද සටහන, 1-13 ශ්‍රේණි සඳහා පන්ති කාලසටහන් සහ මුද්‍රණය කළ හැකි පිටපත්.">
                Live period tracker, grade-wise routine schedules (Grades 1-13), and printable desk timetables.
              </p>
            </div>
            <div class="inline-flex items-center gap-1.5 text-xs font-bold text-[#581838] group-hover:gap-2.5 transition-all">
              <span data-en="Launch Timetable Explorer" data-si="කාලසටහන බලන්න">Launch Timetable Explorer</span>
              <ArrowRight size={14} />
            </div>
          </a>

          <!-- Past Papers Vault Card -->
          <a href="/academics/resources" class="group p-6 sm:p-7 rounded-2xl border border-stone-200 bg-white hover:border-[#581838]/40 hover:shadow-md transition-all flex flex-col justify-between">
            <div>
              <div class="text-[11px] font-mono uppercase tracking-wider text-stone-700 bg-stone-100 border border-stone-200 px-2.5 py-1 rounded inline-block mb-3.5 font-semibold">
                Examination Repository
              </div>
              <h3 class="text-lg sm:text-xl font-serif font-bold text-stone-900 group-hover:text-[#581838] transition-colors mb-2" data-en="Academic Vault: Past Papers &amp; Syllabi" data-si="පසුගිය ප්‍රශ්න පත්‍ර සහ විෂය නිර්දේශ එකතුව">
                Academic Vault: Past Papers &amp; Syllabi
              </h3>
              <p class="text-xs sm:text-sm text-stone-500 leading-relaxed mb-5" data-en="Searchable repository of term evaluations, national O/L and A/L model papers, and official marking schemes." data-si="වාර විභාග ප්‍රශ්න පත්‍ර, සාමාන්‍ය පෙළ සහ උසස් පෙළ ආදර්ශ පත්‍ර සහ ලකුණු දීමේ පටිපාටි.">
                Searchable repository of term evaluations, national O/L and A/L model papers, and official marking schemes.
              </p>
            </div>
            <div class="inline-flex items-center gap-1.5 text-xs font-bold text-[#581838] group-hover:gap-2.5 transition-all">
              <span data-en="Browse Academic Vault" data-si="ඩිජිටල් එකතුව පිරික්සන්න">Browse Academic Vault</span>
              <ArrowRight size={14} />
            </div>
          </a>
        </div>
      </div>
    </div>
  </main>
  
  <Footer />
</BaseLayout>
