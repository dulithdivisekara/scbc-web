---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import { BookOpen, MonitorPlay, Globe, Microscope } from 'lucide-react';
import { getEntry } from 'astro:content';

const page = (await getEntry('pages', 'academics'))!.data;
const icons = { BookOpen, MonitorPlay, Globe, Microscope };
const tints = {
  teal: { box: 'bg-teal-50 border-teal-100 text-school-teal' },
  orange: { box: 'bg-orange-50 border-orange-100 text-school-orange' },
  purple: { box: 'bg-purple-50 border-purple-100 text-school-maroon' },
};
---

<BaseLayout title="Academics">
  <Header />
  
  <main class="flex-grow py-12 sm:py-16 bg-school-surface">
    <div class="container mx-auto px-4 max-w-4xl">
      <div class="text-center mb-10 sm:mb-12">
        <h1 data-i18n="academics.title" class="text-3xl sm:text-4xl font-serif font-bold text-school-textPrimary">Academic Structure &amp; Curriculum</h1>
        <div class="w-16 h-1 bg-school-orange mx-auto mt-4 mb-4"></div>
        <p class="text-center text-school-textMuted max-w-2xl mx-auto text-sm sm:text-base" data-en={page.intro!.en} data-si={page.intro!.si}>{page.intro!.en}</p>
      </div>

      {page.sections!.map((section) => {
        if (section.layout === 'cards') {
          return (
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-12 sm:mb-16">
              {section.items.map((item) => {
                const Icon = icons[item.icon];
                return (
                  <div class="bg-white p-6 sm:p-8 rounded-xl shadow-sm border border-school-border flex items-start gap-4">
                    <div class={`${tints[item.tint].box} border p-3 rounded-lg shrink-0`}>
                      <Icon size={24} />
                    </div>
                    <div>
                      <h3 class="text-lg font-bold text-school-textPrimary mb-2 font-serif" data-en={item.title.en} data-si={item.title.si}>{item.title.en}</h3>
                      <p class="text-school-textMuted text-sm leading-relaxed" data-en={item.body.en} data-si={item.body.si}>{item.body.en}</p>
                    </div>
                  </div>
                );
              })}
            </div>
          );
        }
        return (
          <>
            {section.heading && (
              <div class="text-center mb-8">
                <h2 class="text-2xl font-serif font-bold text-school-textPrimary" data-en={section.heading.en} data-si={section.heading.si}>{section.heading.en}</h2>
              </div>
            )}
            <div class="bg-white rounded-xl shadow-sm border border-school-border overflow-hidden">
              <div class="grid grid-cols-1 sm:grid-cols-2 divide-y sm:divide-y-0 sm:divide-x divide-school-border">
                {section.items.map((item) => {
                  const Icon = icons[item.icon];
                  return (
                    <div class="p-6 sm:p-8">
                      <div class={`${tints[item.tint].box} border p-3 rounded-lg w-fit mb-4`}>
                        <Icon size={24} />
                      </div>
                      <h3 class="text-lg font-bold text-school-textPrimary mb-2 font-serif" data-en={item.title.en} data-si={item.title.si}>{item.title.en}</h3>
                      <p class="text-school-textMuted text-sm leading-relaxed" data-en={item.body.en} data-si={item.body.si}>{item.body.en}</p>
                    </div>
                  );
                })}
              </div>
            </div>
          </>
        );
      })}
    </div>
  </main>
  
  <Footer />
</BaseLayout>
