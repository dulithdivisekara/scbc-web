---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
---

<BaseLayout title="About Us">
  <Header />
  
  <main class="flex-grow py-16 bg-school-surface">
    <div class="container mx-auto px-4 max-w-4xl">
      <div class="text-center mb-12">
        <span class="text-xs font-bold uppercase tracking-wider text-school-teal mb-2 inline-block">Our Heritage</span>
        <h1 class="text-4xl font-serif font-bold text-school-textPrimary">About the College</h1>
        <div class="w-16 h-1 bg-school-orange mx-auto mt-4"></div>
      </div>
      
      <!-- Vision Section -->
      <section class="mb-12 bg-white p-8 rounded-xl shadow-sm border border-school-border">
        <h2 class="text-2xl font-serif font-bold text-school-textPrimary mb-4 border-b border-school-border pb-2">Our Vision</h2>
        <p class="text-lg text-school-textPrimary italic border-l-4 border-school-orange pl-4 py-2 bg-school-surface/60 rounded-r-lg">
          "To create a healthy generation which faces the challenges of the modern world, practicing the values of Buddhist Philosophy."
        </p>
      </section>

      <!-- History Section -->
      <section class="mb-12">
        <h2 class="text-2xl font-serif font-bold text-school-textPrimary mb-6">Our History</h2>
        <div class="space-y-6 text-school-textMuted leading-relaxed bg-white p-8 rounded-xl shadow-sm border border-school-border">
          <p>
            Sri Chandananda Buddhist College was established on <strong class="text-school-textPrimary">January 4, 2006</strong>. The school was conceptualized and brought to life by our Founder and Executive Director, Most Ven. Dr. Godagama Mangala Thero.
          </p>
          <p>
            It is proudly named in honor of his respected teacher, the Most Ven. Palipana Sri Chandananda Mahanayake Thera, continuing a legacy of educational and spiritual excellence in Kandy.
          </p>
          <div class="bg-orange-50/50 p-5 rounded-lg border border-orange-200 mt-6">
            <h3 class="font-bold text-school-maroon mb-2 flex items-center gap-2">
              <span class="bg-school-orange text-white text-xs px-2.5 py-0.5 rounded-full font-bold">2020</span>
              Expansion Milestone
            </h3>
            <p class="text-sm text-school-textMuted">In 2020, we expanded our vision by opening a dedicated Girls' School section, broadening our impact and commitment to holistic education.</p>
          </div>
        </div>
      </section>

      <!-- Leadership Directory -->
      <section>
        <h2 class="text-2xl font-serif font-bold text-school-textPrimary mb-6">Leadership Directory</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-white p-6 rounded-xl shadow-sm border border-school-border border-t-4 border-t-school-maroon">
            <h3 class="font-bold text-lg mb-1 text-school-textPrimary font-serif">Most Ven. Dr. Godagama Mangala Thero</h3>
            <p class="text-school-teal font-semibold text-xs uppercase tracking-wider">Executive Director & Founder</p>
          </div>
          
          <div class="bg-white p-6 rounded-xl shadow-sm border border-school-border border-t-4 border-t-school-maroon">
            <h3 class="font-bold text-lg mb-1 text-school-textPrimary font-serif">Ven. Godagama Dhammakiththi Thero</h3>
            <p class="text-school-teal font-semibold text-xs uppercase tracking-wider">Principal</p>
          </div>
          
          <div class="bg-white p-6 rounded-xl shadow-sm border border-school-border md:col-span-2 border-t-4 border-t-school-teal">
            <h3 class="font-bold text-lg mb-1 text-school-textPrimary font-serif">Vice Principals</h3>
            <div class="flex flex-col sm:flex-row gap-4 sm:gap-8 mt-2">
              <p class="text-school-textMuted flex items-center gap-2 text-sm">
                <span class="w-2 h-2 rounded-full bg-school-orange"></span>
                Ven. Thulawala Dhammasiddi Thero
              </p>
              <p class="text-school-textMuted flex items-center gap-2 text-sm">
                <span class="w-2 h-2 rounded-full bg-school-orange"></span>
                Mr. J.B. Dassanayaka
              </p>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>
  
  <Footer />
</BaseLayout>
