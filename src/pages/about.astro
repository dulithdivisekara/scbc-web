---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import { getCollection, getEntry } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';

const aboutArticle = await getEntry('articles', 'about-college');
const leadership = await getCollection('leadership');
const sortedLeadership = leadership.sort((a, b) => a.data.order - b.data.order);

function getLeaderImage(imagePath: string, fallbackPath?: string) {
  try {
    const localFile = path.join(process.cwd(), 'public', imagePath);
    if (fs.existsSync(localFile)) {
      return imagePath;
    }
  } catch (e) {}
  return fallbackPath || '/assets/leadership/founder.jpg';
}
---

<BaseLayout title="About Us">
  <Header />
  
  <main class="flex-grow py-12 sm:py-16 bg-school-surface">
    <div class="container mx-auto px-4 max-w-4xl">
      <div class="text-center mb-10 sm:mb-12">
        <span class="text-xs font-bold uppercase tracking-wider text-school-teal mb-2 inline-block" data-en="OUR HERITAGE" data-si="අපගේ උරුමය">Our Heritage</span>
        <h1 data-i18n="about.title" class="text-3xl sm:text-4xl font-serif font-bold text-school-textPrimary">About the College</h1>
        <div class="w-16 h-1 bg-school-orange mx-auto mt-4"></div>
      </div>
      
      <!-- Article Lead / Pull Quote -->
      <blockquote class="border-l-4 border-school-orange pl-6 py-3 my-8 italic font-serif text-xl text-slate-800 bg-amber-50/40 rounded-r-lg" data-en={aboutArticle.data.lead} data-si={aboutArticle.data.lead_si}>
        {aboutArticle.data.lead}
      </blockquote>

      <!-- Article Sections -->
      <article class="prose prose-slate max-w-4xl mx-auto mb-16">
        <div class="text-lg text-slate-700 leading-relaxed space-y-5 text-justify">
          {aboutArticle.data.sections.map(section => (
            <div>
              <h2 class="text-2xl font-bold font-serif text-slate-900 border-b border-slate-200 pb-3 mt-10 mb-4" data-en={section.heading} data-si={section.heading_si}>
                {section.heading}
              </h2>
              <p data-en={section.body} data-si={section.body_si}>
                {section.body}
              </p>
            </div>
          ))}
        </div>
      </article>

      <!-- Leadership Directory -->
      <section>
        <div class="mb-6">
          <h2 data-i18n="about.leadership_directory" class="text-xl sm:text-2xl font-serif font-bold text-school-textPrimary">Leadership Directory</h2>
          <p data-i18n="about.leadership_sub" class="text-school-textMuted text-sm mt-1">Guided by visionary Buddhist leadership and dedicated administrative stewardship.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
          {sortedLeadership.map(leader => (
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden hover:shadow-md transition group flex flex-col">
              <div class="overflow-hidden bg-slate-100 rounded-t-xl">
                <img 
                  src={getLeaderImage(leader.data.image, leader.data.fallbackImage)} 
                  alt={leader.data.name} 
                  width="600" 
                  height="800" 
                  class="aspect-[3/4] w-full object-cover object-top rounded-t-xl group-hover:scale-102 transition-transform duration-500" 
                  style="object-position: 50% 15%;"
                  onerror={`this.onerror=null;this.src='${leader.data.fallbackImage || '/assets/leadership/founder.jpg'}';`}
                />
              </div>
              <div class="p-6 sm:p-7 flex flex-col flex-grow text-center">
                <div class="space-y-1 mb-2">
                  <p class="text-xs font-bold uppercase tracking-wider text-teal-800">
                    {leader.data.title}
                  </p>
                  <h3 class="text-xl font-bold font-serif text-slate-900 leading-snug">
                    {leader.data.name}
                  </h3>
                </div>
                <p class="text-school-textMuted text-sm leading-relaxed mt-auto">
                  {leader.data.bio}
                </p>
              </div>
            </div>
          ))}
        </div>
        
        <!-- Vice Principals -->
        <div class="mt-12">
          <h3 class="font-bold text-xl mb-6 text-slate-900 font-serif border-b border-slate-200 pb-3" data-i18n="about.vice_principals">
            Vice Principals
          </h3>
          <ul class="space-y-4">
            <li class="pb-4 border-b border-slate-100">
              <div class="space-y-1">
                <p data-i18n="about.vp_badge" class="text-xs font-bold uppercase tracking-wider text-teal-800">Vice Principal</p>
                <p class="font-serif font-bold text-slate-900 text-lg">Ven. Thulawala Dhammasiddi Thero</p>
              </div>
            </li>
            <li class="pb-4 border-b border-slate-100">
              <div class="space-y-1">
                <p data-i18n="about.vp_badge" class="text-xs font-bold uppercase tracking-wider text-teal-800">Vice Principal</p>
                <p class="font-serif font-bold text-slate-900 text-lg">Mr. J.B. Dassanayaka</p>
              </div>
            </li>
          </ul>
        </div>
      </section>
    </div>
  </main>
  
  <Footer />
</BaseLayout>
