---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import { getCollection, getEntry } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';

const aboutArticle = await getEntry('articles', 'about-college');
const leadership = await getCollection('leadership');
const sortedLeadership = leadership.sort((a, b) => a.data.order - b.data.order);

function getLeaderImage(imagePath: string, fallbackPath?: string) {
  try {
    const localFile = path.join(process.cwd(), 'public', imagePath);
    if (fs.existsSync(localFile)) {
      return imagePath;
    }
  } catch (e) {}
  return fallbackPath || '/assets/leadership/founder.jpg';
}
---

<BaseLayout title="About Us">
  <Header />
  
  <main class="flex-grow py-16 sm:py-24 bg-[#FCFCFC]">
    <div class="container mx-auto px-4 max-w-4xl">
      <div class="text-center mb-12 sm:mb-16">
        <h1 data-i18n="about.title" class="text-4xl sm:text-5xl font-serif font-bold text-stone-900 tracking-tight">About the College</h1>
      </div>
      
      <!-- Article Lead / Pull Quote -->
      <blockquote class="text-2xl sm:text-3xl font-serif italic text-stone-800 text-center max-w-3xl mx-auto my-12 leading-relaxed" data-en={aboutArticle.data.lead} data-si={aboutArticle.data.lead_si}>
        {aboutArticle.data.lead}
      </blockquote>

      <!-- Article Sections -->
      <article class="prose prose-slate max-w-4xl mx-auto mb-16">
        <div class="text-lg text-slate-700 leading-relaxed space-y-5 text-justify">
          {aboutArticle.data.sections.map(section => (
            <div>
              <h2 class="text-2xl font-bold font-serif text-slate-900 border-b border-slate-200 pb-3 mt-10 mb-4" data-en={section.heading} data-si={section.heading_si}>
                {section.heading}
              </h2>
              <p data-en={section.body} data-si={section.body_si}>
                {section.body}
              </p>
            </div>
          ))}
        </div>
      </article>

      <!-- Leadership Directory -->
      <section class="mt-20 pt-16 border-t border-stone-200">
        <div class="mb-10">
          <h2 data-i18n="about.leadership_directory" class="text-3xl font-serif font-bold text-stone-900 tracking-tight">Leadership Directory</h2>
          <p data-i18n="about.leadership_sub" class="text-stone-500 text-base mt-2">Guided by visionary Buddhist leadership and dedicated administrative stewardship.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-10 mb-16">
          {sortedLeadership.map(leader => (
            <div class="group flex flex-col">
              <div class="overflow-hidden rounded-2xl mb-6 bg-stone-100">
                <img 
                  src={getLeaderImage(leader.data.image, leader.data.fallbackImage)} 
                  alt={leader.data.name} 
                  width="600" 
                  height="800" 
                  class="aspect-[3/4] w-full object-cover object-top group-hover:scale-[1.02] transition-transform duration-700 ease-out" 
                  style="object-position: 50% 15%;"
                  onerror={`this.onerror=null;this.src='${leader.data.fallbackImage || '/assets/leadership/founder.jpg'}';`}
                />
              </div>
              <div class="flex flex-col">
                <div class="space-y-1 mb-3">
                  <p class="text-[11px] font-bold uppercase tracking-wider text-stone-500" data-en={leader.data.title} data-si={leader.data.title_si || leader.data.title}>
                    {leader.data.title}
                  </p>
                  <h3 class="text-2xl font-bold font-serif text-stone-900 leading-snug" data-en={leader.data.name} data-si={leader.data.name_si || leader.data.name}>
                    {leader.data.name}
                  </h3>
                </div>
                <p class="text-stone-500 text-sm leading-relaxed max-w-sm" data-en={leader.data.bio} data-si={leader.data.bio_si || leader.data.bio}>
                  {leader.data.bio}
                </p>
              </div>
            </div>
          ))}
        </div>
        
        <!-- Vice Principals -->
        <div class="mt-16">
          <h3 class="font-bold text-2xl mb-8 text-stone-900 font-serif border-b border-stone-200 pb-4" data-i18n="about.vice_principals">
            Vice Principals
          </h3>
          <ul class="space-y-6">
            <li class="pb-6 border-b border-stone-100">
              <div class="space-y-1">
                <p data-i18n="about.vp_badge" class="text-[11px] font-bold uppercase tracking-wider text-stone-500">Vice Principal</p>
                <p class="font-serif font-bold text-stone-900 text-xl" data-en="Ven. Thulawala Dhammasiddhi Thero" data-si="පූජ්‍ය තුලාවල ධම්මසිද්ධි හිමි">Ven. Thulawala Dhammasiddhi Thero</p>
              </div>
            </li>
            <li class="pb-6 border-b border-stone-100">
              <div class="space-y-1">
                <p data-i18n="about.vp_badge" class="text-[11px] font-bold uppercase tracking-wider text-stone-500">Vice Principal</p>
                <p class="font-serif font-bold text-stone-900 text-xl" data-en="Mr. J.B. Dassanayaka" data-si="ජේ. බී. දසනායක මහතා">Mr. J.B. Dassanayaka</p>
              </div>
            </li>
          </ul>
        </div>
      </section>
    </div>
  </main>
  
  <Footer />
</BaseLayout>
