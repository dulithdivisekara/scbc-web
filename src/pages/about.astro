---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';

const leadership = await getCollection('leadership');
const sortedLeadership = leadership.sort((a, b) => a.data.order - b.data.order);

function getLeaderImage(imagePath: string, fallbackPath?: string) {
  try {
    const localFile = path.join(process.cwd(), 'public', imagePath);
    if (fs.existsSync(localFile)) {
      return imagePath;
    }
  } catch (e) {}
  return fallbackPath || '/assets/leadership/founder.jpg';
}
---

<BaseLayout title="About Us">
  <Header />
  
  <main class="flex-grow py-12 sm:py-16 bg-school-surface">
    <div class="container mx-auto px-4 max-w-4xl">
      <div class="text-center mb-10 sm:mb-12">
        <span class="text-xs font-bold uppercase tracking-wider text-school-teal mb-2 inline-block">Our Heritage</span>
        <h1 data-i18n="about.title" class="text-3xl sm:text-4xl font-serif font-bold text-school-textPrimary">About the College</h1>
        <div class="w-16 h-1 bg-school-orange mx-auto mt-4"></div>
      </div>
      
      <!-- Vision Section -->
      <section class="mb-10 sm:mb-12 bg-white p-6 sm:p-8 rounded-xl shadow-sm border border-school-border">
        <h2 data-i18n="about.vision_title" class="text-xl sm:text-2xl font-serif font-bold text-school-textPrimary mb-4 border-b border-school-border pb-2">Our Vision</h2>
        <p data-i18n="about.vision_text" class="text-base sm:text-lg text-school-textPrimary italic border-l-4 border-school-orange pl-4 py-2 bg-school-surface/60 rounded-r-lg">
          "To create a healthy generation which faces the challenges of the modern world, practicing the values of Buddhist Philosophy."
        </p>
      </section>

      <!-- History Section -->
      <section class="mb-10 sm:mb-12">
        <h2 data-i18n="about.history_title" class="text-xl sm:text-2xl font-serif font-bold text-school-textPrimary mb-6">Our History</h2>
        <div class="space-y-6 text-school-textMuted leading-relaxed bg-white p-6 sm:p-8 rounded-xl shadow-sm border border-school-border text-sm sm:text-base">
          <p data-i18n="about.history_p1">
            Sri Chandananda Buddhist College was established on January 4, 2006. The school was conceptualized and brought to life by our Founder and Executive Director, Most Ven. Dr. Godagama Mangala Thero.
          </p>
          <p data-i18n="about.history_p2">
            It is proudly named in honor of his respected teacher, the Most Ven. Palipana Sri Chandananda Mahanayake Thera, continuing a legacy of educational and spiritual excellence in Kandy.
          </p>
          <div class="bg-orange-50/50 p-4 sm:p-5 rounded-lg border border-orange-200 mt-6">
            <h3 class="font-bold text-school-maroon mb-2 flex items-center gap-2">
              <span class="bg-school-orange text-white text-xs px-2.5 py-0.5 rounded-full font-bold">2020</span>
              Expansion Milestone
            </h3>
            <p data-i18n="about.girls_expansion" class="text-xs sm:text-sm text-school-textMuted">In 2020, we expanded our vision by opening a dedicated Girls' School section, broadening our impact and commitment to holistic education.</p>
          </div>
        </div>
      </section>

      <!-- Leadership Directory -->
      <section>
        <div class="mb-6">
          <h2 data-i18n="about.leadership_directory" class="text-xl sm:text-2xl font-serif font-bold text-school-textPrimary">Leadership Directory</h2>
          <p class="text-school-textMuted text-sm mt-1">Guided by visionary Buddhist leadership and dedicated administrative stewardship.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
          {sortedLeadership.map(leader => (
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden hover:shadow-md transition group flex flex-col">
              <div class="overflow-hidden bg-slate-100 rounded-t-xl">
                <img 
                  src={getLeaderImage(leader.data.image, leader.data.fallbackImage)} 
                  alt={leader.data.name} 
                  width="600" 
                  height="800" 
                  class="aspect-[3/4] w-full object-cover object-top rounded-t-xl group-hover:scale-102 transition-transform duration-500" 
                  style="object-position: 50% 15%;"
                  onerror={`this.onerror=null;this.src='${leader.data.fallbackImage || '/assets/leadership/founder.jpg'}';`}
                />
              </div>
              <div class="p-6 sm:p-7 flex flex-col flex-grow text-center">
                <span class="inline-block mx-auto mb-3 px-3 py-1 bg-teal-50 border border-teal-200 text-school-teal text-xs font-bold uppercase tracking-wider rounded-full">
                  {leader.data.title}
                </span>
                <h3 class="text-xl font-bold font-serif text-school-textPrimary mb-2 leading-snug">
                  {leader.data.name}
                </h3>
                <p class="text-school-textMuted text-sm leading-relaxed mt-auto">
                  {leader.data.bio}
                </p>
              </div>
            </div>
          ))}
        </div>
        
        <!-- Vice Principals -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 sm:p-8">
          <h3 class="font-bold text-lg mb-4 text-school-textPrimary font-serif flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-school-teal"></span>
            <span data-i18n="about.vice_principals">Vice Principals</span>
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="p-4 rounded-xl bg-slate-50 border border-slate-100 flex items-center gap-3">
              <div class="w-2.5 h-2.5 rounded-full bg-school-orange shrink-0"></div>
              <div>
                <p class="font-serif font-semibold text-school-textPrimary text-base">Ven. Thulawala Dhammasiddi Thero</p>
                <p class="text-xs text-school-teal font-medium uppercase tracking-wider">Vice Principal</p>
              </div>
            </div>
            <div class="p-4 rounded-xl bg-slate-50 border border-slate-100 flex items-center gap-3">
              <div class="w-2.5 h-2.5 rounded-full bg-school-orange shrink-0"></div>
              <div>
                <p class="font-serif font-semibold text-school-textPrimary text-base">Mr. J.B. Dassanayaka</p>
                <p class="text-xs text-school-teal font-medium uppercase tracking-wider">Vice Principal</p>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>
  
  <Footer />
</BaseLayout>
