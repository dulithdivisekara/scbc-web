---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import { getCollection, getEntry } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';

const aboutArticle = await getEntry('articles', 'about-college');
const leadership = await getCollection('leadership');
const sortedLeadership = leadership.sort((a, b) => a.data.order - b.data.order);

function getLeaderImage(imagePath: string, fallbackPath?: string) {
  try {
    const localFile = path.join(process.cwd(), 'public', imagePath);
    if (fs.existsSync(localFile)) {
      return imagePath;
    }
  } catch (e) {}
  return fallbackPath || '/assets/leadership/founder.jpg';
}
---

<BaseLayout 
  title="About the College" 
  description="Heritage, monastic founding, and core institutional values of Sri Chandananda Buddhist College, Kandy. Led by Most Ven. Dr. Godagama Mangala Thero since 2006."
>
  <Header />
  
  <main class="flex-grow py-10 sm:py-24 bg-[#FCFCFC]">
    <div class="container mx-auto px-4 max-w-4xl">
      <div class="text-center mb-6 sm:mb-16">
        <h1 data-i18n="about.title" class="text-3xl sm:text-5xl font-serif font-bold text-stone-900 tracking-tight">About the College</h1>
      </div>
      
      <!-- Article Lead / Pull Quote -->
      <blockquote class="text-xl sm:text-3xl font-serif italic text-stone-800 text-center max-w-3xl mx-auto my-6 sm:my-12 leading-relaxed" data-en={aboutArticle.data.lead} data-si={aboutArticle.data.lead_si}>
        {aboutArticle.data.lead}
      </blockquote>

      <!-- Article Sections -->
      <article class="prose prose-slate max-w-4xl mx-auto mb-10 sm:mb-16">
        <div class="text-base sm:text-lg text-slate-700 leading-relaxed space-y-5 text-left">
          {aboutArticle.data.sections.map(section => (
            <div>
              <h2 class="text-xl sm:text-2xl font-bold font-serif text-slate-900 border-b border-slate-200 pb-2 mt-6 sm:mt-10 mb-3" data-en={section.heading} data-si={section.heading_si}>
                {section.heading}
              </h2>
              <p data-en={section.body} data-si={section.body_si}>
                {section.body}
              </p>
            </div>
          ))}
        </div>
      </article>

      <!-- Institutional Values & Philosophical Pillars -->
      <section class="mt-12 sm:mt-16 pt-10 sm:pt-14 border-t border-stone-200">
        <div class="mb-8">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-[#581838]/5 border border-[#581838]/15 text-[#581838] text-[11px] font-mono font-semibold uppercase tracking-widest mb-3">
            <span data-i18n="home.values_kicker">Foundational Ethos</span>
          </div>
          <h2 class="text-3xl font-serif font-bold text-stone-900 tracking-tight" data-i18n="home.values_title">
            Our Core Institutional Values
          </h2>
          <p class="text-stone-500 text-base mt-2" data-i18n="home.values_sub">
            Rooted in Theravada Buddhist ethics and modern intellectual rigour, our four foundational pillars guide every scholar through their collegiate journey.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="p-6 rounded-xl bg-stone-50 border border-stone-200 flex flex-col justify-between">
            <div>
              <div class="flex items-baseline justify-between mb-3">
                <span class="font-mono text-xs font-bold text-amber-700 tracking-widest">01 • PAÑÑĀ</span>
                <span class="text-xs font-semibold text-stone-400">ප්‍රඥාව</span>
              </div>
              <h3 class="text-xl font-serif font-bold text-stone-900 mb-1" data-i18n="home.value1_title">Wisdom</h3>
              <p class="text-xs font-medium text-stone-500 mb-2" data-i18n="home.value1_sub">Intellectual Inquiry &amp; Bilingual Mastery</p>
              <p class="text-sm text-stone-600 leading-relaxed" data-i18n="home.value1_desc">
                Fostering analytical thinking, scientific inquiry, and dual-medium literacy from Primary foundation through G.C.E. Advanced Level.
              </p>
            </div>
            <div class="pt-3 mt-4 border-t border-stone-200/60 flex items-center justify-between text-[11px] font-mono text-stone-400">
              <span>Grades 1–13</span>
              <span class="w-1.5 h-1.5 rounded-full bg-[#007A87]"></span>
            </div>
          </div>

          <div class="p-6 rounded-xl bg-stone-50 border border-stone-200 flex flex-col justify-between">
            <div>
              <div class="flex items-baseline justify-between mb-3">
                <span class="font-mono text-xs font-bold text-amber-700 tracking-widest">02 • SĪLA</span>
                <span class="text-xs font-semibold text-stone-400">විනය</span>
              </div>
              <h3 class="text-xl font-serif font-bold text-stone-900 mb-1" data-i18n="home.value2_title">Discipline</h3>
              <p class="text-xs font-medium text-stone-500 mb-2" data-i18n="home.value2_sub">Theravada Ethics &amp; Character</p>
              <p class="text-sm text-stone-600 leading-relaxed" data-i18n="home.value2_desc">
                Instilling mindful self-restraint, respect for elders, moral uprightness, and composure rooted in daily Buddhist observance.
              </p>
            </div>
            <div class="pt-3 mt-4 border-t border-stone-200/60 flex items-center justify-between text-[11px] font-mono text-stone-400">
              <span>Monastic Ethos</span>
              <span class="w-1.5 h-1.5 rounded-full bg-[#581838]"></span>
            </div>
          </div>

          <div class="p-6 rounded-xl bg-stone-50 border border-stone-200 flex flex-col justify-between">
            <div>
              <div class="flex items-baseline justify-between mb-3">
                <span class="font-mono text-xs font-bold text-amber-700 tracking-widest">03 • CĀRITTA</span>
                <span class="text-xs font-semibold text-stone-400">සංස්කෘතිය</span>
              </div>
              <h3 class="text-xl font-serif font-bold text-stone-900 mb-1" data-i18n="home.value3_title">Heritage</h3>
              <p class="text-xs font-medium text-stone-500 mb-2" data-i18n="home.value3_sub">Traditional Arts &amp; Monastic Ties</p>
              <p class="text-sm text-stone-600 leading-relaxed" data-i18n="home.value3_desc">
                Preserving Kandyan Ves dance traditions, pirith chanting ceremonies, and living cultural heritage in the sacred hill capital of Asgiriya.
              </p>
            </div>
            <div class="pt-3 mt-4 border-t border-stone-200/60 flex items-center justify-between text-[11px] font-mono text-stone-400">
              <span>Asgiriya, Kandy</span>
              <span class="w-1.5 h-1.5 rounded-full bg-[#F58220]"></span>
            </div>
          </div>

          <div class="p-6 rounded-xl bg-stone-50 border border-stone-200 flex flex-col justify-between">
            <div>
              <div class="flex items-baseline justify-between mb-3">
                <span class="font-mono text-xs font-bold text-amber-700 tracking-widest">04 • VIRIYA</span>
                <span class="text-xs font-semibold text-stone-400">විශිෂ්ටත්වය</span>
              </div>
              <h3 class="text-xl font-serif font-bold text-stone-900 mb-1" data-i18n="home.value4_title">Excellence</h3>
              <p class="text-xs font-medium text-stone-500 mb-2" data-i18n="home.value4_sub">Tenacity &amp; Leadership</p>
              <p class="text-sm text-stone-600 leading-relaxed" data-i18n="home.value4_desc">
                Striving for physical and academic triumph through spirited inter-house sports meets, track and field mastery, and team brotherhood.
              </p>
            </div>
            <div class="pt-3 mt-4 border-t border-stone-200/60 flex items-center justify-between text-[11px] font-mono text-stone-400">
              <span>Athletics &amp; Teams</span>
              <span class="w-1.5 h-1.5 rounded-full bg-[#007A87]"></span>
            </div>
          </div>
        </div>
      </section>

      <!-- Leadership Directory -->
      <section class="mt-12 sm:mt-20 pt-10 sm:pt-16 border-t border-stone-200">
        <div class="mb-8 sm:mb-10">
          <h2 data-i18n="about.leadership_directory" class="text-3xl font-serif font-bold text-stone-900 tracking-tight">Leadership Directory</h2>
          <p data-i18n="about.leadership_sub" class="text-stone-500 text-base mt-2">Guided by visionary Buddhist leadership and dedicated administrative stewardship.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-10 mb-16">
          {sortedLeadership.map(leader => (
            <div class="group flex flex-col">
              <div class="overflow-hidden rounded-2xl mb-6 bg-stone-100">
                <img 
                  src={getLeaderImage(leader.data.image, leader.data.fallbackImage)} 
                  alt={leader.data.name} 
                  width="600" 
                  height="800" 
                  class="aspect-[3/4] w-full object-cover object-top group-hover:scale-[1.02] transition-transform duration-700 ease-out" 
                  style="object-position: 50% 15%;"
                  onerror={`this.onerror=null;this.src='${leader.data.fallbackImage || '/assets/leadership/founder.jpg'}';`}
                />
              </div>
              <div class="flex flex-col">
                <div class="space-y-1 mb-3">
                  <p class="text-[11px] font-bold uppercase tracking-wider text-stone-500" data-en={leader.data.title} data-si={leader.data.title_si || leader.data.title}>
                    {leader.data.title}
                  </p>
                  <h3 class="text-2xl font-bold font-serif text-stone-900 leading-snug" data-en={leader.data.name} data-si={leader.data.name_si || leader.data.name}>
                    {leader.data.name}
                  </h3>
                </div>
                <p class="text-stone-500 text-sm leading-relaxed max-w-sm" data-en={leader.data.bio} data-si={leader.data.bio_si || leader.data.bio}>
                  {leader.data.bio}
                </p>
              </div>
            </div>
          ))}
        </div>
        
        <!-- Vice Principals -->
        <div class="mt-16">
          <h3 class="font-bold text-2xl mb-8 text-stone-900 font-serif border-b border-stone-200 pb-4" data-i18n="about.vice_principals">
            Vice Principals
          </h3>
          <ul class="space-y-6">
            <li class="pb-6 border-b border-stone-100">
              <div class="space-y-1">
                <p data-i18n="about.vp_badge" class="text-[11px] font-bold uppercase tracking-wider text-stone-500">Vice Principal</p>
                <p class="font-serif font-bold text-stone-900 text-xl" data-en="Ven. Thulawala Dhammasiddhi Thero" data-si="පූජ්‍ය තුලාවල ධම්මසිද්ධි හිමි">Ven. Thulawala Dhammasiddhi Thero</p>
              </div>
            </li>
            <li class="pb-6 border-b border-stone-100">
              <div class="space-y-1">
                <p data-i18n="about.vp_badge" class="text-[11px] font-bold uppercase tracking-wider text-stone-500">Vice Principal</p>
                <p class="font-serif font-bold text-stone-900 text-xl" data-en="Mr. J.B. Dassanayaka" data-si="ජේ. බී. දසනායක මහතා">Mr. J.B. Dassanayaka</p>
              </div>
            </li>
          </ul>
        </div>
      </section>
    </div>
  </main>
  
  <Footer />
</BaseLayout>
