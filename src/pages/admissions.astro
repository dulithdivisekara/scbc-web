---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import { FileText, Download, ClipboardCheck } from 'lucide-react';
---

<BaseLayout title="Admissions">
  <Header />
  
  <main class="flex-grow py-12 sm:py-16 bg-school-surface">
    <div class="container mx-auto px-4 max-w-3xl">
      <div class="text-center mb-10 sm:mb-12">
        <span class="text-xs font-bold uppercase tracking-wider text-school-teal mb-2 inline-block" data-en="ENROLLMENT" data-si="ලියාපදිංචිය">Enrollment</span>
        <h1 data-i18n="admissions.title" class="text-3xl sm:text-4xl font-serif font-bold text-school-textPrimary">Student Admissions & Enrolment</h1>
        <div class="w-16 h-1 bg-school-orange mx-auto mt-4 mb-4"></div>
        <p class="text-center text-school-textMuted max-w-xl mx-auto text-sm sm:text-base" data-en="Join Sri Chandananda Buddhist College and begin a journey of academic excellence, discipline, and spiritual growth." data-si="ශ්‍රී චන්දානන්ද බෞද්ධ විද්‍යාලයට සම්බන්ධ වී අධ්‍යාපනික විශිෂ්ටත්වය, විනය සහ අධ්‍යාත්මික වර්ධනයේ ගමනක් ආරම්භ කරන්න.">
          Join Sri Chandananda Buddhist College and begin a journey of academic excellence, discipline, and spiritual growth.
        </p>
      </div>
      
      <!-- Procedure Card -->
      <div class="bg-white p-6 sm:p-8 md:p-10 rounded-2xl shadow-sm border border-school-border mb-10 sm:mb-12">
        <h2 class="text-xl sm:text-2xl font-serif font-bold text-school-textPrimary mb-6 flex items-center gap-3">
          <div class="p-2 rounded-lg bg-teal-50 border border-teal-100 text-school-teal">
            <ClipboardCheck size={22} />
          </div>
          <span data-i18n="admissions.procedure_title">Admission Procedure</span>
        </h2>
        
        <ol class="space-y-6 relative border-l-2 border-school-border ml-3 md:ml-4">
          <li class="pl-8 relative">
            <div class="absolute w-6 h-6 bg-school-maroon text-white rounded-full flex items-center justify-center text-xs font-bold -left-[13px] top-0 border-2 border-white shadow-xs">1</div>
            <h3 class="font-bold text-base text-school-textPrimary mb-1" data-i18n="admissions.step_1">Download Application</h3>
            <p class="text-school-textMuted text-sm" data-en="Download the official application form below and print it clearly on A4 size paper." data-si="පහතින් නිල අයදුම්පත්‍රය බාගත කර එය A4 ප්‍රමාණයේ කඩදාසියක පැහැදිලිව මුද්‍රණය කරගන්න.">Download the official application form below and print it clearly on A4 size paper.</p>
          </li>
          <li class="pl-8 relative">
            <div class="absolute w-6 h-6 bg-school-maroon text-white rounded-full flex items-center justify-center text-xs font-bold -left-[13px] top-0 border-2 border-white shadow-xs">2</div>
            <h3 class="font-bold text-base text-school-textPrimary mb-1" data-i18n="admissions.step_2">Fill & Attach Documents</h3>
            <p class="text-school-textMuted text-sm" data-en="Complete the form accurately and attach a copy of the student's birth certificate and any required academic records." data-si="පෝරමය නිවැරදිව පුරවා සිසුවාගේ උප්පැන්න සහතිකයේ පිටපතක් සහ අවශ්‍ය ඕනෑම අධ්‍යාපනික වාර්තා අමුණන්න.">Complete the form accurately and attach a copy of the student's birth certificate and any required academic records.</p>
          </li>
          <li class="pl-8 relative">
            <div class="absolute w-6 h-6 bg-school-maroon text-white rounded-full flex items-center justify-center text-xs font-bold -left-[13px] top-0 border-2 border-white shadow-xs">3</div>
            <h3 class="font-bold text-base text-school-textPrimary mb-1" data-i18n="admissions.step_3">Submit to School Office</h3>
            <p class="text-school-textMuted text-sm" data-en="Submit the physical application package to the school office during operating hours (Mon-Fri, 7:30 AM - 1:30 PM)." data-si="සම්පූර්ණ කරන ලද අයදුම්පත කාර්යාල වේලාවන් (සඳුදා-සිකුරාදා, පෙ.ව. 7:30 - ප.ව. 1:30) ඇතුළත විද්‍යාලයීය කාර්යාලයට භාර දෙන්න.">Submit the physical application package to the school office during operating hours (Mon-Fri, 7:30 AM - 1:30 PM).</p>
          </li>
        </ol>
      </div>
      
      <!-- Download Box -->
      <div class="bg-gradient-to-br from-school-maroon to-[#3D1026] rounded-2xl p-6 sm:p-8 md:p-10 text-center text-white shadow-md relative overflow-hidden">
        <div class="absolute -right-8 -top-8 text-white/5 pointer-events-none">
          <FileText size={160} />
        </div>
        <div class="relative z-10">
          <h2 class="text-xl sm:text-2xl font-serif font-bold mb-3" data-i18n="admissions.app_form">Application Form</h2>
          <p class="text-stone-200 mb-6 max-w-md mx-auto text-sm leading-relaxed" data-en="Get started by downloading the official admission application form for the upcoming academic year." data-si="එළඹෙන අධ්‍යයන වර්ෂය සඳහා නිල අයදුම්පත්‍රය බාගත කරගන්න.">
            Get started by downloading the official admission application form for the upcoming academic year.
          </p>
          <a href="/docs/admissions-form-2026.pdf" download class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-school-orange text-white hover:bg-orange-600 px-8 py-3.5 rounded-lg font-semibold transition-all shadow-md hover:shadow-lg">
            <Download size={18} />
            <span data-i18n="admissions.download_app">Download Application Form</span>
          </a>
        </div>
      </div>
    </div>
  </main>
  
  <Footer />
</BaseLayout>
