---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import { FileText, Download, ClipboardCheck } from 'lucide-react';
import { getEntry } from 'astro:content';

const page = (await getEntry('pages', 'admissions'))!.data;
const { intro, procedure_heading, steps, download } = page;
---

<BaseLayout title="Admissions">
  <Header />
  
  <main class="flex-grow py-12 sm:py-16 bg-school-surface">
    <div class="container mx-auto px-4 max-w-3xl">
      <div class="text-center mb-10 sm:mb-12">
        <h1 data-i18n="admissions.title" class="text-3xl sm:text-4xl font-serif font-bold text-school-textPrimary">Student Admissions &amp; Enrolment</h1>
        <div class="w-16 h-1 bg-school-orange mx-auto mt-4 mb-4"></div>
        <p class="text-center text-school-textMuted max-w-xl mx-auto text-sm sm:text-base" data-en={intro!.en} data-si={intro!.si}>{intro!.en}</p>
      </div>
      
      <!-- Procedure -->
      <div class="bg-white p-6 sm:p-8 md:p-10 rounded-2xl shadow-sm border border-school-border mb-10 sm:mb-12">
        <h2 class="text-xl sm:text-2xl font-serif font-bold text-school-textPrimary mb-6 flex items-center gap-3">
          <div class="p-2 rounded-lg bg-teal-50 border border-teal-100 text-school-teal">
            <ClipboardCheck size={22} />
          </div>
          <span data-en={procedure_heading!.en} data-si={procedure_heading!.si}>{procedure_heading!.en}</span>
        </h2>
        
        <ol class="space-y-6 relative border-l-2 border-school-border ml-3 md:ml-4">
          {steps!.map((step, i) => (
            <li class="pl-8 relative">
              <div class="absolute w-6 h-6 bg-school-maroon text-white rounded-full flex items-center justify-center text-xs font-bold -left-[13px] top-0 border-2 border-white shadow-xs">{i + 1}</div>
              <h3 class="font-bold text-base text-school-textPrimary mb-1" data-en={step.title.en} data-si={step.title.si}>{step.title.en}</h3>
              <p class="text-school-textMuted text-sm" data-en={step.body.en} data-si={step.body.si}>{step.body.en}</p>
            </li>
          ))}
        </ol>
      </div>
      
      <!-- Download Box -->
      <div class="bg-gradient-to-br from-school-maroon to-[#3D1026] rounded-2xl p-6 sm:p-8 md:p-10 text-center text-white shadow-md relative overflow-hidden">
        <div class="absolute -right-8 -top-8 text-white/5 pointer-events-none">
          <FileText size={160} />
        </div>
        <div class="relative z-10">
          <h2 class="text-xl sm:text-2xl font-serif font-bold mb-3" data-en={download!.heading.en} data-si={download!.heading.si}>{download!.heading.en}</h2>
          <p class="text-stone-200 mb-6 max-w-md mx-auto text-sm leading-relaxed" data-en={download!.body.en} data-si={download!.body.si}>{download!.body.en}</p>
          <a href={download!.file} download class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-school-orange text-white hover:bg-orange-600 px-8 py-3.5 rounded-lg font-semibold transition-all shadow-md hover:shadow-lg">
            <Download size={18} />
            <span data-en={download!.button.en} data-si={download!.button.si}>{download!.button.en}</span>
          </a>
        </div>
      </div>
    </div>
  </main>
  
  <Footer />
</BaseLayout>
